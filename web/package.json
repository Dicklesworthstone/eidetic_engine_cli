{
  "name": "eidetic-engine-website",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.3",
  "engines": {
    "npm": "DO NOT USE NPM - Use bun instead",
    "bun": ">=1.3.0"
  },
  "scripts": {
    "style": "bun scripts/build-style.ts",
    "dev": "bun scripts/build-style.ts --watch & next dev",
    "check-tokens": "bun scripts/check-tokens.ts",
    "build": "bun scripts/check-tokens.ts && bun scripts/build-style.ts && next build",
    "typecheck": "bun scripts/build-style.ts && tsc --noEmit",
    "test": "bun test",
    "preview": "bun run build && wrangler dev",
    "deploy": "bun run build && wrangler deploy"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "lucide-react": "1.73.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.5",
    "@types/bun": "1.4.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "wrangler": "4.162.0"
  }
}
