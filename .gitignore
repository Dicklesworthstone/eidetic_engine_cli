/pass1.jsonl
/.plan-drift-report.json
/.contract-drift-radar-report.json
/closure_lint_out.txt
/db_for_loops.txt
/findings.jsonl

# Accidental shell-redirect artifact: `some-cmd --help > --help` lands a
