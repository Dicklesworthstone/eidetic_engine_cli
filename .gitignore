# Local env / direnv (real .env should be checked in only if intentional)
.env.local
.env.*.local
.envrc.local

# Agent / tool runtime scratch (not authoritative state)
.agent-mail/
.cass/
.rch/
.claude/
.codex/
.codex_write_probe
.cursor/
.stash_janitor_workspace/
# Per-tool MCP wiring configs at the repo root. These are emitted by
# `am setup` and similar provisioners and contain per-machine bearer
# tokens for the MCP Agent Mail HTTP server. They MUST NOT be committed.
# Covers cline.mcp.json, codex.mcp.json, cursor.mcp.json, gemini.mcp.json,
# windsurf.mcp.json, opencode.json, and any future *.mcp.json sibling
# (the project-level .mcp.json is canonical/checked-in elsewhere when
# present; this glob only matches root-level *.mcp.json with a tool prefix).
/cline.mcp.json
/codex.mcp.json
/cursor.mcp.json
/gemini.mcp.json
/windsurf.mcp.json
/opencode.json
# mcp-agent-mail per-project Python stub installed by `install_guard`.
# The real coordinator lives outside this repo; the on-disk stub is
# scratch and must never be committed.
/mcp_agent_mail/
!tests/fixtures/agent_detect/remote_mirror/
!tests/fixtures/agent_detect/remote_mirror/**
!tests/fixtures/agent_detect/remote_mirror/**/.claude/
!tests/fixtures/agent_detect/remote_mirror/**/.claude/**
!tests/fixtures/agent_detect/remote_mirror/**/.codex/
!tests/fixtures/agent_detect/remote_mirror/**/.codex/**

# Python tooling caches (some helper scripts may run python)
__pycache__/
*.pyc
*.pyo
.venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Node tooling caches (only if used by helper scripts)
node_modules/

# bv (beads viewer) local config and caches
.bv/
.env
.claude/settings.local.json

# Per-run e2e overhaul suite logs (J3/J4). Each run writes a timestamped
# directory under tests/logs/; keep them off git.
tests/logs/

# One-off ad-hoc helper scripts agents occasionally drop in the repo root
# while investigating an issue. These are not authoritative tooling — they
# are scratch. Keep them off git so they don't sneak into commits.
/find_async_sleep.sh
/fix_unwrap_err.sh
/patch.py
# Scratch .rs files dropped at repo root during cross-project investigation
# (e.g., temp_signal.rs from upstream asupersync triage). Not real test
# binaries — those live under /test_* patterns above with paired binaries.
/temp_*.rs

# Repo-root agent scratchpads (rule-based, replaces whack-a-mole).
# Anchored to depth 1 so real fixtures and tests under subdirectories stay
# visible to Git and RCH.
/test_*.rs
/test_capture*
/test_clamp*
/test_drop*
/test_ln_1p*
/test_min*
/test_minmax*
/test_multibyte*
/test_output*.log
/temp_*.rs
/ubs_*.txt
/ubs_*.json
/ubs_*.jsonl
/ubs.json
/db_for_loops*
/findings.jsonl
/pass*.jsonl
/fix_*.sh
/find_*.sh
/*-upgrade-progress.json

# scripts/audit_install_pipeline.sh writes a timestamped JSON snapshot per
# run into tests/audit_artifacts/. The "latest_install_pipeline.json" symlink
# and an occasional `git add -f`'d baseline are the authoritative artifacts;
# every other timestamped run is scratch and should not pile up in git.
tests/audit_artifacts/install_pipeline_*.json
!tests/audit_artifacts/install_pipeline_2026-05-13T052258Z.json
!tests/audit_artifacts/install_pipeline_2026-05-13T192108Z.json
.stash_janitor_workspace/

# UBS (Ultimate Bug Scanner) reports at the repo root. `ubs` writes its
# outputs into the current working directory; root-level dumps are scratch
# and must not be committed. The glob covers the per-subsystem dumps
# agents emit (ubs_cli.txt, ubs_obs.txt, ubs_graph.txt, ubs_runtime.txt,
# ubs_output.txt, ubs_hooks.txt, ubs_science.txt, ubs_cache.txt,
# ubs_curate_v.txt, ubs_cli_models_config.txt, ubs_output_runtime.txt,
# ubs_aux.txt, ubs_all.txt, …) without needing a new line per file.
/ubs.json
/ubs.jsonl
/ubs_*.json
/ubs_*.jsonl
/ubs_*.txt
/ubs_out.json
/ubs_full.txt
/ubs_full_v.txt
/ubs_findings.jsonl

# One-off Rust scratch files agents drop at the repo root while probing
# numerics or multibyte handling. Real tests live under tests/. If one of
# these ever earns a permanent home, move it into tests/ rather than
# allow-listing it here.
/test_drop
/test_drop.rs
/test_ln_1p
/test_ln_1p.rs
/test_multibyte
/test_multibyte.rs
/test_clamp
/test_clamp.rs
