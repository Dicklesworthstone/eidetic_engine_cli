# Project-specific RCH sync exclusions.
#
# RCH reads this file for normal project upload and artifact retrieval. Keep
# patterns narrow: this file must not hide source, fixtures, migrations, or
# other inputs required for remote Cargo verification.
#
# RCH's custom CARGO_TARGET_DIR pullback is rooted at the target directory, not
# this repo root, so these rules do not suppress that separate artifact sync.
# For verification-only runs, prefer:
#
#   env -u CARGO_TARGET_DIR rch exec -- cargo check --all-targets
#
# If artifacts must be pulled back, point CARGO_TARGET_DIR at disk-backed
# storage such as ${TMPDIR:-/data/tmp}/rch_target_<task>, not /tmp.

# Cargo/RCH build outputs. Remote verification does not need local build
# artifacts copied back into this checkout.
/target/
/target/**
/.rch-target/
/.rch-target/**

# Machine-local Cargo config may point at host-only scratch disks such as
# /Volumes/USBNVME16TB. RCH sets worker-local target dirs explicitly.
.cargo/config.toml

# `src/cache` is a real Rust module. Keep it visible even when host-level
# ignore files contain broad cache-directory exclusions.
!src/cache/
!src/cache/**

# Diagnostic output files created by verification scripts
.clippy_out.txt
.closure-lint-report.json
.ubs_out.txt
.vision-coverage-report.json
.git_log_tmp.txt
clippy_out_dump
exit_code_test_out
recent_commits.txt

# Machine-local ee workspace runtime state. Remote Cargo verification should
# build and test source, not copy this checkout's local database/index/cache
# stores into worker project roots.
.ee/
.ee/**

# Root-level scratch artifacts observed from agent diagnostics and ad hoc
# verifier probes. Keep these exact so source, fixtures, migrations, docs, and
# tests remain visible to RCH.
/--help
/.plan-drift-report.json
/critical.json
/functions.txt
/test_ln_1p
/test_ln_1p.rs
/test_multibyte
/test_multibyte.rs
/ubs.json
/ubs_findings.jsonl
/ubs_full.txt

# Repo-root agent scratchpads (rule-based, mirrors .gitignore).
# Anchored to depth 1 so RCH does not hide real fixtures or test sources under
# subdirectories.
/test_*.rs
/test_capture*
/test_clamp*
/test_drop*
/test_ln_1p*
/test_min*
/test_minmax*
/test_multibyte*
/test_output*.log
/temp_*.rs
/ubs_*.txt
/ubs_*.json
/ubs_*.jsonl
/ubs.json
/db_for_loops*
/findings.jsonl
/pass*.jsonl
/fix_*.sh
/find_*.sh
/*-upgrade-progress.json

# Volatile Beads SQLite sidecars and temp files. Keep .beads/issues.jsonl
# visible for tests and coordination, but do not let transient DB files make
# RCH fall back to local execution when they vanish during rsync.
.beads/*.db
.beads/*db-shm
.beads/*db-wal
.beads/*db-journal
.beads/.*.db.*
.beads/bd.sock*
.beads/daemon.lock
.beads/daemon.log
.beads/last-touched

# Agent session reports (multi-pane orchestration artifacts)
GEMINI_PANE*.md
GEMINI_PANE_REPORT.md

# Per-agent target directories (these are in /tmp but pattern for completeness)
/tmp/ee_target_pane*/

# Broken shell expansion artifacts
${TMPDIR:-/
.../
.../**

# perf profiling data (already in global config but explicit here)
perf.data
perf.data.*

# Test run artifacts
*.test_output
*.test_log

# Volatile audit pointers can be transient/broken symlinks and are not inputs to
# remote Cargo verification.
tests/audit_artifacts/latest_*.json

# Git recovery output from `git fsck --lost-found` is not source input. It can
# contain thousands of transient object files under .git/lost-found/ and rsync
# can fail if those entries change while exact-closure sync is running.
.git/lost-found/
.git/lost-found/**

# bd-1h8ji.4 — AppleDouble / macOS Finder metadata. These files are created on
# Mac when extended attributes are stored on filesystems that don't natively
# support them (USB drives, ExFAT, network shares). They are NOT source inputs
# to remote Cargo verification, and vendored C crates such as `zstd-sys` will
# attempt to compile any `._foo.c` sibling next to `foo.c` if they end up in
# the worker file set, poisoning the build. Excluding here keeps remote Linux
# verification consistent regardless of which Mac filesystem the Mac-side
# checkout lives on.
._*
**/._*
.DS_Store
**/.DS_Store

# Proptest's default failure persistence can create per-module seed files under
# the repo-root proptest-regressions/ directory. This project intentionally
# tracks a few stable seeds there, but connection.txt and codegen.txt are
# generated local seeds on some workers. Protect the stale remote files from
# rsync --delete without hiding the tracked regression seeds above.
/proptest-regressions/connection.txt
/proptest-regressions/codegen.txt
proptest-regressions/connection.txt
proptest-regressions/codegen.txt
proptest-regressions/sync/
proptest-regressions/runtime/
proptest-regressions/net/
proptest-regressions/cx/
proptest-regressions/combinator/

# Foreign stale worker artifacts (bd-isqmd class). fixtures/openhands/ and
# fixtures/antigravity/ are NOT ee source — they are not tracked, not in this
# checkout, and were left on some RCH workers by a prior tool's runs, owned by an
# orphaned uid (the Mac-side 501) that the workers' ubuntu rsync cannot remove.
# rsync --delete on them fails `Permission denied (13)` and aborts the whole sync
# before Cargo starts, blocking every remote verify. Excluding the dirs makes
# rsync leave them untouched (it never had them in source anyway). Same shape as
# the proptest seed protection above.
/fixtures/openhands/
/fixtures/antigravity/

# Generated Python bytecode and CI/audit output (bd-isqmd class): these are NOT
# Rust verification inputs, are untracked in git, and accrue as wrong-owner
# stale files on RCH workers (scripts/**/__pycache__/*.pyc from helper scripts,
# artifacts/** from dependency-audit/atp/ci runs). rsync --delete on them fails
# `Permission denied (13)` and aborts the whole project sync before Cargo,
# blocking every /Users-checkout remote verify fleet-wide. Excluding them
# (dir-recursive + anchored) makes rsync leave the stale remote copies untouched
# — same shape as the fixtures/proptest protections above.
__pycache__/
**/__pycache__/
**/__pycache__/**
/artifacts/
/artifacts/**
