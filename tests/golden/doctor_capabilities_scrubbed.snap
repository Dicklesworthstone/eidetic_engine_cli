{
  "schema": "ee.doctor.capabilities.v1",
  "doctor_version": "[CARGO_PKG_VERSION]",
  "doctor_contract_version": "1.0.0",
  "tool_version": "[CARGO_PKG_VERSION]",
  "run_artifact_schema": "ee.doctor.run_state.v2",
  "blast_radius": [
    "[WORKSPACE]/.ee",
    "[WORKSPACE]/.doctor",
    "[HOME]/.local/share/ee"
  ],
  "op_kinds": [
    "write_file",
    "create_dir_all",
    "chmod",
    "quarantine_by_rename",
    "manual",
    "emit_diagnostic",
    "run_index_rebuild",
    "run_graph_refresh",
    "run_wal_checkpoint",
    "run_migration",
    "rewrite_jsonl",
    "atomic_rewrite_toml",
    "snapshot_backup"
  ],
  "fix_dispatch": [
    {
      "finding": "database_empty",
      "op_kind": "manual",
      "effect": "guidance"
    },
    {
      "finding": "database_corrupted",
      "op_kind": "manual",
      "effect": "guidance"
    },
    {
      "finding": "database_locked",
      "op_kind": "manual",
      "effect": "guidance"
    },
    {
      "finding": "database_unavailable",
      "op_kind": "manual",
      "effect": "guidance"
    },
    {
      "finding": "database_migration_drift",
      "op_kind": "manual",
      "effect": "guidance"
    },
    {
      "finding": "database_missing",
      "op_kind": "manual",
      "effect": "guidance"
    },
    {
      "finding": "search_index_missing",
      "op_kind": "run_index_rebuild",
      "effect": "repair"
    },
    {
      "finding": "search_index_stale",
      "op_kind": "run_index_rebuild",
      "effect": "repair"
    },
    {
      "finding": "schema_migration_pending",
      "op_kind": "run_migration",
      "effect": "guidance"
    },
    {
      "finding": "cass_integration_drift",
      "op_kind": "manual",
      "effect": "guidance"
    },
    {
      "finding": "wal_checkpoint_pending",
      "op_kind": "run_wal_checkpoint",
      "effect": "guidance"
    },
    {
      "finding": "workspace_config_malformed_toml",
      "op_kind": "quarantine_by_rename",
      "effect": "repair"
    }
  ],
  "exit_codes": [
    {
      "code": 0,
      "name": "ok",
      "meaning": "no findings, or all fixes applied successfully"
    },
    {
      "code": 1,
      "name": "usage",
      "meaning": "command-line usage or argument validation failed"
    },
    {
      "code": 2,
      "name": "configuration",
      "meaning": "configuration, concurrency, or no-op precondition prevented the operation"
    },
    {
      "code": 3,
      "name": "storage",
      "meaning": "doctor storage, ledger, backup, or state restoration failed"
    },
    {
      "code": 4,
      "name": "search_index",
      "meaning": "search index operation failed"
    },
    {
      "code": 5,
      "name": "import",
      "meaning": "import operation failed"
    },
    {
      "code": 6,
      "name": "unsatisfied_degraded_mode",
      "meaning": "the requested operation cannot proceed in the current degraded mode"
    },
    {
      "code": 7,
      "name": "policy_denied",
      "meaning": "blast-radius or another safety policy denied the operation"
    },
    {
      "code": 8,
      "name": "migration_required",
      "meaning": "doctor refuses because `ee migrate run` is needed first"
    }
  ],
  "env_vars": [
    {
      "name": "EE_DOCTOR_BLAST_RADIUS",
      "purpose": "Override default blast radius (colon-separated abs paths)"
    },
    {
      "name": "EE_NO_COLOR",
      "purpose": "Disables ANSI styling on stderr (inherited from ee)"
    }
  ],
  "action_line_schema": "ee.doctor.action.v1"
}
