  - tests/property_eql_query_parsing.rs::parse_eql_query_rejects_non_string_query_field
  - tests/property_eql_query_parsing.rs::parse_eql_query_rejects_non_object_root
  - src/cli/mod.rs::validate_query_file_path
  - src/cli/mod.rs::parse_query_document
