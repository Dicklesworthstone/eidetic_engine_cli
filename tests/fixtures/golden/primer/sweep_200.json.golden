{"schema":"ee.response.v2","success":true,"data":{"schema":"ee.primer.v1","budget_tokens":200,"format":"json","cache_hit":false,"db_generation":25,"config_hash":"blake3:9fdbe3658f141292","sections":[{"name":"rules","items":[{"memory_id":"mem_00000000000000000000000021","line":"Always run the verify script before pushing changes to main.","level":"procedural","kind":"rule","confidence":0.949999988079071,"provenance":[{"uri":"test://primer-sweep","source_type":"memory_provenance"}]},{"memory_id":"mem_00000000000000000000000022","line":"Never regenerate goldens on a Mac-local checkout; use the remote lane.","level":"procedural","kind":"rule","confidence":0.8999999761581421,"provenance":[{"uri":"test://primer-sweep","source_type":"memory_provenance"}]},{"memory_id":"mem_00000000000000000000000023","line":"Use sqlmodel for storage access; rusqlite is a forbidden dependency.","level":"procedural","kind":"rule","confidence":0.8500000238418579,"provenance":[{"uri":"test://primer-sweep","source_type":"memory_provenance"}]},{"memory_id":"mem_00000000000000000000000024","line":"Prefer append-only writes with deterministic idempotency keys for imports.","level":"procedural","kind":"rule","confidence":0.800000011920929,"provenance":[{"uri":"test://primer-sweep","source_type":"memory_provenance"}]}]},{"name":"warnings","items":[{"memory_id":"mem_00000000000000000000000027","line":"Schema list golden drifts silently when a registry entry lands without regen.","level":"episodic","kind":"risk","confidence":0.75,"provenance":[{"uri":"test://primer-sweep","source_type":"memory_provenance"}]},{"memory_id":"mem_00000000000000000000000026","line":"Index rebuild stalled when CARGO_TARGET_DIR pointed at the ExFAT volume.","level":"episodic","kind":"failure","confidence":0.800000011920929,"provenance":[{"uri":"test://primer-sweep","source_type":"memory_provenance"}]},{"memory_id":"mem_00000000000000000000000025","line":"Release broke when goldens were regenerated on the wrong host.","level"