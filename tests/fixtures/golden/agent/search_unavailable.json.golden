{"schema":"ee.error.v2","error":{"code":"workspace_store_missing","message":"Database not found at <ee-golden-workspace>/.ee/ee.db","severity":"high","repair":"Re-check --workspace addressing with --workspace <ee-golden-workspace> (looked for <ee-golden-workspace>/.ee/ee.db). Nearby-store discovery completed and found no populated stores. Only if you intended to create a NEW store here: ee init --workspace <ee-golden-workspace>","repairKind":"unknown","details":{"addressedStorePath":"<ee-golden-workspace>/.ee/ee.db","addressedWorkspacePath":"<ee-golden-workspace>","storeDiscovery":{"outcome":"complete","nearbyStores":[]},"recovery":[{"priority":1,"kind":"flag","rationale":"Re-check the exact addressed workspace before selecting another store.","riskClass":"read_only_probe","requiresHumanApproval":false,"mutatesExternalState":false,"mutatesTrackerState":false,"privacyClass":"metadata_only","evidence":["recovery_kind_without_command"],"valueHint":"<ee-golden-workspace>","flagName":"--workspace","example":"--workspace <ee-golden-workspace>"},{"priority":2,"kind":"env","rationale":"Re-check the exact addressed database override before initializing a new store.","riskClass":"read_only_probe","requiresHumanApproval":false,"mutatesExternalState":false,"mutatesTrackerState":false,"privacyClass":"metadata_only","evidence":["recovery_kind_without_command"],"envName":"EE_DATABASE_PATH","valueHint":"<ee-golden-workspace>/.ee/ee.db","example":"EE_DATABASE_PATH=<ee-golden-workspace>/.ee/ee.db"},{"priority":3,"kind":"seed","rationale":"Only initialize when this exact addressed workspace was intentionally chosen for a new store.","riskClass":"mutating_local_repair","preflightCommand":"ee preflight check --cmd 'ee init --workspace <ee-golden-workspace>' --workspace . --json","requiresHumanApproval":false,"mutatesExternalState":false,"mutatesTrackerState":false,"privacyClass":"bounded_command_no_raw_state","manualStep":"Review the dry-run or recovery details before applying.","eviden