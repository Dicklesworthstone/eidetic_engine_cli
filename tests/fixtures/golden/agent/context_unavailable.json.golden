{
  "schema": "ee.error.v2",
  "error": {
    "code": "workspace_store_missing",
    "message": "Database not found at <isolatedRoot>/missing-ee-workspace/.ee/ee.db",
    "severity": "high",
    "repair": "Re-check --workspace addressing with --workspace <isolatedRoot>/missing-ee-workspace (looked for <isolatedRoot>/missing-ee-workspace/.ee/ee.db). Nearby-store discovery completed and found no populated stores. Only if you intended to create a NEW store here: ee init --workspace <isolatedRoot>/missing-ee-workspace",
    "repairKind": "unknown",
    "details": {
      "addressedStorePath": "<isolatedRoot>/missing-ee-workspace/.ee/ee.db",
      "addressedWorkspacePath": "<isolatedRoot>/missing-ee-workspace",
      "storeDiscovery": {
        "outcome": "complete",
        "nearbyStores": []
      },
      "recovery": [
        {
          "priority": 1,
          "kind": "flag",
          "rationale": "Re-check the exact addressed workspace before selecting another store.",
          "riskClass": "read_only_probe",
          "requiresHumanApproval": false,
          "mutatesExternalState": false,
          "mutatesTrackerState": false,
          "privacyClass": "metadata_only",
          "evidence": [
            "recovery_kind_without_command"
          ],
          "valueHint": "<isolatedRoot>/missing-ee-workspace",
          "flagName": "--workspace",
          "example": "--workspace <isolatedRoot>/missing-ee-workspace"
        },
        {
          "priority": 2,
          "kind": "seed",
          "rationale": "Only initialize when this exact addressed workspace was intentionally chosen for a new store.",
          "riskClass": "mutating_local_repair",
          "preflightCommand": "ee preflight check --cmd 'ee init --workspace <isolatedRoot>/missing-ee-workspace' --workspace . --json",
          "requiresHumanApproval": false,
          "mutatesExternalState": false,
          "mutatesTrackerState": false,
          "privacyClass": "bounded_command_no_raw_state",
          "manualStep": "Review the dry-run or recovery details before applying.",
          "evidence": [
            "local_state_repair_command"
          ],
          "preconditions": [
            "workspace_must_be_explicit"
          ],
          "command": "ee init --workspace <isolatedRoot>/missing-ee-workspace"
        }
      ]
    }
  }
}
