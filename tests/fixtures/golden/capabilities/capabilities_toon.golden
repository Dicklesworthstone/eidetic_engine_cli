  binaries:
    cass:
      source: missing
      error: "cass binary 'tests/fixtures/missing-ee-workspace/no-cass' is not allowed: CASS import binary must be configured as an absolute path"
      trusted: false
  envOverrides[121]:
    - name: EE_AGENT_NAME
      category: output
      controls: Identify the current agent for scoped memory retrieval.
      defaultValue: null
      isSet: false
      source: unset
    - name: EE_AGENT_MODE
      category: output
      controls: Use agent-oriented output defaults.
      defaultValue: null
      isSet: false
      source: unset
    - name: EE_AMBIENT_CONTEXT
      category: hooks
      controls: Enable or disable proactive ambient context hook injection.
      defaultValue: "true"
      isSet: false
      source: registry_default
    - name: EE_AMBIENT_CONTEXT_STATE_DIR
      category: hooks
      controls: Override the ambient hook de-duplication state directory.
      defaultValue: null
      isSet: false
      source: unset
    - name: EE_AMBIENT_CONTEXT_VERBOSITY
      category: hooks
      controls: "Select quiet, standard, or verbose ambient hook budgets."
      defaultValue: standard
      isSet: false
      source: registry_default
    - name: EE_ADAPTIVE_BACKOFF_MS
      category: tuning
      controls: Override the SRR5 noisy-neighbor soft backoff delay in milliseconds.
      defaultValue: "25"
      isSet: false
      source: registry_default
    - name: EE_ADAPTIVE_NOISY_P99_MS
      category: tuning
      controls: Override the SRR5 per-agent p99 latency threshold for noisy-neighbor backoff.
      defaultValue: "200"
      isSet: false
      source: registry_default
    - name: EE_AUDIT_LANE_BATCH_MAX
      category: tuning
      controls: Override the audit-lane writer batch size before flushing.
      defaultValue: "64"
      isSet: false
      source: registry_default
    - name: EE_AUDIT_LANE_CAPACITY
      category: tuning
      controls: Override the audit-lane producer queue capacity.
      defaultValue: "1024"
      isSet: false
      source: registry_default
    - name: EE_AUDIT_LANE_FLUSH_MS
      category: tuning
      controls: Override the audit-lane time-based flush interval in milliseconds.
      defaultValue: "5"
      isSet: false
      source: registry_default
    - name: EE_CASS_BINARY
      category: integration
      controls: Override the trusted cass import binary path.
      defaultValue: null
      isSet: true
      source: process_env
      currentValue: tests/fixtures/missing-ee-workspace/no-cass
    - name: EE_CASS_TIMEOUT_SECS
      category: integration
      controls: Override the CASS subprocess timeout in seconds for import and discovery calls.
      defaultValue: "30"
      isSet: false
      source: registry_default
    - name: EE_CURATION_AUTO_PROMOTE_CONFIDENCE_FLOOR
      category: curation
      controls: Override the minimum confidence required by curation auto-promotion.
      defaultValue: "0.80"
      isSet: false
      source: registry_default
    - name: EE_CURATION_AUTO_PROMOTE_MAX_PER_RUN
      category: curation
      controls: Override the maximum curation candidates auto-promotion may accept per run.
      defaultValue: "10"
      isSet: false
      source: registry_default
    - name: EE_CURATION_DERIVED_PREVIEW_LIMIT
      category: curation
      controls: Override the derived-candidate preview/reject listing limit.
      defaultValue: "20"
      isSet: false
      source: registry_default
    - name: EE_DAEMON_ENABLE_ECHO
      category: diagnostics
      controls: Enable the diagnostic `ee.daemon.echo` round-trip method.
      defaultValue: "false"
      isSet: false
      source: registry_default
    - name: EE_DAEMON_MAX_INFLIGHT
      category: tuning
      controls: Override the cap on in-flight `ee daemon` worker threads; saturated accepts emit `daemon_overloaded`.
      defaultValue: "32"
      isSet: false
      source: registry_default
    - name: EE_DATABASE_PATH
      category: paths
      controls: Override the configured storage database path.
      defaultValue: null
      isSet: false
      source: unset
    - name: EE_DEMO_EVIDENCE_ROOT
      category: paths
      controls: Override the demo evidence storage root.
      defaultValue: null
      isSet: false
      source: unset
    - name: EE_DIAG_FORCE_CAPABILITY_GAP
      category: diagnostics
      controls: Force selected capability probes to report build-gap diagnostics.
      defaultValue: null
      isSet: false
      source: unset
    - name: EE_DISABLE_ADAPTIVE
      category: tuning
      controls: Disable SRR5 swarm adaptive prefetch and scheduling without editing config.
      defaultValue: "false"
      isSet: false
      source: registry_default
    - name: EE_DISABLE_TOON
      category: output
      controls: Disable TOON output capability reporting and auto-selection.
      defaultValue: null
      isSet: false
      source: unset
    - name: EE_DISABLE_REMEMBER_SEARCH_NEIGHBORS
      category: tuning
      controls: Disable Frankensearch neighbors during remember-time proposal.
      defaultValue: null
      isSet: false
      source: unset
    - name: EE_DOCTOR_BLAST_RADIUS
      category: paths
      controls: Override the doctor fix blast-radius roots with colon-separated absolute paths.
      defaultValue: null
      isSet: false
      source: unset
    - name: EE_E2E_RETENTION_MANIFEST
      category: paths
      controls: Override the retained-artifact manifest path used by diagnostics.
      defaultValue: null
      isSet: false
      source: unset
    - name: EE_EMBED_DEDUP_COSINE_FLOOR
      category: embeddings
      controls: Set the cosine-similarity floor for insert-time embedding dedup confirmation.
      defaultValue: "0.97"
      isSet: false
      source: registry_default
    - name: EE_EMBED_DEDUP_ENABLED
      category: embeddings
      controls: Enable insert-time embedding deduplication after storage and write-path gates are wired.
      defaultValue: "false"
      isSet: false
      source: registry_default
    - name: EE_EMBED_DEDUP_HAMMING_K
      category: embeddings
      controls: Set the maximum SimHash Hamming distance admitted to dedup cosine confirmation.
      defaultValue: "12"
      isSet: false
      source: registry_default
    - name: EE_EMBED_DOWNLOAD
      category: embeddings
      controls: Control bundled embedding model download behavior with auto or off.
      defaultValue: auto
      isSet: false
      source: registry_default
    - name: EE_EMBED_MODEL_DIR
      category: embeddings
      controls: Override the bundled embedding model cache directory used by ee.
      defaultValue: null
      isSet: false
      source: unset
    - name: EE_EMBED_MODEL_PATH
      category: embeddings
      controls: Fault-injection path used to simulate an unavailable search embedder; this does not load alternate models.
      defaultValue: null
      isSet: false
      source: unset
    - name: EE_EXPERIMENTAL_TRIAD
      category: output
      controls: Compatibility no-op for the promoted ee pack/note/why aliases.
      defaultValue: null
      isSet: false
      source: unset
    - name: EE_FLIGHT_RECORDER
      category: diagnostics
      controls: Enable the redacted command flight recorder for ee subcommands.
      defaultValue: "false"
      isSet: false
      source: registry_default
    - name: EE_FLIGHT_RECORDER_DIR
      category: paths
      controls: Override the directory where flight recorder traces are written.
      defaultValue: null
      isSet: false
      source: unset
    - name: EE_FLIGHT_RECORDER_RETENTION_DAYS
      category: diagnostics
      controls: Override the flight recorder trace retention window in days.
      defaultValue: "7"
      isSet: false
      source: registry_default
    - name: EE_FORMAT
      category: output
      controls: Select the default output renderer.
      defaultValue: null
      isSet: false
      source: unset
    - name: EE_GRAPH_MEMORY_DEGRADED_BELOW_PCT
      category: tuning
      controls: Override the graph snapshot advisory threshold as a percent of the snapshot cap.
      defaultValue: "80"
      isSet: false
      source: registry_default
    - name: EE_GRAPH_MEMORY_GROWTH_MULTIPLIER_BASIS_POINTS
      category: tuning
      controls: Override the graph snapshot in-build growth tripwire ratio in basis points.
      defaultValue: "15000"
      isSet: false
      source: registry_default
    - name: EE_GRAPH_MEMORY_PER_ALGORITHM_CAP_MB
      category: tuning
      controls: Override the per-algorithm graph working-set cap in MiB.
      defaultValue: "100"
      isSet: false
      source: registry_default
    - name: EE_GRAPH_MEMORY_SNAPSHOT_CAP_MB
      category: tuning
      controls: Override the graph snapshot admission cap in MiB.
      defaultValue: "250"
      isSet: false
      source: registry_default
    - name: EE_GRAPH_NUMA_PIN_DISABLE
      category: tuning
      controls: Disable graph snapshot NUMA pinning without editing config.
      defaultValue: "false"
      isSet: false
      source: registry_default
    - name: EE_GRAPH_NUMA_PIN_NODE
      category: tuning
      controls: Select auto NUMA placement or an explicit non-negative NUMA node for graph snapshot pinning.
      defaultValue: auto
      isSet: false
      source: registry_default
    - name: EE_GRAPH_NUMA_PIN_POPULATE
      category: tuning
      controls: Control whether graph snapshot loading pre-faults pages during NUMA pinning.
      defaultValue: "true"
      isSet: false
      source: registry_default
    - name: EE_GRAPH_WITNESSES_RETENTION_DAYS
      category: tuning
      controls: Override the default graph algorithm witness retention window in days.
      defaultValue: "30"
      isSet: false
      source: registry_default
    - name: EE_HARMFUL_BURST_WINDOW_SECONDS
      category: tuning
      controls: Override the harmful feedback burst window in seconds.
      defaultValue: null
      isSet: false
      source: unset
    - name: EE_HARMFUL_PER_SOURCE_PER_HOUR
      category: tuning
      controls: Override the harmful feedback rate limit per source.
      defaultValue: null
      isSet: false
      source: unset
    - name: EE_HOOK_MODE
      category: output
      controls: Use hook-oriented machine output defaults.
      defaultValue: null
      isSet: false
      source: unset
    - name: EE_INDEX_DIR
      category: paths
      controls: Override the configured search index directory.
      defaultValue: null
      isSet: false
      source: unset
    - name: EE_INDEX_PUBLISH_LOCK_RETRY_ATTEMPTS
      category: tuning
      controls: Override index publish advisory-lock retry attempts.
      defaultValue: "200"
      isSet: false
      source: registry_default
    - name: EE_JSON
      category: output
      controls: Request JSON output from renderer auto-detection.
      defaultValue: null
      isSet: false
      source: unset
    - name: EE_JOURNAL_ENABLED
      category: memory
      controls: Enable or disable append-only agent journal capture.
      defaultValue: "true"
      isSet: false
      source: registry_default
    - name: EE_JOURNAL_RETENTION_DAYS
      category: tuning
      controls: Override the append-only journal retention window in days.
      defaultValue: "14"
      isSet: false
      source: registry_default
    - name: EE_L2_PACK_CACHE_BYTES
      category: tuning
      controls: Override the L2 pack cache byte cap per workspace.
      defaultValue: null
      isSet: false
      source: unset
    - name: EE_L2_PACK_CACHE_DIR
      category: paths
      controls: Override the L2 pack cache root directory.
      defaultValue: null
      isSet: false
      source: unset
    - name: EE_L2_PACK_CACHE_DISABLE
      category: tuning
