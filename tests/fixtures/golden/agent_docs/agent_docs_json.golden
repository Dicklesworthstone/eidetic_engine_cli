{"schema":"ee.response.v2","success":true,"data":{"command":"agent-docs","version":"0.3.8","topic":"overview","description":"Durable, local-first, explainable memory for coding agents.","primaryWorkflow":"ee pack \"<task>\" --workspace . --max-tokens 4000 --json","coreCommands":["init","remember","search","pack","why","status"],"recipeCatalogCommand":"ee agent-docs recipes --json","recipeCount":12,"jqExamples":[".data.topics[] | {name, description}",".data.recipes[] | {id, command, jq}",".data.results[] | {memoryId, score}",".data.pack.items[] | {memoryId, section, why}"],"responseFieldMap":{"search":"data.results (count: data.resultCount)","pack":"data.pack.items (omitted: data.pack.omitted)","insights":"data.sections","swarm brief":"data.recommendations","memory list":"data.memories"},"topics":[{"name":"guide","description":"Getting started guide for agents using ee"},{"name":"commands","description":"Complete command reference with arguments and flags"},{"name":"contracts","description":"Stable JSON/TOON output contracts for agent parsing"},{"name":"schemas","description":"Available response and error schema definitions"},{"name":"paths","description":"Default paths for database, indexes, and configuration"},{"name":"env","description":"Environment variables that affect ee behavior"},{"name":"exit-codes","description":"Exit code meanings for scripting and error handling"},{"name":"fields","description":"Field profiles and output verbosity levels"},{"name":"errors","description":"Error codes, categories, and repair suggestions"},{"name":"formats","description":"Output format options (json, toon, human, etc.)"},{"name":"examples","description":"Common workflows and command examples for agents"},{"name":"recipes","description":"Machine-readable workflows with jq selectors and failure branches"}]}}
