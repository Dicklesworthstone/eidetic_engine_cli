      "estimatedCostClass": "standard",
      "claimGateSafeToClaim": true,
      "sourceRefs": [
        {
          "kind": "rch_status",
          "state": "fresh",
          "sourceSchema": "ee.rch.status.v1",
          "hash": "blake3:qp-healthy-rch",
          "boundedPreview": "remote_ready slots_available=3 active_builds=0 queued_builds=0"
        },
        {
          "kind": "manual_fixture",
          "state": "fresh",
          "sourceSchema": "ee.resource_admission.fixture.v1",
          "hash": "blake3:qp-healthy-fixture",
          "boundedPreview": "fixture=healthy_idle_admit"
        }
      ],
      "expected": {
        "level": "idle",
        "reasonCodes": [],
        "abstainedSources": [],
        "decision": "admit",
        "primaryReason": "queue_pressure_idle",
        "contributingReasons": [],
        "blockedBy": [],
        "nextSafeAction": "continue_with_existing_claim_gate",
        "whatWouldChange": "stronger_pressure_evidence_appears"
      }
    },
