  "noMutation": {
    "forbiddenSnippets": [
      "std::process::Command",
      "Command::new",
      "file_reservation_paths",
      "send_message(",
      "acknowledge_message",
      "br update",
      "br close",
      "git add",
      "git commit",
      "cargo test",
      "cargo check",
      "scripts/rch_verify.sh",
      "std::fs::write",
      "remove_file",
      "remove_dir",
      "cancel_active_build",
      "local_cargo_fallback"
    ],
    "redactionForbiddenSubstrings": [
      "/Users/",
      "/data/projects/",
      "mail_body",
      "raw_argv",
      "full_dirty_paths",
      "secret="
    ]
  }
