{
  "schema": "ee.resource_admission.queue_pressure_conformance.v1",
  "beadId": "bd-19bq8",
  "clauses": [
    {
      "id": "MUST-QP-001",
      "level": "MUST",
      "requirement": "queue-pressure evaluation is side-effect-free and advisory-only",
      "status": "tested",
      "cases": ["healthy_idle_admit", "local_cargo_refused"]
    },
    {
      "id": "MUST-QP-002",
      "level": "MUST",
      "requirement": "queue-pressure advice cannot authorize a Beads claim or override claim-gate source authority",
      "status": "tested",
      "cases": ["healthy_low_pressure_unsafe_claim_gate", "rch_slots_exhausted_wait"]
    },
    {
      "id": "MUST-QP-003",
      "level": "MUST",
      "requirement": "queue-pressure levels are bounded to idle, low, moderate, saturated, and unknown",
      "status": "tested",
      "cases": [
        "healthy_idle_admit",
        "healthy_low_pressure_unsafe_claim_gate",
        "output_budget_pressure_degrade",
        "rch_slots_exhausted_wait",
        "agent_mail_recovery_corrupt_read_failure"
      ]
    },
    {
      "id": "MUST-QP-004",
      "level": "MUST",
      "requirement": "reason-code taxonomy covers RCH, Agent Mail, Beads, dirty checkout, local Cargo, output budget, host calibration, and contradictory authority",
      "status": "tested",
      "cases": [
        "rch_slots_exhausted_wait",
        "rch_lane_busy_wait",
        "stale_in_progress_queue",
        "agent_mail_recovery_corrupt_read_failure",
        "beads_external_changes_pending_import",
        "dirty_checkout_standard_queue",
        "local_cargo_refused",
        "output_budget_pressure_degrade",
        "missing_host_calibration_abstain"
      ]
    },
    {
      "id": "MUST-QP-005",
      "level": "MUST",
      "requirement": "source-kind and source-state combinations stay bounded and schema-aligned",
      "status": "tested",
      "cases": [
        "healthy_idle_admit",
        "healthy_low_pressure_unsafe_claim_gate",
        "rch_slots_exhausted_wait",
        "agent_mail_recovery_corrupt_read_failure",
        "beads_external_changes_pending_import",
        "stale_source_abstains"
      ]
    },
    {
      "id": "MUST-QP-006",
      "level": "MUST",
      "requirement": "redacted outputs omit raw mail bodies, raw command argv, host-private paths, and full dirty-path listings",
      "status": "tested",
      "cases": ["agent_mail_recovery_corrupt_read_failure", "dirty_checkout_standard_queue"]
    },
    {
      "id": "MUST-QP-007",
      "level": "MUST",
      "requirement": "queue-pressure source refs and previews are bounded for work-packet, swarm brief, and support-bundle consumers",
      "status": "tested",
      "cases": ["dirty_checkout_standard_queue", "rch_slots_exhausted_wait"]
    },
    {
      "id": "MUST-QP-008",
      "level": "MUST",
      "requirement": "remote_ready alone cannot admit when RCH slot accounting contradicts capacity",
      "status": "tested",
      "cases": ["rch_slots_exhausted_wait"]
    },
    {
      "id": "MUST-QP-009",
      "level": "MUST",
      "requirement": "Agent Mail health green plus recovery corruption or read failure is untrusted evidence",
      "status": "tested",
      "cases": ["agent_mail_recovery_corrupt_read_failure"]
    },
    {
      "id": "MUST-QP-010",
      "level": "MUST",
      "requirement": "Beads clean status plus external_changes_pending_import is contradictory source authority",
      "status": "tested",
      "cases": ["beads_external_changes_pending_import"]
    },
    {
      "id": "MUST-QP-011",
      "level": "MUST",
      "requirement": "local Cargo refusal remains safety-dominant and never becomes a fallback",
      "status": "tested",
      "cases": ["local_cargo_refused"]
    },
    {
      "id": "MUST-QP-012",
      "level": "MUST",
      "requirement": "deterministic advisory decisions cover admit, degrade_to_lean, queue, wait_for_rch, split_workload, refuse_local_cargo, and abstain",
      "status": "tested",
      "cases": [
        "healthy_idle_admit",
        "output_budget_pressure_degrade",
        "dirty_checkout_standard_queue",
        "rch_slots_exhausted_wait",
        "dirty_checkout_swarm_split",
        "local_cargo_refused",
        "agent_mail_recovery_corrupt_read_failure"
      ]
    },
    {
      "id": "SHOULD-QP-013",
      "level": "SHOULD",
      "requirement": "support-bundle or handoff summaries include redacted queue-pressure evidence",
      "status": "tested",
      "cases": ["rch_slots_exhausted_wait", "agent_mail_recovery_corrupt_read_failure"]
    },
    {
      "id": "SHOULD-QP-014",
      "level": "SHOULD",
      "requirement": "advice includes a next safe action and what-would-change counterfactual",
      "status": "tested",
      "cases": [
        "output_budget_pressure_degrade",
        "stale_in_progress_queue",
        "rch_slots_exhausted_wait",
        "local_cargo_refused"
      ]
    },
    {
      "id": "SHOULD-QP-015",
      "level": "SHOULD",
      "requirement": "live-style pressure evidence logs selected decisions and reason codes in JSONL",
      "status": "tested",
      "cases": ["rch_slots_exhausted_wait"]
    }
  ],
  "requiredCoverage": {
    "levels": ["idle", "low", "moderate", "saturated", "unknown"],
    "reasonCodes": [
      "rch_lane_busy",
      "rch_telemetry_gap",
      "active_build_slot_exhausted",
      "stale_in_progress_bead",
      "agent_mail_unavailable",
      "agent_mail_recovery_corrupt",
      "dirty_checkout_saturated",
      "local_cargo_refused",
      "output_budget_pressure",
      "host_calibration_missing",
      "contradictory_source_state"
    ],
    "sourceKinds": [
      "rch_status",
      "rch_selector_admission_probe",
      "build_slot_lease",
      "beads_in_progress_summary",
      "agent_mail_health",
      "agent_mail_recovery_probe",
      "git_dirty_summary",
      "local_cargo_tripwire",
      "output_budget_governor",
      "host_calibration_posture",
      "source_authority_snapshot",
      "manual_fixture"
    ],
    "sourceStates": [
      "fresh",
      "partial",
      "degraded",
      "unavailable",
      "corrupt",
      "stale",
      "contradictory"
    ],
    "decisions": [
      "admit",
      "degrade_to_lean",
      "queue",
      "wait_for_rch",
      "split_workload",
      "refuse_local_cargo",
      "abstain"
    ],
    "redactionChecks": [
      "no_raw_mail_bodies",
      "no_raw_command_argv",
      "no_host_private_paths",
      "no_full_dirty_path_listing"
    ]
  },
  "cases": [
    {
