{
  "schema": "ee.memory_drift.lock_contention.conformance.v1",
  "beadId": "bd-koag5",
  "description": "Fixture-backed conformance matrix for memory-drift lock-contention work-packet and claim-gate projection. Database open or read-snapshot contention means the collector did not inspect memory evidence; it must fail closed without a claim command and must remain distinguishable from inspected-but-unverifiable evidence.",
  "requirements": [
    {
      "id": "bd-1xpq9.must.lock-code",
      "level": "MUST",
      "text": "Lock contention uses the dedicated memory_drift_lock_contention degraded code."
    },
    {
      "id": "bd-1xpq9.must.not-inspected",
      "level": "MUST",
      "text": "Lock contention states memoryEvidenceInspected=false and sourceFreshness=not_inspected."
    },
    {
      "id": "bd-1xpq9.must.redaction",
      "level": "MUST",
      "text": "Contention details are redaction-safe: no database path, lock-holder internals, stack traces, or host-private absolute paths."
    },
    {
      "id": "bd-1xpq9.must.repair",
      "level": "MUST",
      "text": "Repair guidance is non-mutating and points at retrying the read-only drift report and inspecting database health with ee doctor."
    },
    {
      "id": "bd-14cue.must.strategy",
      "level": "MUST",
      "text": "The collector uses the true read-only database open landed under bd-3sh42; ordinary workspace write-owner flock contention does not block inspection."
    },
    {
      "id": "bd-14cue.must.fail-closed",
      "level": "MUST",
      "text": "Work-packet and claim-gate fail closed under lock contention: safeToClaim=false and claimCommandAction=null."
    },
    {
      "id": "bd-14cue.must.no-mutation",
      "level": "MUST",
      "text": "The degraded collector path does not claim Beads, reserve files, send Agent Mail, run Cargo, stage Git, delete files, or mutate durable memory state."
    },
    {
      "id": "bd-koag5.should.distinguish-unverifiable",
      "level": "SHOULD",
      "text": "Consumers can distinguish not-inspected lock contention from inspected-but-unverifiable memory evidence."
    }
  ],
  "cases": [
    {
      "name": "lock_contention_before_evidence",
      "candidateId": "bd-md-lock",
      "candidateTitle": "Handle memory-drift lock contention",
      "memoryDriftSource": {
