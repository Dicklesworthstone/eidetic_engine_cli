        "itemCount": 0,
        "degradedCode": "memory_drift_lock_contention",
        "expectedMessageSubstrings": [
          "database read-snapshot contention",
          "before any evidence inspection",
          "NOT inspected",
          "does not indicate stale provenance"
        ],
        "expectedDetails": {
          "schema": "ee.memory_drift.lock_contention.v1",
          "collectorSurface": "swarm_brief",
          "lockAcquisitionClass": "database_read_snapshot",
          "sourceFreshness": "not_inspected",
          "memoryEvidenceInspected": false
        },
        "summary": null
      },
      "expected": {
        "safeToClaim": false,
        "verdict": "coordinate_first",
        "claimCommandActionNull": true,
        "recommendedAction": "coordinate_before_claim",
        "environmentVerdict": "coordinate_before_claim",
        "degradedCodes": ["memory_drift_lock_contention"],
        "unsafeReasons": ["memory_drift_lock_contention"]
      }
    },
    {
