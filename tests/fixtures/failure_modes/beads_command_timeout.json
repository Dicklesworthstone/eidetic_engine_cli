      "advisory only"
    ],
    "repair_contains": "br",
    "repair_string": "br ready --json",
    "repair_command_regex": "(?<cmd>br [a-z][a-z0-9 -]*(?:--[a-z][a-z0-9-]*(?:[= ][^ ]+)?)*)"
  }
