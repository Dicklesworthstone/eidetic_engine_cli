+fn stable_bindings_unchanged(input: &AutoEnrollmentInput, selected: &[AutoEnrollmentCandidate]) -> bool {
+    selected.iter().all(|candidate| {
+        let Some(stable) = candidate.stable_node_id.as_deref() else {
+            // An older probe must not erase a previously stored binding.
+            return true;
+        };
+        let mut matched = input.existing_peers.iter().filter(|peer| {
+            peer.enabled && peer.node_key == candidate.node_key
+        });
+        matched.next().is_some_and(|peer| peer.stable_node_id.as_deref() == Some(stable))
+            && matched.next().is_none()
+    })
 }
 
