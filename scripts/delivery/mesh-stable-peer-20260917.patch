+#[test]
+fn existing_peer_candidates_keep_the_persisted_stable_identity() {
+    let existing = ExistingAutoEnrollmentPeer {
+        peer_id: "peer_opaque".to_owned(), node_key: candidate('a', None).node_key,
+        stable_node_id: Some("nStable".to_owned()), tailnet_id: Some(TAILNET.to_owned()),
+        tailnet_display_name: None, materialized_on_node_key: None, hostname: "same-name".to_owned(),
+        tailscale_ip: "100.64.0.2".to_owned(), magic_dns_name: None, ee_protocol_version: "1.0".to_owned(),
+        enrollment_source: "explicit_human_consent".to_owned(), enabled: true,
+    };
+    assert_eq!(existing.candidate().stable_node_id, existing.stable_node_id);
+}
