+
+    mod roster_ownership_tests {
+        #![allow(clippy::expect_used, clippy::unwrap_used)]
+
+        use super::*;
+        use crate::db::{CreateWorkspaceInput, DbConnection, InsertTeamMemberInput};
+
+        const OWN: &str = "wsp_00000000000000000000000081";
+        const OTHER: &str = "wsp_00000000000000000000000082";
+
+        struct Fixture {
+            _root: tempfile::TempDir,
+            path: PathBuf,
+            database: PathBuf,
+            writer: DbConnection,
+        }
+
+        impl Fixture {
+            fn new(bind_requested: bool) -> Self {
+                let root = tempfile::tempdir().unwrap();
+                let path = root.path().canonicalize().unwrap();
+                std::fs::create_dir(path.join(".ee")).unwrap();
+                let database = path.join(".ee/ee.db");
+                let writer = DbConnection::open_file(&database).unwrap();
+                writer.migrate().unwrap();
+                if bind_requested {
+                    writer.insert_workspace(OWN, &CreateWorkspaceInput {
+                        path: path.to_string_lossy().into_owned(),
+                        name: None,
+                    }).unwrap();
+                }
+                writer.insert_workspace(OTHER, &CreateWorkspaceInput {
+                    path: path.join("other-project").to_string_lossy().into_owned(),
+                    name: None,
+                }).unwrap();
+                Self { _root: root, path, database, writer }
+            }
+
+            fn member(&self, n: u32, owner: &str, name: &str, state: &str) -> String {
+                let id = format!("mbr_{n:032}");
+                self.writer.insert_team_member(&InsertTeamMemberInput {
+                    member_id: id.clone(),
+                    team_id: format!("team_{owner}"),
+                    workspace_id: owner.to_owned(),
+                    display_name: name.to_owned(),
+                    state: state.to_owned(),
+                    is_self: false,
+                    origin_node_id: format!("node_roster_{n}"),
+                    bound_via: "team_genesis".to_owned(),
+                    joined_at: "2026-09-15T00:00:00Z".to_owned(),
+                }).unwrap();
+                id
+            }
+
+            fn context(&self, supplied: Option<&DbConnection>) -> MemoryScopeContext {
+                MemoryScopeContext {
+                    // Test roster authority, not the harness's own identity.
+                    current_agent: None,
+                    ..MemoryScopeContext::for_workspace_with_connection(
+                        &self.path, MemoryScope::Team, false, supplied,
+                    )
+                }
+            }
+        }
+
+        #[test]
+        fn foreign_workspace_members_cannot_authorize_local_memory_producers() {
+            let fixture = Fixture::new(true);
+            fixture.member(81, OWN, "LocalAgent", "active");
+            fixture.member(82, OTHER, "OutsideAgent", "active");
+            let before = fixture.writer.count_table_rows("audit_log").unwrap();
+            for supplied in [None, Some(&fixture.writer)] {
+                let context = fixture.context(supplied);
+                assert_eq!(context.team_members,
+                    BTreeSet::from(["LocalAgent".to_owned(), "node_roster_81".to_owned()]));
+                assert!(context.memory_in_scope(&memory_with_scope(
+                    TrustClass::PeerHumanAttested, Some("agent:LocalAgent"))));
+                assert!(!context.memory_in_scope(&memory_with_scope(
+                    TrustClass::PeerHumanAttested, Some("agent:OutsideAgent"))));
+            }
+            assert_eq!(fixture.writer.count_table_rows("audit_log").unwrap(), before);
+        }
+
+        #[test]
+        fn removal_cannot_be_undone_by_an_active_namesake_in_another_workspace() {
+            let fixture = Fixture::new(true);
+            fixture.member(81, OWN, "ReturningAgent", "removed");
+            fixture.member(82, OTHER, "ReturningAgent", "active");
+            let context = fixture.context(None);
+            assert!(context.team_members.is_empty());
+            assert!(!context.memory_in_scope(&memory_with_scope(
+                TrustClass::PeerHumanAttested, Some("agent:ReturningAgent"))));
+        }
+
+        #[test]
+        fn an_unbound_store_cannot_adopt_its_only_foreign_roster() {
+            let fixture = Fixture::new(false);
+            fixture.member(82, OTHER, "OutsideAgent", "active");
+            assert!(fixture.context(None).team_members.is_empty());
+            assert!(fixture.context(Some(&fixture.writer)).team_members.is_empty());
+            assert_eq!(fixture.writer.list_workspaces().unwrap().len(), 1);
+            assert!(fixture.writer.get_workspace(OWN).unwrap().is_none());
+        }
+
+        #[test]
+        fn caller_snapshot_retains_membership_until_release_then_observes_revocation() {
+            let fixture = Fixture::new(true);
+            let member = fixture.member(81, OWN, "LocalAgent", "active");
+            let reader = DbConnection::open_file_read_only(&fixture.database).unwrap();
+            reader.begin_read_snapshot().unwrap();
+            assert!(reader.get_workspace(OWN).unwrap().is_some());
+            assert!(fixture.writer.set_team_member_state(&member, "removed").unwrap());
+            assert!(fixture.context(Some(&reader)).team_members.contains("LocalAgent"));
+            reader.rollback_read_snapshot().expect("scope read must not release the caller's snapshot");
+            assert!(fixture.context(Some(&reader)).team_members.is_empty());
+            assert!(fixture.context(None).team_members.is_empty());
+        }
+
+        #[test]
+        fn failed_workspace_authority_never_falls_back_to_unfiltered_membership() {
+            let fixture = Fixture::new(true);
+            fixture.member(81, OWN, "LocalAgent", "active");
+            fixture.writer.execute_raw("ALTER TABLE workspaces RENAME TO unavailable_roster_workspaces").unwrap();
+            assert_eq!(fixture.writer.list_all_team_members().unwrap().len(), 1);
+            assert!(fixture.context(None).team_members.is_empty());
+            assert!(fixture.context(Some(&fixture.writer)).team_members.is_empty());
+            fixture.writer.begin_read_snapshot().unwrap();
+            fixture.writer.rollback_read_snapshot().unwrap();
+        }
+    }
+}
