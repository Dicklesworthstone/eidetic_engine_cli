+/// A team row is authority only in its owning workspace. A multi-workspace
+/// store must not let an active membership elsewhere undo a local removal or
+/// authorize an unrelated producer. No matching binding is absence of authority,
+/// not permission to choose the first workspace or union all its rosters.
+fn bound_team_members(
+    workspace_path: &Path,
+    connection: &crate::db::DbConnection,
+) -> Option<BTreeSet<String>> {
+    let workspace = crate::core::workspace::addressed_workspace_row(
+        connection,
+        workspace_path,
+        &workspace_path.join(".ee").join("ee.db"),
+    )
+    .ok()??;
+    let rows = connection.list_all_team_members().ok()?;
+    let mut members = BTreeSet::new();
+    for row in rows {
+        if row.workspace_id == workspace.id && row.state == "active" {
+            if let Some(name) = normalized_non_empty(row.display_name) {
+                members.insert(name);
+            }
+            if let Some(node) = normalized_non_empty(row.origin_node_id) {
+                members.insert(node);
             }
         }
     }
-    members
+    Some(members)
 }
 
