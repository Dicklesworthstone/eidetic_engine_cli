+    command(&workspace, &["rule", "update", &id, "--scope-pattern", "tests"])?;
+    let stale_target = command(&workspace, &["ask", QUESTION, "--path", "src/lib.rs", "--read-only"])?;
+    assert_eq!(stale_target["data"]["abstained"], true);
+    assert!(!stale_target.to_string().contains(&id));
+    let moved = command(&workspace, &["ask", QUESTION, "--path", "tests/check.rs", "--read-only"])?;
+    check_citation(&moved["data"]["citations"][0], &id, RULE)?;
+    assert_ne!(moved["data"]["citations"][0]["entityRevision"], original["data"]["citations"][0]["entityRevision"]);
+    command(&workspace, &["rule", "mark", &id, "--trigger", "deprecate"])?;
+    let retired = command(&workspace, &["ask", QUESTION, "--path", "tests/check.rs", "--read-only"])?;
+    assert_eq!(retired["data"]["abstained"], true);
+    assert!(!retired.to_string().contains(&id));
+    Ok(())
+}
