+/// Before activation the new generation is still at the staging name, so a
+/// failed retention barrier must restore the old name without quarantining it.
+struct RetainedIndexRestoreGuard<'a> {
+    index_dir: &'a Path,
+    retained_dir: Option<&'a Path>,
+    armed: bool,
+}
+
+impl RetainedIndexRestoreGuard<'_> {
+    fn restore(&mut self) -> Result<(), IndexRebuildError> {
+        if self.armed {
+            self.armed = false;
+            if let Some(retained) = self.retained_dir {
+                if path_exists_no_follow(self.index_dir) {
+                    return Err(IndexRebuildError::Index(
+                        "Refusing to overwrite an unexpected active index during restoration".to_owned(),
+                    ));
+                }
+                rename_index_dir(retained, self.index_dir, "restore previous index generation")?;
+                sync_index_directory(index_parent(self.index_dir))?;
             }
         }
-        return Err(error);
-    }
-
-    Ok(retained_dir)
+        Ok(())
+    }
+}
+
+impl Drop for RetainedIndexRestoreGuard<'_> {
+    fn drop(&mut self) {
+        if let Err(error) = self.restore() {
+            tracing::error!(target: "ee::index", %error, "failed to restore index during publication unwind");
+        }
+    }
 }
 
