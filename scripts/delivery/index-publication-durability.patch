+/// Iterative postorder keeps each directory entry behind its flushed children
+/// without a recursion-depth dependency on an index backend's directory shape.
+fn sync_index_generation(
+    root: &Path,
+    checkpoint: impl FnMut() -> Result<(), IndexRebuildError>,
+) -> Result<(), IndexRebuildError> {
+    sync_index_generation_with(root, checkpoint, sync_index_entry)
+}
+
+fn sync_index_generation_with(
+    root: &Path,
+    mut checkpoint: impl FnMut() -> Result<(), IndexRebuildError>,
+    mut sync: impl FnMut(&Path, bool) -> Result<(), IndexRebuildError>,
+) -> Result<(), IndexRebuildError> {
+    ensure_index_path_has_no_symlinks(root, "flush staged index generation")?;
+    ensure_index_publish_source_is_directory(root, "flush staged index generation")?;
+    let mut pending = vec![(root.to_path_buf(), false)];
+    while let Some((path, visited)) = pending.pop() {
+        checkpoint()?;
+        let metadata = std::fs::symlink_metadata(&path).map_err(|error| {
+            IndexRebuildError::Index(format!("Failed to inspect index durability entry: {error}"))
+        })?;
+        if metadata.file_type().is_dir() {
+            if visited {
+                sync(&path, true)?;
+            } else {
+                let mut children = std::fs::read_dir(&path)
+                    .and_then(|entries| entries.map(|entry| entry.map(|entry| entry.path()))
+                        .collect::<Result<Vec<_>, _>>())
+                    .map_err(|error| IndexRebuildError::Index(format!(
+                        "Failed to enumerate staged index durability entries: {error}"
+                    )))?;
+                children.sort();
+                pending.push((path, true));
+                pending.extend(children.into_iter().rev().map(|path| (path, false)));
+            }
+        } else if metadata.file_type().is_file() && !visited {
+            sync(&path, false)?;
+        } else {
+            return Err(IndexRebuildError::Index(
+                "Refusing to flush an index generation containing a symlink or special entry".to_owned(),
+            ));
+        }
+    }
+    Ok(())
+}
+
+fn sync_index_entry(path: &Path, directory: bool) -> Result<(), IndexRebuildError> {
+    if directory {
+        return sync_index_directory(path);
+    }
+    ensure_index_path_has_no_symlinks(path, "flush index data")?;
+    let mut options = std::fs::OpenOptions::new();
+    options.read(true);
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::OpenOptionsExt;
+        options.custom_flags((rustix::fs::OFlags::NOFOLLOW | rustix::fs::OFlags::NONBLOCK).bits() as i32);
+    }
+    // FlushFileBuffers requires a writable handle on Windows. These are owned
+    // build artifacts, never source-of-truth memory files.
+    #[cfg(not(unix))]
+    options.write(true);
+    let file = options.open(path).map_err(|error| {
+        IndexRebuildError::Index(format!("Failed to open index data for durability: {error}"))
+    })?;
+    if !file.metadata().map_err(|error| IndexRebuildError::Index(error.to_string()))?.is_file() {
+        return Err(IndexRebuildError::Index("Index durability entry changed type".to_owned()));
+    }
+    file.sync_all().map_err(|error| {
+        IndexRebuildError::Index(format!("Failed to flush index data before publication: {error}"))
+    })
+}
+
+fn sync_index_directory(path: &Path) -> Result<(), IndexRebuildError> {
+    ensure_index_path_has_no_symlinks(path, "flush index directory")?;
+    ensure_index_publish_source_is_directory(path, "flush index directory")?;
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::OpenOptionsExt;
+        std::fs::OpenOptions::new().read(true)
+            .custom_flags((rustix::fs::OFlags::NOFOLLOW | rustix::fs::OFlags::DIRECTORY).bits() as i32)
+            .open(path).and_then(|directory| directory.sync_all())
+            .map_err(|error| IndexRebuildError::Index(format!(
+                "Failed to flush index directory before publication: {error}"
+            )))?;
+    }
+    // Preserve the existing non-Unix rename behavior; std does not provide a
+    // portable directory persistence barrier. Only Unix claims directory fsync.
+    Ok(())
 }
 
