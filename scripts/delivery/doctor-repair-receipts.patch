+    #[test]
+    fn doctor_fix_guidance_does_not_hide_a_real_reversible_mutation() -> TestResult {
+        use crate::core::doctor_fixers::FixerDispatch;
+        use crate::core::doctor_runtime::Op;
+
+        let root = tempfile::tempdir().map_err(|error| error.to_string())?;
+        let workspace = root.path().canonicalize().map_err(|error| error.to_string())?;
+        let target = workspace.join(".ee/repaired-state");
+        let result = doctor_fix_dispatches(&workspace, vec![
+            FixerDispatch {
+                finding_code: "state_repair", severity: "warning", path: target.clone(),
+                op: Op::WriteFile { bytes: b"repaired".to_vec() },
+            },
+            FixerDispatch {
+                finding_code: "manual_repair", severity: "warning", path: workspace.join(".ee/config.toml"),
+                op: Op::Manual { steps: vec!["Review the configuration".to_owned()] },
+            },
+        ]);
+        let value: serde_json::Value = serde_json::from_str(&result.json)
+            .map_err(|error| error.to_string())?;
+        ensure_equal(&value["data"]["appliedFixerCount"], &serde_json::json!(1), "real mutation count")?;
+        ensure_equal(&value["data"]["guidanceFixerCount"], &serde_json::json!(1), "pending guidance count")?;
+        ensure_equal(&std::fs::read(&target).map_err(|error| error.to_string())?, &b"repaired".to_vec(), "real file was repaired")?;
+        let run = value["data"]["runId"].as_str().ok_or("missing run ID")?;
+        crate::core::doctor_runtime::replay_undo_for_workspace(&workspace, run)
+            .map_err(|error| error.to_string())?;
+        ensure(!target.exists(), "partial run remains undoable")
+    }
