+    fn doctor_fix_guidance_is_not_reported_as_an_applied_repair() -> TestResult {
+        use crate::core::doctor_fixers::FixerDispatch;
+        use crate::core::doctor_runtime::Op;
+
+        let root = tempfile::tempdir().map_err(|error| error.to_string())?;
+        let workspace = root.path().canonicalize().map_err(|error| error.to_string())?;
+        let result = doctor_fix_dispatches(&workspace, vec![FixerDispatch {
+            finding_code: "pending_graph_repair",
+            severity: "warning",
+            path: workspace.join(".ee/graph"),
+            op: Op::RunGraphRefresh { steps: vec!["ee graph centrality-refresh".to_owned()] },
+        }]);
+        let value: serde_json::Value = serde_json::from_str(&result.json)
+            .map_err(|error| error.to_string())?;
+        ensure(result.exit_code != ProcessExitCode::Success, "pending repair must not exit successfully")?;
+        ensure_equal(&value["success"], &serde_json::json!(false), "pending success flag")?;
+        ensure_equal(&value["data"]["status"], &serde_json::json!("completed_partial"), "pending run status")?;
+        ensure_equal(&value["data"]["fixerResults"][0]["outcome"], &serde_json::json!("guidance_recorded"), "actual effect")?;
+        ensure_equal(&value["data"]["appliedFixerCount"], &serde_json::json!(0), "no applied repair")?;
+        ensure_equal(&value["data"]["guidanceFixerCount"], &serde_json::json!(1), "guidance count")?;
+        ensure_equal(&value["data"]["skippedFixerCount"], &serde_json::json!(0), "guidance was recorded, not skipped")?;
+        ensure(!workspace.join(".ee/graph").exists(), "guidance did not create a graph")
+    }
