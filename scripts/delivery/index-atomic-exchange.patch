+    #[cfg(any(target_os = "linux", target_os = "android", target_vendor = "apple"))]
+    #[test]
+    fn publication_exchange_readers_never_observe_a_missing_generation_during_replacement() -> TestResult {
+        let root = tempfile::tempdir().map_err(|error| error.to_string())?;
+        let path = root.path().canonicalize().map_err(|error| error.to_string())?;
+        let active = path.join("index");
+        let candidate = path.join("candidate");
+        write_marker(&active, "generation", "old")?;
+        write_marker(&candidate, "generation", "new")?;
+        let ready = std::sync::Barrier::new(2);
+        std::thread::scope(|scope| -> TestResult {
+            let reader = scope.spawn(|| -> Result<usize, String> {
+                let mut failure = None;
+                for _ in 0..256 {
+                    ready.wait();
+                    let result = std::fs::read(active.join("generation"))
+                        .map_err(|error| error.to_string())
+                        .and_then(|body| ensure(body == b"old" || body == b"new", "reader observed a mixed payload"));
+                    if failure.is_none() {
+                        failure = result.err();
+                    }
+                    // Even a failed observation must release the publisher;
+                    // the actual error is returned after the finite schedule.
+                    ready.wait();
+                }
+                failure.map_or(Ok(256), Err)
+            });
+            let mut failure = None;
+            for _ in 0..256 {
+                ready.wait();
+                let result = exchange_index_directories(&active, &candidate).map_err(|error| error.to_string());
+                if failure.is_none() {
+                    failure = result.err();
+                }
+                ready.wait();
+            }
+            let reads = reader.join().map_err(|_| "reader thread panicked".to_owned())??;
+            failure.map_or(Ok(()), Err)?;
+            ensure(reads == 256, "reader must sample every real exchange round")
+        })
+    }
