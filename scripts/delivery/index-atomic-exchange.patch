+    #[cfg(any(target_os = "linux", target_os = "android", target_vendor = "apple"))]
+    #[test]
+    fn publication_exchange_retention_failure_and_unwind_restore_atomically() -> TestResult {
+        for panic_after_swap in [false, true] {
+            let root = tempfile::tempdir().map_err(|error| error.to_string())?;
+            let path = root.path().canonicalize().map_err(|error| error.to_string())?;
+            let active = path.join("index");
+            let staged = path.join(".index.publish-test");
+            write_marker(&active, "generation", "old")?;
+            write_marker(&staged, "generation", "new")?;
+            let before = index_regular_file_snapshot(&active)?;
+            let attempted = std::cell::Cell::new(false);
+            let result = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+                publish_index_by_exchange(&active, &staged, &mut sync_index_directory, |from, _| {
+                    // This seam runs AFTER a real kernel exchange, not instead
+                    // of it. Both actual directory trees are inspected here.
+                    if read_marker(&active, "generation").ok().as_deref() != Some("new")
+                        || read_marker(from, "generation").ok().as_deref() != Some("old")
+                    {
+                        return Err(IndexRebuildError::Index("kernel exchange did not take place".to_owned()));
+                    }
+                    attempted.set(true);
+                    if panic_after_swap {
+                        panic!("injected retention unwind after atomic exchange");
+                    }
+                    Err(IndexRebuildError::Index("injected retention failure after atomic exchange".to_owned()))
+                })
+            }));
+            ensure(attempted.get(), "test must reach the post-exchange boundary")?;
+            ensure(if panic_after_swap { result.is_err() } else { matches!(result, Ok(Err(_))) },
+                "retention failure must not be acknowledged as a publication")?;
+            ensure(index_regular_file_snapshot(&active)? == before, "atomic rollback must restore old bytes")?;
+            ensure(read_marker(&staged, "generation")? == "new", "failed candidate must remain inspectable")?;
+        }
+        Ok(())
+    }
