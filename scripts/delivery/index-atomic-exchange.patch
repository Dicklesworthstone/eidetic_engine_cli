+#[cfg(any(target_os = "linux", target_os = "android", target_vendor = "apple"))]
+fn exchange_index_directories(left: &Path, right: &Path) -> Result<(), IndexRebuildError> {
+    ensure_index_path_has_no_symlinks(left, "exchange index generations")?;
+    ensure_index_path_has_no_symlinks(right, "exchange index generations")?;
+    ensure_index_publish_source_is_directory(left, "exchange index generations")?;
+    ensure_index_publish_source_is_directory(right, "exchange index generations")?;
+    rustix::fs::renameat_with(
+        rustix::fs::CWD, left, rustix::fs::CWD, right, rustix::fs::RenameFlags::EXCHANGE,
+    ).map_err(|error| IndexRebuildError::Index(format!(
+        "Atomic index directory exchange failed; no non-atomic fallback was attempted: {error}"
+    )))
+}
+
+/// Keep the live pathname present throughout replacement. The displaced old
+/// generation moves from the staging name to retention only AFTER the swap.
+#[cfg(any(target_os = "linux", target_os = "android", target_vendor = "apple"))]
+fn publish_index_by_exchange(
+    index_dir: &Path,
+    staging_dir: &Path,
+    sync_directory: &mut impl FnMut(&Path) -> Result<(), IndexRebuildError>,
+    retain: impl FnOnce(&Path, &Path) -> Result<(), IndexRebuildError>,
+) -> Result<Option<PathBuf>, IndexRebuildError> {
+    let retained = allocate_retained_index_dir(index_dir)?;
+    // Persist the old directory while it is STILL live. A directory fsync in
+    // the old retain-then-rename gap would prolong reader-visible absence.
+    sync_directory(index_dir)?;
+    exchange_index_directories(index_dir, staging_dir)?;
+    let mut rollback = IndexExchangeRestoreGuard { index_dir, displaced: staging_dir, armed: true };
+    if let Err(primary_error) = retain(staging_dir, &retained) {
+        if let Err(restore_error) = rollback.restore() {
+            return Err(IndexRebuildError::Index(format!(
+                "index retention failed ({primary_error}); atomic restoration also failed ({restore_error})"
+            )));
+        }
+        return Err(primary_error);
+    }
+    rollback.armed = false;
+    Ok(Some(retained))
+}
+
+#[cfg(any(target_os = "linux", target_os = "android", target_vendor = "apple"))]
+struct IndexExchangeRestoreGuard<'a> {
+    index_dir: &'a Path,
+    displaced: &'a Path,
+    armed: bool,
+}
+
+#[cfg(any(target_os = "linux", target_os = "android", target_vendor = "apple"))]
+impl IndexExchangeRestoreGuard<'_> {
+    fn restore(&mut self) -> Result<(), IndexRebuildError> {
+        if self.armed {
+            self.armed = false;
+            exchange_index_directories(self.index_dir, self.displaced)?;
+            sync_index_directory(index_parent(self.index_dir))?;
+            if index_parent(self.displaced) != index_parent(self.index_dir) {
+                sync_index_directory(index_parent(self.displaced))?;
+            }
+        }
+        Ok(())
+    }
+}
+
+#[cfg(any(target_os = "linux", target_os = "android", target_vendor = "apple"))]
+impl Drop for IndexExchangeRestoreGuard<'_> {
+    fn drop(&mut self) {
+        if let Err(error) = self.restore() {
+            tracing::error!(target: "ee::index", %error, "failed to atomically restore displaced index during unwind");
+        }
+    }
+}
