{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eidetic-engine/schemas/ee.mesh.auto_status.v1.json",
  "title": "ee.mesh.auto_status.v1",
  "description": "Read-only auto-enrollment posture block emitted by `ee mesh status --json`. It composes local Tailscale, hello responder, discovery cache, materialized peer-set, drift, steward, and shared repair-action-graph hints without mutating mesh state.",
  "type": "object",
  "required": [
    "schema",
    "enabled",
    "readOnly",
    "tailscale",
    "helloResponder",
    "discovery",
    "discoveryCache",
    "materialized",
    "peerStateBreakdown",
    "drift",
    "stewardPosture",
    "degraded"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "const": "ee.mesh.auto_status.v1"
    },
    "enabled": {
      "type": "boolean"
    },
    "readOnly": {
      "type": "boolean",
      "const": true
    },
    "tailscale": {
      "type": "object",
      "required": [
        "schema",
        "status",
        "authenticated",
        "shieldsUp",
        "binaryAuthentic",
        "tailnetDisplayName",
        "peerCount"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "type": "string",
          "const": "ee.tailscale.local.v1"
        },
        "status": {
          "type": "string",
          "enum": ["not_probed", "authenticated", "not_authenticated"]
        },
        "authenticated": {
          "type": ["boolean", "null"]
        },
        "shieldsUp": {
          "type": ["boolean", "null"]
        },
        "binaryAuthentic": {
          "type": ["boolean", "null"]
        },
        "tailnetDisplayName": {
          "type": ["string", "null"]
        },
        "peerCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "helloResponder": {
      "type": "object",
      "required": ["schema", "status", "running", "listenAddr"],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "type": "string",
          "const": "ee.mesh.hello_responder.status.v1"
        },
        "status": {
          "type": "string",
          "enum": ["not_probed", "running", "not_running"]
        },
        "running": {
          "type": ["boolean", "null"]
        },
        "listenAddr": {
          "type": ["string", "null"]
        }
      }
    },
    "discovery": {
      "$ref": "#/$defs/tailscaleAutodiscovery"
    },
    "discoveryCache": {
      "type": "object",
      "required": ["schema", "status", "ttlSeconds", "hit", "refreshedAt"],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "type": "string",
          "const": "ee.mesh.discovery_cache.status.v1"
        },
        "status": {
          "type": "string",
          "enum": ["not_loaded"]
        },
        "ttlSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "hit": {
          "type": ["boolean", "null"]
        },
        "refreshedAt": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      }
    },
    "tailscaleAutodiscovery": {
      "type": "object",
      "required": [
        "schema",
        "tailnetId",
        "tailnetDisplayName",
        "selfNodeKey",
        "probedPeerCount",
        "eligiblePeerCount",
        "eeCapablePeers",
        "skippedPeers",
        "degraded"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "type": "string",
          "const": "ee.tailscale.autodiscovery.v1"
        },
        "tailnetId": {
          "type": ["string", "null"]
        },
        "tailnetDisplayName": {
          "type": ["string", "null"]
        },
        "selfNodeKey": {
          "type": ["string", "null"]
        },
        "probedPeerCount": {
          "type": "integer",
          "minimum": 0
        },
        "eligiblePeerCount": {
          "type": "integer",
          "minimum": 0
        },
        "eeCapablePeers": {
          "type": "array",
          "items": { "$ref": "#/$defs/autodiscoveryPeer" }
        },
        "skippedPeers": {
          "type": "array",
          "items": { "$ref": "#/$defs/autodiscoverySkippedPeer" }
        },
        "degraded": {
          "type": "array",
          "items": { "$ref": "#/$defs/degradation" }
        }
      }
    },
    "autodiscoveryPeer": {
      "type": "object",
      "required": [
        "nodeKey",
        "tailscaleIp",
        "magicDnsName",
        "hostname",
        "eeProtocolVersion",
        "workspaceMatchSet",
        "lastProbedAt",
        "latencyMs",
        "discoveryPolicyDecision"
      ],
      "additionalProperties": false,
      "properties": {
        "nodeKey": { "type": "string" },
        "tailscaleIp": { "type": "string" },
        "magicDnsName": { "type": ["string", "null"] },
        "hostname": { "type": ["string", "null"] },
        "eeProtocolVersion": { "type": "string" },
        "workspaceMatchSet": {
          "type": "array",
          "items": { "type": "string" }
        },
        "lastProbedAt": { "type": "string" },
        "latencyMs": {
          "type": "integer",
          "minimum": 0
        },
        "discoveryPolicyDecision": {
          "enum": ["auto_admit", "service_tag_match", "allowlisted"]
        }
      }
    },
    "autodiscoverySkippedPeer": {
      "type": "object",
      "required": ["nodeKey", "reason"],
      "additionalProperties": false,
      "properties": {
        "nodeKey": { "type": "string" },
        "reason": {
          "enum": [
            "no_discovery_consent",
            "denied_by_policy",
            "probe_timeout",
            "probe_malformed",
            "workspace_mismatch",
            "non_ee"
          ]
        }
      }
    },
    "materialized": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "#/$defs/materialized" }
      ]
    },
    "peerStateBreakdown": {
      "$ref": "#/$defs/peerStateBreakdown"
    },
    "drift": {
      "$ref": "#/$defs/drift"
    },
    "stewardPosture": {
      "$ref": "#/$defs/stewardPosture"
    },
    "degraded": {
      "type": "array",
      "items": { "$ref": "#/$defs/degradation" }
    }
  },
  "$defs": {
    "materialized": {
      "type": "object",
      "required": [
        "peerGroupId",
        "peerSetHash",
        "peerCount",
        "lanePolicy",
        "boundTailnetId",
        "materializedOnNodeKey",
        "lastMaterializedAt",
        "enrollmentSource"
      ],
      "additionalProperties": false,
      "properties": {
        "peerGroupId": {
          "type": "string",
          "pattern": "^pg_[A-Za-z0-9._:-]+$"
        },
        "peerSetHash": {
          "type": "string",
          "pattern": "^blake3:[0-9a-f]{64}$"
        },
        "peerCount": {
          "type": "integer",
          "minimum": 0
        },
        "lanePolicy": {
          "$ref": "#/$defs/lanePolicy"
        },
        "boundTailnetId": {
          "type": ["string", "null"]
        },
        "materializedOnNodeKey": {
          "type": ["string", "null"]
        },
        "lastMaterializedAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "enrollmentSource": {
          "type": "string",
          "enum": ["auto", "manual", "auto_replaced_manual"]
        }
      }
    },
    "lanePolicy": {
      "type": "object",
      "required": [
        "metadata",
        "body",
        "embedding",
        "graphLink",
        "revisionNotice",
        "curationSignal"
      ],
      "additionalProperties": false,
      "properties": {
        "metadata": { "$ref": "#/$defs/laneDecision" },
        "body": { "$ref": "#/$defs/laneDecision" },
        "embedding": { "$ref": "#/$defs/laneDecision" },
        "graphLink": { "$ref": "#/$defs/laneDecision" },
        "revisionNotice": { "$ref": "#/$defs/laneDecision" },
        "curationSignal": { "$ref": "#/$defs/laneDecision" }
      }
    },
    "laneDecision": {
      "type": "string",
      "enum": ["allow", "quarantine", "deny"]
    },
    "peerStateBreakdown": {
      "type": "object",
      "required": ["active", "softStale", "hardStale", "denylisted"],
      "additionalProperties": false,
      "properties": {
        "active": { "type": "integer", "minimum": 0 },
        "softStale": { "type": "integer", "minimum": 0 },
        "hardStale": { "type": "integer", "minimum": 0 },
        "denylisted": { "type": "integer", "minimum": 0 }
      }
    },
    "drift": {
      "type": "object",
      "required": [
        "newPeersAvailable",
        "newPeerCount",
        "stalePeersInConfig",
        "transientUnreachable",
        "tailnetChanged",
        "nodeKeyChanged",
        "manualConflictPresent",
        "driftSeverity",
        "actionGraph",
        "nextActionHint"
      ],
      "additionalProperties": false,
      "properties": {
        "newPeersAvailable": {
          "type": "array",
          "items": { "type": "string" }
        },
        "newPeerCount": {
          "type": "integer",
          "minimum": 0
        },
        "stalePeersInConfig": {
          "type": "array",
          "items": { "type": "string" }
        },
        "transientUnreachable": {
          "type": "array",
          "items": { "type": "string" }
        },
        "tailnetChanged": {
          "type": "boolean"
        },
        "nodeKeyChanged": {
          "type": "boolean"
        },
        "manualConflictPresent": {
          "type": "boolean"
        },
        "driftSeverity": {
          "type": "string",
          "enum": ["none", "info", "warning", "medium"]
        },
        "actionGraph": {
          "$ref": "ee.repair_action_graph.v1.json"
        },
        "nextActionHint": {
          "type": "string"
        }
      }
    },
    "stewardPosture": {
      "type": "object",
      "required": ["schema", "status", "enabled", "lastReconciliationAt"],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "type": "string",
          "const": "ee.mesh.steward_posture.v1"
        },
        "status": {
          "type": "string",
          "enum": ["not_inspected"]
        },
        "enabled": {
          "type": "boolean"
        },
        "lastReconciliationAt": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      }
    },
    "degradation": {
      "type": "object",
      "required": ["code", "severity", "message", "repair"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string" },
        "severity": { "type": "string" },
        "message": { "type": "string" },
        "repair": { "type": "string" }
      }
    }
  }
}
