{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eidetic-engine/schemas/ee.import.cass.v1.json",
  "title": "ee.import.cass.v1",
  "description": "ee import cass response envelope.",
  "type": "object",
  "required": ["schema", "success", "data", "degraded"],
  "additionalProperties": false,
  "properties": {
    "schema": { "type": "string", "const": "ee.response.v2" },
    "success": { "type": "boolean" },
    "fields": { "type": "string" },
    "degraded": { "type": "array", "items": { "type": "object" } },
    "data": {
      "type": "object",
      "required": [
        "schema",
        "command",
        "workspacePath",
        "databasePath",
        "sourceId",
        "ledgerId",
        "dryRun",
        "since",
        "sessionsDiscovered",
        "sessionsImported",
        "sessionsSkipped",
        "spansImported",
        "indexJobsQueued",
        "indexRequiredAction",
        "status",
        "evidenceAdmission",
        "sessions"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": { "type": "string", "const": "ee.import.cass.v1" },
        "command": { "type": "string", "const": "import cass" },
        "workspacePath": { "type": "string" },
        "databasePath": { "type": ["string", "null"] },
        "sourceId": { "type": "string" },
        "ledgerId": { "type": ["string", "null"] },
        "dryRun": { "type": "boolean" },
        "since": { "type": ["string", "null"] },
        "sessionsDiscovered": { "type": "integer" },
        "sessionsImported": { "type": "integer" },
        "sessionsSkipped": { "type": "integer", "description": "Already-imported sessions plus explicitly refused historical sessions; inspect sessions[].status." },
        "spansImported": { "type": "integer" },
        "indexJobsQueued": { "type": "integer" },
        "indexRequiredAction": { "type": ["string", "null"] },
        "status": { "type": "string", "description": "completed, completed_with_refusals, or dry_run. A completed_with_refusals run preserves refused sessions and processes other sessions." },
        "evidenceAdmission": {
          "type": "object",
          "description": "Admission of the spans this run wrote. quarantineReasons counts each kept-out span by its first policy reason: record_kind:<kind>, record_role:<role>, span:<kind>/<role>, or instruction:<signal>.",
          "required": ["admitted", "quarantined", "quarantineReasons"],
          "additionalProperties": false,
          "properties": {
            "admitted": { "type": "integer", "minimum": 0 },
            "quarantined": { "type": "integer", "minimum": 0 },
            "quarantineReasons": {
              "type": "object",
              "additionalProperties": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "sessions": {
          "type": "array",
          "description": "Per-session status is imported, skipped, would_import, or refused. Refused entries additionally carry refusalCode and repair; their historical rows were not changed.",
          "items": { "type": "object", "additionalProperties": { "$ref": "#/$defs/jsonValue" } }
        }
      }
    }
  },
  "field_presets": {
    "minimal": ["schema", "command", "status"],
    "summary": [
      "schema",
      "command",
      "status",
      "sessionsDiscovered",
      "sessionsImported",
      "sessionsSkipped",
      "spansImported"
    ],
    "standard": [
      "schema",
      "command",
      "workspacePath",
      "databasePath",
      "sourceId",
      "ledgerId",
      "dryRun",
      "since",
      "sessionsDiscovered",
      "sessionsImported",
      "sessionsSkipped",
      "spansImported",
      "indexJobsQueued",
      "indexRequiredAction",
      "status",
      "evidenceAdmission",
      "sessions"
    ],
    "full": ["*"]
  },
  "$defs": {
    "jsonValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        { "type": "array", "items": { "$ref": "#/$defs/jsonValue" } },
        { "type": "object", "additionalProperties": { "$ref": "#/$defs/jsonValue" } }
      ]
    }
  }
}
