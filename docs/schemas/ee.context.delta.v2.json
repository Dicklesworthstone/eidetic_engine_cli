{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eidetic-engine/schemas/ee.context.delta.v2.json",
  "title": "ee.context.delta.v2",
  "description": "Transport-time delta envelope for ee context --since. V2 makes the server-verified authority marker truthful for both public API snapshots and centrally verified persisted-pack snapshots.",
  "type": "object",
  "required": ["schema", "success", "data", "degraded"],
  "additionalProperties": false,
  "properties": {
    "schema": {"type": "string", "const": "ee.context.delta.v2"},
    "success": {"type": "boolean", "const": true},
    "data": {"$ref": "#/$defs/contextDelta"},
    "degraded": {"type": "array", "items": {"$ref": "#/$defs/degradation"}}
  },
  "$defs": {
    "contextDelta": {
      "type": "object",
      "required": ["priorPackHash", "newPackHash", "items", "tokenSavings", "serverDecision"],
      "additionalProperties": false,
      "properties": {
        "priorPackHash": {"type": "string"},
        "newPackHash": {"type": "string"},
        "workspaceId": {"type": ["string", "null"]},
        "baseDbGeneration": {"type": ["integer", "null"], "minimum": 0},
        "newDbGeneration": {"type": ["integer", "null"], "minimum": 0},
        "priorFeatureFlagSetHash": {"type": ["string", "null"]},
        "newFeatureFlagSetHash": {"type": ["string", "null"]},
        "items": {"$ref": "#/$defs/itemDiff"},
        "tokenSavings": {"$ref": "#/$defs/tokenSavings"},
        "serverDecision": {
          "type": "object",
          "required": ["computedFromServerVerifiedPackRecord", "deltaChained", "format"],
          "additionalProperties": false,
          "properties": {
            "computedFromServerVerifiedPackRecord": {"type": "boolean"},
            "deltaChained": {"type": "boolean", "const": false},
            "format": {"type": "string", "enum": ["json", "markdown"]},
            "fallbackReason": {
              "type": ["string", "null"],
              "enum": [null, "prior_unknown", "delta_larger_than_full", "redaction_drift", "compute_budget_exceeded", "envelope_oversized", "prior_corrupted", "format_unsupported", "feature_flag_drift"]
            }
          }
        },
        "trace": {"type": "object", "additionalProperties": {"$ref": "#/$defs/jsonValue"}}
      }
    },
    "itemDiff": {
      "type": "object",
      "required": ["added", "removed", "modified"],
      "additionalProperties": false,
      "properties": {
        "added": {"type": "array", "items": {"$ref": "#/$defs/packItem"}},
        "removed": {"type": "array", "items": {"type": "string"}},
        "modified": {"type": "array", "items": {"$ref": "#/$defs/modifiedItem"}}
      }
    },
    "modifiedItem": {
      "type": "object",
      "required": ["id", "fieldChanges"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "fieldChanges": {"type": "object", "additionalProperties": {"$ref": "#/$defs/fieldChange"}}
      }
    },
    "fieldChange": {
      "oneOf": [
        {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [{"$ref": "#/$defs/jsonValue"}, {"$ref": "#/$defs/jsonValue"}]
        },
        {
          "type": "object",
          "required": ["newValue", "oldValueOmitted", "reason"],
          "additionalProperties": false,
          "properties": {
            "newValue": {"$ref": "#/$defs/jsonValue"},
            "oldValueOmitted": {"type": "boolean", "const": true},
            "reason": {"type": "string", "enum": ["redaction_drift", "policy_restricted"]}
          }
        }
      ]
    },
    "tokenSavings": {
      "type": "object",
      "required": ["fullBytes", "deltaBytes", "savedBytes", "savedPercent", "netPackTokens"],
      "additionalProperties": false,
      "properties": {
        "fullBytes": {"type": "integer", "minimum": 0},
        "deltaBytes": {"type": "integer", "minimum": 0},
        "savedBytes": {"type": "integer"},
        "savedPercent": {"type": "number"},
        "netPackTokens": {"type": "integer", "minimum": 0}
      }
    },
    "packItem": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": {"$ref": "#/$defs/jsonValue"},
      "properties": {"id": {"type": "string"}}
    },
    "degradation": {
      "type": "object",
      "required": ["code", "severity", "message"],
      "additionalProperties": false,
      "properties": {
        "code": {"type": "string"},
        "severity": {"type": "string", "enum": ["info", "low", "warning", "medium", "high", "critical"]},
        "message": {"type": "string"},
        "repair": {"type": ["string", "null"]},
        "details": {"type": "object", "additionalProperties": {"$ref": "#/$defs/jsonValue"}}
      }
    },
    "jsonValue": {
      "oneOf": [
        {"type": "null"},
        {"type": "boolean"},
        {"type": "number"},
        {"type": "string"},
        {"type": "array", "items": {"$ref": "#/$defs/jsonValue"}},
        {"type": "object", "additionalProperties": {"$ref": "#/$defs/jsonValue"}}
      ]
    }
  }
}
