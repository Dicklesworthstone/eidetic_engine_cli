  ],
  "field_presets": {
    "minimal": ["schema", "attestationId", "workspace", "summary", "verdict"],
    "summary": ["schema", "attestationId", "workspace", "summary", "sourceAuthority", "verdict", "degraded"],
    "standard": ["schema", "attestationId", "workspace", "generatedAt", "redactionStatus", "summary", "sourceAuthority", "verdict", "evidenceRefs", "recoveryActions", "degraded"],
    "full": ["*"]
  },
  "x-ee-status": {
    "shipped": true,
    "available_in_build": true,
    "tracking_bead": "bd-20453.1",
    "notes": "Schema-first contract for the read-only environment attestation payload; runtime collection is intentionally separate follow-up work."
  },
  "x-ee-doc": "docs/environment_attestation.md"
}
