      },
      "sourceAuthority": [
        {
          "source": "installed_binary",
          "authority": "contradicted",
          "status": "stale",
          "freshness": "stale",
          "observedAt": "2026-06-04T20:05:00Z",
          "summary": "Installed binary command surface is older than source docs.",
          "evidenceRefs": ["schema://ee.swarm.work_packet.claim_gate.v1"],
