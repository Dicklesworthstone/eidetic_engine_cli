{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eidetic-engine/schemas/ee.swarm_slo.coordination_event.v1.json",
  "title": "ee.swarm_slo.coordination_event.v1",
  "description": "Redaction-safe coordination attribution event emitted by the Swarm SLO policy boundary. The event records source health, error and degraded counts, bounded repair hints, and redacted evidence without raw mail bodies, tracker payloads, command output, local paths, or secret-like values.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "producer",
    "sourceKind",
    "bucket",
    "posture",
    "elapsedMs",
    "eventCount",
    "errorCount",
    "degradedCount",
    "repairCommand",
    "evidence"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "ee.swarm_slo.coordination_event.v1"
    },
    "producer": {
      "$ref": "#/$defs/producerAttribution"
    },
    "sourceKind": {
      "$ref": "#/$defs/safeLabel"
    },
    "bucket": {
      "$ref": "#/$defs/attributionBucket"
    },
    "posture": {
      "$ref": "#/$defs/posture"
    },
    "elapsedMs": {
      "type": "integer",
      "minimum": 0
    },
    "eventCount": {
      "type": "integer",
      "minimum": 0
    },
    "errorCount": {
      "type": "integer",
      "minimum": 0
    },
    "degradedCount": {
      "type": "integer",
      "minimum": 0
    },
    "repairCommand": {
      "type": ["string", "null"]
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/redactedEvidence"
      }
    }
  },
  "field_presets": {
    "minimal": ["schema", "producer", "sourceKind", "posture"],
    "summary": [
      "schema",
      "producer",
      "sourceKind",
      "bucket",
      "posture",
      "eventCount",
      "errorCount",
      "degradedCount"
    ],
    "standard": [
      "schema",
      "producer",
      "sourceKind",
      "bucket",
      "posture",
      "elapsedMs",
      "eventCount",
      "errorCount",
      "degradedCount",
      "repairCommand",
      "evidence"
    ],
    "full": ["*"]
  },
  "examples": [
    {
      "schema": "ee.swarm_slo.coordination_event.v1",
      "producer": {
        "kind": "agent_name",
        "attributionKey": "agent_name:blake3:1111111111111111",
        "canonicalHash": "blake3:1111111111111111",
        "originalHash": "blake3:2222222222222222",
        "redacted": true
      },
      "sourceKind": "agent_mail",
      "bucket": "coordination",
      "posture": "unavailable",
      "elapsedMs": 0,
      "eventCount": 0,
      "errorCount": 1,
      "degradedCount": 1,
      "repairCommand": "am doctor check --verbose",
      "evidence": [
        {
          "field": "code",
          "code": "sqlite_malformed",
          "valueHash": "blake3:3333333333333333",
          "redacted": false,
          "redactionReasons": []
        }
      ]
    }
  ],
  "$defs": {
    "producerAttribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "attributionKey",
        "canonicalHash",
        "originalHash",
        "redacted"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "agent_pane",
            "agent_name",
            "harness",
            "human",
            "reflection_context",
            "workflow",
            "unknown"
          ]
        },
        "attributionKey": {
          "type": "string"
        },
        "canonicalHash": {
          "$ref": "#/$defs/shortBlake3Hash"
        },
        "originalHash": {
          "$ref": "#/$defs/shortBlake3Hash"
        },
        "redacted": {
          "type": "boolean"
        }
      }
    },
    "redactedEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "code",
        "valueHash",
        "redacted",
        "redactionReasons"
      ],
      "properties": {
        "field": {
          "$ref": "#/$defs/safeLabel"
        },
        "code": {
          "type": ["string", "null"]
        },
        "valueHash": {
          "$ref": "#/$defs/shortBlake3Hash"
        },
        "redacted": {
          "type": "boolean"
        },
        "redactionReasons": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "attributionBucket": {
      "type": "string",
      "enum": [
        "storage",
        "search",
        "graph",
        "pack",
        "output",
        "coordination",
        "rch",
        "tracker",
        "external_unavailable",
        "unknown_residual"
      ]
    },
    "posture": {
      "type": "string",
      "enum": ["ok", "degraded", "unavailable", "blocked", "unknown"]
    },
    "safeLabel": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]*$"
    },
    "shortBlake3Hash": {
      "type": "string",
      "pattern": "^blake3:[a-f0-9]{16}$"
    }
  }
}
