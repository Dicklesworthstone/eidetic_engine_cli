{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eidetic-engine/schemas/ee.rch.selector_admission_probe.v1.json",
  "title": "ee.rch.selector_admission_probe.v1",
  "description": "Read-only RCH selector/admission diagnostic block embedded in ee.rch.verify.v1 proofs. It classifies whether a remote-required Cargo-shaped verification command reached a concrete worker before Cargo could start, without allowing local Cargo fallback as proof.",
  "type": "object",
  "required": [
    "schema",
    "status",
    "required_runtime",
    "workers_reported",
    "daemon_workers_reported",
    "workers_reported_count",
    "daemon_workers_reported_count",
    "selected_worker",
    "selection_failure_reason",
    "workers_vs_selection_contradiction",
    "path_normalization_warning",
    "remote_required",
    "local_fallback_refused",
    "admission_blocker"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "const": "ee.rch.selector_admission_probe.v1"
    },
    "status": {
      "type": "string",
      "enum": [
        "selected",
        "selection_failed",
        "not_applicable"
      ]
    },
    "required_runtime": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "Rust",
        null
      ]
    },
    "workers_reported": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 64
    },
    "daemon_workers_reported": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 64
    },
    "workers_reported_count": {
      "type": "integer",
      "minimum": 0
    },
    "daemon_workers_reported_count": {
      "type": "integer",
      "minimum": 0
    },
    "selected_worker": {
      "type": [
        "string",
        "null"
      ]
    },
    "selection_failure_reason": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "no_workers_with_rust_installed",
            "no_workers_passed_health",
            "topology_blocked",
            "capacity_or_timeout",
            "all_workers_preflight_failed",
            "command_not_offloaded",
            "active_project_exclusion",
            "remote_marker_missing",
            "no_worker_selected"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "workers_vs_selection_contradiction": {
      "type": "boolean"
    },
    "path_normalization_warning": {
      "type": [
        "string",
        "null"
      ],
      "description": "Redacted RCH project-root, alias-root, or path-normalization warning line when observed."
    },
    "remote_required": {
      "type": "boolean"
    },
    "local_fallback_refused": {
      "type": "boolean"
    },
    "admission_blocker": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "retry_guidance",
            "evidence"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "active_project_exclusion"
              ]
            },
            "retry_guidance": {
              "type": "string",
              "enum": [
                "wait_for_active_build_or_coordinate_with_owner"
              ]
            },
            "evidence": {
              "type": "string",
              "minLength": 1,
              "maxLength": 320,
              "description": "One redacted, bounded transcript line describing why selector admission was blocked."
            },
            "active_build_id": {
              "type": "integer",
              "minimum": 0,
              "description": "RCH queue build id for the active same-project build that blocked selector admission, when queue evidence was available."
            },
            "active_project_exclusion_count": {
              "type": "integer",
              "minimum": 0,
              "description": "Count reported by the selector admission failure when RCH reports active_project_exclusion=N in a compact no-admissible-workers reason."
            },
            "active_command_preview": {
              "type": "string",
              "minLength": 1,
              "maxLength": 180,
              "description": "Redacted, bounded preview of the active build command."
            },
            "active_command_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$",
              "description": "Hash of the full active build command before preview truncation."
            },
            "worker_id": {
              "type": "string",
              "minLength": 1
            },
            "worker_posture": {
              "type": "string",
              "enum": [
                "active",
                "progress_stale",
                "heartbeat_stale",
                "hook_inactive"
              ]
            },
            "heartbeat_age_secs": {
              "type": "integer",
              "minimum": 0
            },
            "progress_age_secs": {
              "type": "integer",
              "minimum": 0
            },
            "build_age_secs": {
              "type": "integer",
              "minimum": 0
            },
            "slots_owned": {
              "type": "integer",
              "minimum": 0
            },
            "workers_healthy": {
              "type": "integer",
              "minimum": 0
            },
            "workers_total": {
              "type": "integer",
              "minimum": 0
            },
            "slots_available": {
              "type": "integer",
              "minimum": 0
            },
            "slots_total": {
              "type": "integer",
              "minimum": 0
            },
            "retry_after_hint": {
              "type": "string",
              "enum": [
                "after_active_build_completes"
              ]
            },
            "next_action": {
              "type": "string",
              "enum": [
                "wait_for_active_build_or_contact_owner_before_retry"
              ]
            },
            "owner_escalation": {
              "type": "string",
              "enum": [
                "identify_or_contact_active_build_owner_before_cancelling_or_retrying"
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "examples": [
    {
      "schema": "ee.rch.selector_admission_probe.v1",
      "status": "selection_failed",
      "required_runtime": "Rust",
      "workers_reported": [
        "vmi1227854",
        "vmi1264463"
      ],
      "daemon_workers_reported": [
        "vmi1227854"
      ],
      "workers_reported_count": 2,
      "daemon_workers_reported_count": 1,
      "selected_worker": null,
      "selection_failure_reason": "no_workers_with_rust_installed",
      "workers_vs_selection_contradiction": true,
      "path_normalization_warning": "[RCH] project root normalization warning: canonical /Users/<redacted>/projects/eidetic_engine_cli -> /data/projects/eidetic_engine_cli",
      "remote_required": true,
      "local_fallback_refused": true,
      "admission_blocker": null
    }
  ]
}
