{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eidetic-engine/schemas/ee.reflect.result.v1.json",
  "title": "ee.reflect.result.v1",
  "description": "External no-LLM reflection result artifact submitted back to ee for validation and curation candidate creation.",
  "type": "object",
  "required": [
    "schema",
    "requestId",
    "requestHash",
    "challenge",
    "producer",
    "reflectionKind",
    "citedSourceIds",
    "body",
    "kindFields",
    "selfReportedConfidence"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": { "type": "string", "const": "ee.reflect.result.v1" },
    "requestId": { "type": "string", "pattern": "^reflect_req_[0-9a-f]{16}$" },
    "requestHash": { "$ref": "#/$defs/blake3Hash" },
    "challenge": { "$ref": "#/$defs/challengeEcho" },
    "producer": { "$ref": "#/$defs/producer" },
    "reflectionKind": {
      "type": "string",
      "enum": [
        "summary",
        "insight",
        "gaps",
        "strengths",
        "question",
        "plan",
        "summary_insight_strengths",
        "plan_kinds",
        "procedural_extract",
        "contradiction_resolve"
      ]
    },
    "citedSourceIds": {
      "type": "array",
      "maxItems": 64,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 },
      "uniqueItems": true
    },
    "body": { "type": "string", "minLength": 1, "maxLength": 32768 },
    "kindFields": {
      "type": "object",
      "description": "Kind-specific structured fields. Gaps results must include knowledgeGaps; summary_insight_strengths should include summary, insights, or strengths; plan_kinds should include planKinds or steps. Procedural extraction and contradiction resolution use the strict conditional schemas below and create semantic advisory drafts only.",
      "maxProperties": 32,
      "properties": {
        "knowledgeGaps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "oneOf": [
              { "type": "string", "minLength": 1, "maxLength": 4096 },
              { "type": "object", "minProperties": 1, "maxProperties": 32 }
            ]
          }
        }
      },
      "additionalProperties": true
    },
    "selfReportedConfidence": {
      "type": "number",
      "description": "External producer estimate, never authority to apply or promote. Advisory procedure and conflict drafts retain this estimate in provenance but cap candidate and memory confidence at 0.5.",
      "minimum": 0,
      "maximum": 1
    }
  },
  "allOf": [
    {
      "if": { "properties": { "reflectionKind": { "const": "procedural_extract" } } },
      "then": { "properties": { "kindFields": { "$ref": "#/$defs/procedureDraft" } } }
    },
    {
      "if": { "properties": { "reflectionKind": { "const": "contradiction_resolve" } } },
      "then": { "properties": { "kindFields": { "$ref": "#/$defs/conflictDraft" } } }
    }
  ],
  "field_presets": {
    "minimal": ["schema", "requestId", "requestHash", "reflectionKind"],
    "summary": [
      "schema",
      "requestId",
      "requestHash",
      "reflectionKind",
      "citedSourceIds",
      "selfReportedConfidence"
    ],
    "standard": [
      "schema",
      "requestId",
      "requestHash",
      "challenge",
      "producer",
      "reflectionKind",
      "citedSourceIds",
      "body",
      "kindFields",
      "selfReportedConfidence"
    ],
    "full": ["*"]
  },
  "$defs": {
    "advisoryText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "description": "Nonblank text screened for secrets, prompt injection, and private reasoning. Runtime limits count UTF-8 bytes; the final body including all qualifiers is limited to 32768 bytes."
    },
    "advisoryTextList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/advisoryText" }
    },
    "advisorySourceIds": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 },
      "description": "Unique canonical source ids. Runtime validation binds every id to the cited source set and its request content hash."
    },
    "procedureDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceIds", "scope", "procedureDraft", "preconditions", "negativeExamples", "confidenceLimits"],
      "properties": {
        "sourceIds": {
          "$ref": "#/$defs/advisorySourceIds",
          "minItems": 1,
          "description": "Must account for exactly the citedSourceIds set. Different ids or hashes do not prove independent evidence."
        },
        "scope": { "$ref": "#/$defs/advisoryText" },
        "procedureDraft": {
          "$ref": "#/$defs/advisoryText",
          "description": "Concrete, testable guidance that passes the curation specificity validator. Single-source drafts cannot make universal always/never/unconditionally claims."
        },
        "preconditions": { "$ref": "#/$defs/advisoryTextList" },
        "negativeExamples": { "$ref": "#/$defs/advisoryTextList" },
        "confidenceLimits": { "$ref": "#/$defs/advisoryText" },
        "suggestedValidation": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/advisoryText" }
        },
        "singleSourceReason": {
          "$ref": "#/$defs/advisoryText",
          "description": "Required when cited sources contain fewer than two distinct content hashes, including duplicate rows. Explain why the single-source draft is useful and what evidence remains missing."
        }
      }
    },
    "conflictDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conflictingSourceIds", "resolutionMode", "resolutionDraft", "winningSourceIds", "confidenceLimits", "openQuestions", "staleWhen"],
      "properties": {
        "conflictingSourceIds": {
          "$ref": "#/$defs/advisorySourceIds",
          "minItems": 2,
          "description": "At least two cited ids with different source content hashes."
        },
        "resolutionMode": { "enum": ["prefer_source", "synthesize", "insufficient_evidence", "defer"] },
        "resolutionDraft": { "$ref": "#/$defs/advisoryText" },
        "winningSourceIds": {
          "$ref": "#/$defs/advisorySourceIds",
          "description": "For prefer_source, a nonempty proper subset of conflictingSourceIds. Empty for every other mode. This is an advisory interpretation and does not mutate the sources."
        },
        "confidenceLimits": { "$ref": "#/$defs/advisoryText" },
        "openQuestions": { "$ref": "#/$defs/advisoryTextList" },
        "staleWhen": { "$ref": "#/$defs/advisoryText" }
      },
      "allOf": [
        {
          "if": { "properties": { "resolutionMode": { "const": "prefer_source" } } },
          "then": { "properties": { "winningSourceIds": { "minItems": 1 } } },
          "else": { "properties": { "winningSourceIds": { "maxItems": 0 } } }
        }
      ]
    },
    "challengeEcho": {
      "type": "object",
      "required": ["keyId", "algorithm", "hmac"],
      "additionalProperties": false,
      "properties": {
        "keyId": { "type": "string", "minLength": 1 },
        "algorithm": { "type": "string", "const": "hmac-sha256" },
        "hmac": { "type": "string", "pattern": "^base64url:[A-Za-z0-9_-]{43}$" }
      }
    },
    "producer": {
      "type": "object",
      "required": ["kind", "id"],
      "maxProperties": 19,
      "additionalProperties": true,
      "properties": {
        "kind": { "type": "string", "minLength": 1, "maxLength": 512 },
        "id": { "type": "string", "minLength": 1, "maxLength": 512 },
        "version": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "blake3Hash": {
      "type": "string",
      "pattern": "^blake3:[0-9a-f]{64}$"
    }
  }
}
