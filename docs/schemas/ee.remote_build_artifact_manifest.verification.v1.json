{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eidetic-engine/schemas/ee.remote_build_artifact_manifest.verification.v1.json",
  "title": "ee.remote_build_artifact_manifest.verification.v1",
  "description": "Consumer-side verification result for an ee remote build artifact manifest and the exact downloaded packaged bytes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "accepted",
    "artifactName",
    "artifactId",
    "repository",
    "workflow",
    "runId",
    "runAttempt",
    "sourceCommit",
    "gitTree",
    "manifestHash",
    "buildCommandHash",
    "effectiveInputHash",
    "provenanceHash",
    "target",
    "profile",
    "binaryHash",
    "archiveHash",
    "archiveSizeBytes",
    "checksumStatus",
    "probeStatus",
    "probes",
    "rejections",
    "rawOutputIncluded",
    "verificationHash"
  ],
  "properties": {
    "schema": {"const": "ee.remote_build_artifact_manifest.verification.v1"},
    "status": {"enum": ["verified", "rejected"]},
    "accepted": {"type": "boolean"},
    "artifactName": {"type": ["string", "null"]},
    "artifactId": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[1-9][0-9]*$"}
      ]
    },
    "repository": {"type": ["string", "null"]},
    "workflow": {"type": ["string", "null"]},
    "runId": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[1-9][0-9]*$"}
      ]
    },
    "runAttempt": {"type": ["integer", "null"], "minimum": 1},
    "sourceCommit": {"$ref": "#/$defs/nullableGitObject"},
    "gitTree": {"$ref": "#/$defs/nullableGitObject"},
    "manifestHash": {"$ref": "#/$defs/nullableHash"},
    "buildCommandHash": {"$ref": "#/$defs/nullableHash"},
    "effectiveInputHash": {"$ref": "#/$defs/nullableHash"},
    "provenanceHash": {"$ref": "#/$defs/nullableHash"},
    "target": {"type": ["string", "null"]},
    "profile": {"type": ["string", "null"]},
    "binaryHash": {"$ref": "#/$defs/nullableHash"},
    "archiveHash": {"$ref": "#/$defs/nullableHash"},
    "archiveSizeBytes": {"type": ["integer", "null"], "minimum": 1},
    "checksumStatus": {"enum": ["verified", "missing", "mismatch"]},
    "probeStatus": {"enum": ["passed", "failed"]},
    "probes": {
      "type": "array",
      "maxItems": 16,
      "items": {"$ref": "#/$defs/probe"}
    },
    "rejections": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "rawOutputIncluded": {"const": false},
    "verificationHash": {"$ref": "#/$defs/hash"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "verified"}}},
      "then": {
        "properties": {
          "accepted": {"const": true},
          "artifactName": {"type": "string", "minLength": 1},
          "artifactId": {"type": "string", "pattern": "^[1-9][0-9]*$"},
          "repository": {"type": "string", "minLength": 1},
          "workflow": {"type": "string", "minLength": 1},
          "runId": {"type": "string", "pattern": "^[1-9][0-9]*$"},
          "runAttempt": {"type": "integer", "minimum": 1},
          "sourceCommit": {"$ref": "#/$defs/gitObject"},
          "gitTree": {"$ref": "#/$defs/gitObject"},
          "manifestHash": {"$ref": "#/$defs/hash"},
          "buildCommandHash": {"$ref": "#/$defs/hash"},
          "effectiveInputHash": {"$ref": "#/$defs/hash"},
          "provenanceHash": {"$ref": "#/$defs/hash"},
          "target": {"type": "string", "minLength": 1},
          "profile": {"type": "string", "minLength": 1},
          "binaryHash": {"$ref": "#/$defs/hash"},
          "archiveHash": {"$ref": "#/$defs/hash"},
          "archiveSizeBytes": {"type": "integer", "minimum": 1},
          "checksumStatus": {"const": "verified"},
          "probeStatus": {"const": "passed"},
          "probes": {
            "type": "array",
            "minItems": 2,
            "maxItems": 16,
            "items": {"$ref": "#/$defs/verifiedProbe"},
            "allOf": [
              {
                "contains": {"$ref": "#/$defs/versionProbe"},
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {"$ref": "#/$defs/environmentAttestationHelpProbe"},
                "minContains": 1,
                "maxContains": 1
              }
            ]
          },
          "rejections": {"maxItems": 0}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "rejected"}}},
      "then": {"properties": {"accepted": {"const": false}}}
    }
  ],
  "$defs": {
    "gitObject": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "nullableGitObject": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/gitObject"}]
    },
    "nullableHash": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/hash"}]
    },
    "assertionValue": {"type": ["string", "boolean", "null"]},
    "semanticAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "expected", "observed", "matched"],
      "properties": {
        "path": {"type": "string", "pattern": "^/"},
        "expected": {"$ref": "#/$defs/assertionValue"},
        "observed": {"$ref": "#/$defs/assertionValue"},
        "matched": {"type": "boolean"}
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "argvHash",
        "exitCode",
        "stdoutHash",
        "stderrHash",
        "status",
        "semanticAssertions"
      ],
      "properties": {
        "id": {"type": ["string", "null"]},
        "argvHash": {"$ref": "#/$defs/nullableHash"},
        "exitCode": {"type": ["integer", "null"]},
        "stdoutHash": {"$ref": "#/$defs/nullableHash"},
        "stderrHash": {"$ref": "#/$defs/nullableHash"},
        "status": {"enum": ["passed", "failed", null]},
        "semanticAssertions": {
          "type": "array",
          "items": {"$ref": "#/$defs/semanticAssertion"}
        }
      }
    },
    "verifiedProbe": {
      "allOf": [
        {"$ref": "#/$defs/probe"},
        {
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "argvHash": {"$ref": "#/$defs/hash"},
            "exitCode": {"const": 0},
            "stdoutHash": {"$ref": "#/$defs/hash"},
            "stderrHash": {"$ref": "#/$defs/hash"},
            "status": {"const": "passed"},
            "semanticAssertions": {
              "type": "array",
              "items": {
                "allOf": [
                  {"$ref": "#/$defs/semanticAssertion"},
                  {"properties": {"matched": {"const": true}}}
                ]
              }
            }
          }
        }
      ]
    },
    "versionProbe": {
      "allOf": [
        {"$ref": "#/$defs/verifiedProbe"},
        {
          "properties": {
            "id": {"const": "version_json"},
            "argvHash": {
              "const": "sha256:4af47b5e027e1686b124d8c7f986fe44a60b0b8a73c9cf1a32a8d8a592b39b48"
            },
            "semanticAssertions": {"minItems": 10}
          }
        }
      ]
    },
    "environmentAttestationHelpProbe": {
      "allOf": [
        {"$ref": "#/$defs/verifiedProbe"},
        {
          "properties": {
            "id": {"const": "environment_attestation_help"},
            "argvHash": {
              "const": "sha256:37fa79e205cce2dafd8ac4da2075f73f74ed03beeca38cc6d741fcf54be21558"
            },
            "semanticAssertions": {"maxItems": 0}
          }
        }
      ]
    }
  }
}
