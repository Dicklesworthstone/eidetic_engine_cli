              "conclusion": null,
              "createdAt": "2026-06-05T09:16:05Z",
              "updatedAt": "2026-06-05T09:16:05Z",
              "completedAt": null,
              "sourceFreshness": "current",
              "artifactFreshness": "unknown",
              "artifacts": [],
              "firstFailureDiagnosis": null
            }
          ]
        }
      ],
      "activeRecommendation": {
        "verdict": "wait_for_active_run",
        "workflowName": "macOS EE Artifact",
        "runId": "27006448051",
        "nextAction": "wait",
        "rationale": "Active run for the current head SHA exists; do not dispatch a duplicate run."
      },
      "recoveryActions": [
        {
          "priority": 0,
          "kind": "wait",
          "command": "gh run view 27006448051 --json status,conclusion,jobs",
