{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ee.search.family.v1",
  "title": "ee.search.family.v1",
  "description": "Queryless, workspace-scoped attempt-family retrieval payload emitted under data by ee search --family.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "workspaceId",
    "familyAlias",
    "declaredSize",
    "origin",
    "recordedSlots",
    "selectedCount",
    "rejectedCount",
    "unslottedCount",
    "duplicateMemberCount",
    "unrecordedCount",
    "discountFactor",
    "survivorOnly",
    "promotionEligible",
    "promotionPosture",
    "promotionReason",
    "postureSummary",
    "memoryScope",
    "strictScope",
    "scopeFilteredCount",
    "missingCurrentRevisionCount",
    "members"
  ],
  "properties": {
    "schema": { "const": "ee.search.family.v1" },
    "workspaceId": { "type": "string", "minLength": 1 },
    "familyAlias": {
      "type": "string",
      "pattern": "^afm_[0-9a-f]{32}$"
    },
    "declaredSize": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 1000000
    },
    "origin": { "type": ["string", "null"] },
    "recordedSlots": { "type": "integer", "minimum": 0, "maximum": 1000000 },
    "selectedCount": { "type": "integer", "minimum": 0, "maximum": 1000000 },
    "rejectedCount": { "type": "integer", "minimum": 0, "maximum": 1000000 },
    "unslottedCount": { "type": "integer", "minimum": 0, "maximum": 1000000 },
    "duplicateMemberCount": { "type": "integer", "minimum": 0, "maximum": 1000000 },
    "unrecordedCount": { "type": "integer", "minimum": 0, "maximum": 1000000 },
    "discountFactor": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "survivorOnly": { "type": "boolean" },
    "promotionEligible": { "type": "boolean" },
    "promotionPosture": {
      "type": "string",
      "enum": [
        "eligible",
        "blocked_undeclared",
        "blocked_invalid_declared_size",
        "blocked_duplicate_slots",
        "blocked_duplicate_members",
        "blocked_multiple_families",
        "blocked_overfull",
        "blocked_out_of_range_slots",
        "blocked_unslotted_members",
        "blocked_incomplete",
        "blocked_invalid_composition"
      ]
    },
    "promotionReason": { "type": "string", "minLength": 1 },
    "postureSummary": { "type": "string", "minLength": 1 },
    "memoryScope": {
      "type": "string",
      "enum": ["self", "team", "global", "workspace", "verified", "swarm"]
    },
    "strictScope": { "type": "boolean" },
    "scopeFilteredCount": { "type": "integer", "minimum": 0, "maximum": 1000000 },
    "missingCurrentRevisionCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "members": {
      "type": "array",
      "items": { "$ref": "#/$defs/member" }
    }
  },
  "$defs": {
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memoryId",
        "logicalId",
        "attemptIndex",
        "disposition",
        "discountFactor",
        "promotionPosture",
        "promotionReason",
        "membershipFamilyAliases",
        "kind",
        "level",
        "trustClass",
        "content",
        "contentRedacted",
        "provenanceUri",
        "provenanceRedacted",
        "createdAt"
      ],
      "properties": {
        "memoryId": { "type": "string", "minLength": 1 },
        "logicalId": { "type": "string", "minLength": 1 },
        "attemptIndex": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 1000000
        },
        "disposition": {
          "type": ["string", "null"],
          "enum": ["selected", "rejected", null]
        },
        "discountFactor": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "promotionPosture": { "$ref": "#/$defs/promotionPosture" },
        "promotionReason": { "type": "string", "minLength": 1 },
        "membershipFamilyAliases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^afm_[0-9a-f]{32}$" }
        },
        "kind": { "type": "string", "minLength": 1 },
        "level": { "type": "string", "minLength": 1 },
        "trustClass": { "type": "string", "minLength": 1 },
        "content": { "type": "string" },
        "contentRedacted": { "type": "boolean" },
        "provenanceUri": { "type": ["string", "null"] },
        "provenanceRedacted": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "promotionPosture": {
      "type": "string",
      "enum": [
        "eligible",
        "blocked_undeclared",
        "blocked_invalid_declared_size",
        "blocked_duplicate_slots",
        "blocked_duplicate_members",
        "blocked_multiple_families",
        "blocked_overfull",
        "blocked_out_of_range_slots",
        "blocked_unslotted_members",
        "blocked_incomplete",
        "blocked_invalid_composition"
      ]
    }
  }
}
