{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eidetic-engine/schemas/ee.decide.record.v1.json",
  "title": "ee.decide.record.v1",
  "description": "Data payload emitted by ee decide record under the standard ee.response.v2 envelope.",
  "type": "object",
  "required": [
    "schema",
    "version",
    "status",
    "dryRun",
    "persisted",
    "workspaceId",
    "databasePath",
    "decision",
    "superseded",
    "memoryAuditId",
    "memoryIndexJobId",
    "linkAuditId",
    "expireAuditId"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {"type": "string", "const": "ee.decide.record.v1"},
    "version": {"type": "string"},
    "status": {"type": "string", "enum": ["recorded", "would_record"]},
    "dryRun": {"type": "boolean"},
    "persisted": {"type": "boolean"},
    "workspaceId": {"type": "string"},
    "databasePath": {"type": "string"},
    "decision": {"$ref": "#/$defs/decisionItem"},
    "superseded": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/decisionRef"}
      ]
    },
    "memoryAuditId": {"type": ["string", "null"]},
    "memoryIndexJobId": {"type": ["string", "null"]},
    "linkAuditId": {"type": ["string", "null"]},
    "expireAuditId": {"type": ["string", "null"]},
    "subscribe": {"$ref": "#/$defs/subscribe"}
  },
  "field_presets": {
    "minimal": ["schema", "version", "status", "dryRun", "persisted"],
    "summary": [
      "schema",
      "version",
      "status",
      "dryRun",
      "persisted",
      "workspaceId",
      "decision",
      "superseded"
    ],
    "standard": [
      "schema",
      "version",
      "status",
      "dryRun",
      "persisted",
      "workspaceId",
      "databasePath",
      "decision",
      "superseded",
      "memoryAuditId",
      "memoryIndexJobId",
      "linkAuditId",
      "expireAuditId",
      "subscribe"
    ],
    "full": ["*"]
  },
  "$defs": {
    "decisionItem": {
      "type": "object",
      "required": [
        "memoryId",
        "topic",
        "normalizedTopic",
        "chosen",
        "alternatives",
        "options",
        "rationale",
        "supersedes",
        "chainDepth",
        "revisitBy",
        "revisitStatus",
        "superseded",
        "validTo",
        "createdAt"
      ],
      "additionalProperties": false,
      "properties": {
        "memoryId": {"type": "string"},
        "topic": {"type": "string"},
        "normalizedTopic": {"type": "string"},
        "chosen": {"type": "string"},
        "alternatives": {"type": "array", "items": {"type": "string"}},
        "options": {"type": "array", "items": {"type": "string"}},
        "rationale": {"type": "string"},
        "supersedes": {"type": ["string", "null"]},
        "chainDepth": {"type": "integer", "minimum": 0},
        "revisitBy": {"type": ["string", "null"], "format": "date-time"},
        "revisitStatus": {"$ref": "#/$defs/revisitStatus"},
        "superseded": {"type": "boolean"},
        "validTo": {"type": ["string", "null"], "format": "date-time"},
        "createdAt": {"type": "string", "format": "date-time"}
      }
    },
    "decisionRef": {
      "type": "object",
      "required": ["memoryId", "validTo", "status"],
      "additionalProperties": false,
      "properties": {
        "memoryId": {"type": "string"},
        "validTo": {"type": ["string", "null"], "format": "date-time"},
        "status": {"type": "string"}
      }
    },
    "revisitStatus": {
      "type": "string",
      "enum": ["none", "future", "near_due", "due", "overdue"]
    },
    "subscribe": {
      "type": "object",
      "required": ["schema", "filter", "pollCommand", "streamCommand"],
      "additionalProperties": false,
      "properties": {
        "schema": {"type": "string", "const": "ee.decide.subscribe.v1"},
        "filter": {"type": "string"},
        "pollCommand": {"type": "string"},
        "streamCommand": {"type": "string"}
      }
    }
  }
}
