{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eidetic-engine/schemas/ee.audit.diff.v1.json",
  "title": "ee.audit.diff.v1",
  "description": "Read-only audit changes in an inclusive RFC 3339 timestamp window. row_count counts the entire result, while the output governor may page entries[] and report its continuation cursor in degraded[]. An unsatisfiable output budget emits only the data.schema identifier and an explicit output_budget_unsatisfiable degradation.",
  "type": "object",
  "required": ["schema", "success", "data", "degraded"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "ee.response.v2" },
    "success": { "const": true },
    "fields": { "type": "string" },
    "meta": {
      "type": "object",
      "required": ["tokensEstimated"],
      "additionalProperties": false,
      "properties": {
        "tokensEstimated": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 }
      }
    },
    "degraded": { "type": "array", "items": { "$ref": "#/$defs/degradation" } },
    "data": {
      "type": "object",
      "required": ["schema"],
      "additionalProperties": false,
      "properties": {
        "schema": { "const": "ee.audit.diff.v1" },
        "from": { "type": "string", "format": "date-time" },
        "to": { "type": "string", "format": "date-time" },
        "entries": { "type": "array", "items": { "$ref": "#/$defs/auditEntry" } },
        "row_count": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
      }
    }
  },
  "oneOf": [
    { "properties": { "data": { "required": ["from", "to", "entries", "row_count"] } } },
    {
      "required": ["meta"],
      "properties": {
        "data": { "maxProperties": 1 },
        "degraded": {
          "contains": {
            "required": ["code", "severity"],
            "properties": {
              "code": { "const": "output_budget_unsatisfiable" },
              "severity": { "const": "medium" }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "auditEntry": {
      "type": "object",
      "required": [
        "id",
        "timestamp",
        "actor",
        "surface",
        "mutation_kind",
        "before_hash",
        "after_hash",
        "prev_row_hash",
        "this_row_hash",
        "workspace_id",
        "target_type",
        "target_id",
        "producer",
        "details"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "actor": { "type": ["string", "null"] },
        "surface": { "type": "string" },
        "mutation_kind": { "type": "string" },
        "before_hash": { "type": ["string", "null"] },
        "after_hash": { "type": ["string", "null"] },
        "prev_row_hash": { "type": ["string", "null"] },
        "this_row_hash": { "type": ["string", "null"] },
        "workspace_id": { "type": ["string", "null"] },
        "shard_id": { "type": "string" },
        "target_type": { "type": ["string", "null"] },
        "target_id": { "type": ["string", "null"] },
        "producer": { "$ref": "#/$defs/producer" },
        "details": { "$ref": "#/$defs/jsonValue" }
      }
    },
    "producer": {
      "type": "object",
      "required": ["schema", "sourceSystem", "identity", "run", "observedAt"],
      "additionalProperties": false,
      "properties": {
        "schema": { "const": "ee.producer.metadata.v1" },
        "sourceSystem": {
          "enum": [
            "cli",
            "cass",
            "audit",
            "agent_mail",
            "recorder",
            "curation",
            "verification",
            "coordination_fallback",
            "unknown"
          ]
        },
        "identity": {
          "type": "object",
          "required": ["status", "agentName", "harness", "model"],
          "additionalProperties": false,
          "properties": {
            "status": { "enum": ["known", "unknown", "unobserved"] },
            "agentName": { "type": ["string", "null"] },
            "harness": { "type": ["string", "null"] },
            "model": { "type": ["string", "null"] }
          }
        },
        "run": {
          "type": "object",
          "required": ["runId", "sessionId", "workspaceFingerprint"],
          "additionalProperties": false,
          "properties": {
            "runId": { "type": ["string", "null"] },
            "sessionId": { "type": ["string", "null"] },
            "workspaceFingerprint": { "type": ["string", "null"] }
          }
        },
        "observedAt": { "type": ["string", "null"] }
      }
    },
    "degradation": {
      "type": "object",
      "required": ["code", "severity", "message"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string" },
        "severity": { "enum": ["info", "low", "warning", "medium", "high", "critical"] },
        "message": { "type": "string" },
        "repair": { "type": "string" },
        "repairKind": { "enum": ["actionable", "template", "placeholder", "unknown", "empty"] },
        "sources": { "type": "array", "items": { "type": "string" } },
        "details": { "type": "object", "additionalProperties": { "$ref": "#/$defs/jsonValue" } }
      }
    },
    "jsonValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        { "type": "array", "items": { "$ref": "#/$defs/jsonValue" } },
        { "type": "object", "additionalProperties": { "$ref": "#/$defs/jsonValue" } }
      ]
    }
  }
}
