        "ioWriteBytes": 4096
      },
      "firstFailure": null,
      "verification": {
        "rchRequired": true,
        "rchStatus": "passed",
        "proofCapsule": {
          "schema": "ee.swarm_replay.verification_capsule.v1",
          "proofLevel": "remote_verified",
          "staticChecks": [
            {
              "name": "workload_hash",
              "status": "passed",
              "evidence": "blake3:5555555555555555555555555555555555555555555555555555555555555555"
            }
          ],
          "rch": {
            "sourceSchema": "ee.rch.verify.v1",
            "status": "remote_pass",
            "commandHash": "sha256:1111111111111111111111111111111111111111111111111111111111111111",
            "commandKind": "cargo_test",
            "workerId": "vmi1227854",
            "remoteMarkerPresent": true,
            "cargoStarted": true,
            "localFallbackRefused": false,
            "localFallbackDetected": false,
            "localCargoProcessCount": 0,
            "degradedCodes": [],
            "selectorAdmission": {
              "status": "selected",
              "requiredRuntime": "Rust",
              "selectedWorker": "vmi1227854",
              "selectionFailureReason": null,
              "workersVsSelectionContradiction": false,
              "pathNormalizationWarning": null,
              "remoteRequired": true,
              "localFallbackRefused": false
            },
            "knownBlocker": null,
            "rawOutputIncluded": false,
            "localPathsRedacted": true
          }
        },
        "deterministic": true,
        "workloadHash": "blake3:5555555555555555555555555555555555555555555555555555555555555555",
        "replayHash": "blake3:6666666666666666666666666666666666666666666666666666666666666666",
        "volatileFieldsStripped": ["elapsedMs"]
      },
      "warnings": []
    }
  ],
  "$defs": {
    "workloadId": {
      "type": "string",
      "pattern": "^swarmwl_[A-Fa-f0-9]{16,64}$"
    },
    "blake3Hash": {
      "type": "string",
      "pattern": "^blake3:[A-Fa-f0-9]{16,128}$"
    },
    "verificationCommandHash": {
      "type": "string",
      "pattern": "^((blake3|sha256):)?[A-Fa-f0-9]{16,128}$"
    },
    "stepId": {
      "type": "string",
      "pattern": "^step_[A-Za-z0-9_.-]{3,64}$"
    },
    "degradedCode": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "hostProfileAdmission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declaredProfile",
        "requestedParallelAgents",
        "requiredClass",
        "observedClass",
        "status",
        "logicalCpuCount",
        "availableMemoryMb",
        "targetDirPosture",
        "tmpdirPosture",
        "rchAvailable",
        "numaAvailable",
        "lexicalRamTierAvailable",
        "pathTailHashes",
        "degradedCodes",
        "refusalReasons"
      ],
      "properties": {
        "declaredProfile": {
          "description": "Redaction-safe declared workload profile label, never a raw host path or environment dump.",
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,80}$"
        },
        "requestedParallelAgents": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1024
        },
        "requiredClass": {
          "$ref": "#/$defs/hostProfileClass"
        },
        "observedClass": {
          "$ref": "#/$defs/hostProfileClass"
        },
        "status": {
          "type": "string",
          "enum": ["admitted", "degraded", "refused"]
        },
        "logicalCpuCount": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 4096
        },
        "availableMemoryMb": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "targetDirPosture": {
          "$ref": "#/$defs/hostPathPosture"
        },
        "tmpdirPosture": {
          "$ref": "#/$defs/hostPathPosture"
        },
        "rchAvailable": {
          "type": ["boolean", "null"]
        },
        "numaAvailable": {
          "type": ["boolean", "null"]
        },
        "lexicalRamTierAvailable": {
          "type": ["boolean", "null"]
        },
        "pathTailHashes": {
          "description": "Optional hashes for scratch path tails when a runner must correlate paths. Raw absolute paths are never valid here.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/blake3Hash"
          }
        },
        "degradedCodes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/degradedCode"
          }
        },
        "refusalReasons": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "maxLength": 120
          }
        }
      }
    },
    "hostProfileClass": {
      "type": "string",
      "enum": ["smoke", "standard", "large-host"]
    },
    "hostPathPosture": {
      "type": "string",
      "enum": ["external", "local", "unknown"]
    },
    "commandResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stepId",
        "agentSlot",
        "commandHash",
        "exitCode",
        "elapsedMs",
        "stdoutBytes",
        "stderrBytes",
        "degradedCodes",
        "artifactPaths",
        "redactionStatus",
        "slo"
      ],
      "properties": {
        "stepId": {
          "$ref": "#/$defs/stepId"
        },
        "agentSlot": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1023
        },
        "commandHash": {
          "$ref": "#/$defs/blake3Hash"
        },
        "exitCode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "elapsedMs": {
          "description": "Normalized elapsed duration in milliseconds. This is the only time-like per-command field in the ledger.",
          "type": "integer",
          "minimum": 0
        },
        "stdoutBytes": {
          "type": "integer",
          "minimum": 0
        },
        "stderrBytes": {
          "type": "integer",
          "minimum": 0
        },
        "degradedCodes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/degradedCode"
          }
        },
        "artifactPaths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifactRef"
          }
        },
        "redactionStatus": {
          "type": "string",
          "enum": ["clean", "redacted", "probe_failed"]
        },
        "slo": {
          "$ref": "#/$defs/commandSlo"
        },
        "memoryRssBytes": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "cpuMs": {
          "type": ["integer", "null"],
          "minimum": 0
        }
      }
    },
    "commandSlo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "status",
        "budget",
        "latencyStatus",
        "stdoutStatus",
        "stderrStatus",
        "degradedCountStatus",
        "discoverabilityStatus",
        "warningDimensions",
        "failedDimensions",
        "diagnosis",
        "exemptionRationale"
      ],
      "properties": {
        "class": {
          "type": "string",
          "enum": ["interactive_agent", "diagnostic", "heavy_lab"]
        },
        "status": {
          "$ref": "#/$defs/sloStatus"
        },
        "budget": {
          "$ref": "#/$defs/sloBudget"
        },
        "latencyStatus": {
          "$ref": "#/$defs/sloStatus"
        },
        "stdoutStatus": {
          "$ref": "#/$defs/sloStatus"
        },
        "stderrStatus": {
          "$ref": "#/$defs/sloStatus"
        },
        "degradedCountStatus": {
          "$ref": "#/$defs/sloStatus"
        },
        "discoverabilityStatus": {
          "$ref": "#/$defs/sloStatus"
        },
        "warningDimensions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sloDimension"
          }
        },
        "failedDimensions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sloDimension"
          }
        },
        "diagnosis": {
          "type": ["string", "null"],
          "maxLength": 240
        },
        "exemptionRationale": {
          "type": ["string", "null"],
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "maxLength": 120
        }
      }
    },
    "sloStatus": {
      "type": "string",
      "enum": ["pass", "warn", "fail", "exempt"]
    },
    "sloDimension": {
      "type": "string",
      "enum": [
        "latency",
        "stdout_bytes",
        "stderr_bytes",
        "degraded_count",
        "discoverability"
      ]
    },
    "sloBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latencyWarningMs",
        "latencyFailureMs",
        "stdoutWarningBytes",
        "stdoutFailureBytes",
        "stderrWarningBytes",
        "stderrFailureBytes",
        "degradedWarningCount",
        "degradedFailureCount"
      ],
      "properties": {
        "latencyWarningMs": {
          "type": "integer",
          "minimum": 0
        },
        "latencyFailureMs": {
          "type": "integer",
          "minimum": 0
        },
        "stdoutWarningBytes": {
          "type": "integer",
          "minimum": 0
        },
        "stdoutFailureBytes": {
          "type": "integer",
          "minimum": 0
        },
        "stderrWarningBytes": {
          "type": "integer",
          "minimum": 0
        },
        "stderrFailureBytes": {
          "type": "integer",
          "minimum": 0
        },
        "degradedWarningCount": {
          "type": "integer",
          "minimum": 0
        },
        "degradedFailureCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "pathTail", "pathHash"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["json", "jsonl", "markdown", "log", "support_bundle", "other"]
        },
        "pathTail": {
          "description": "Relative fixture path tail or redacted path token. Absolute host paths are not valid artifact references.",
          "type": "string",
          "not": {
            "anyOf": [
              { "pattern": "^/" },
              { "pattern": "^[A-Za-z]:" }
            ]
          },
          "pattern": "^[A-Za-z0-9._/-]{1,160}$"
        },
        "pathHash": {
          "$ref": "#/$defs/blake3Hash"
        }
      }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commandCount",
        "successCount",
        "failureCount",
        "degradedCount",
        "sloPassCount",
        "sloWarningCount",
        "sloFailureCount",
        "sloExemptCount",
        "firstSloFailureStepId",
        "elapsedMsTotal",
        "p50Ms",
        "p95Ms",
        "p99Ms"
      ],
      "properties": {
        "commandCount": {
          "type": "integer",
          "minimum": 0
        },
        "successCount": {
          "type": "integer",
          "minimum": 0
        },
        "failureCount": {
          "type": "integer",
          "minimum": 0
        },
        "degradedCount": {
          "type": "integer",
          "minimum": 0
        },
        "sloPassCount": {
          "type": "integer",
          "minimum": 0
        },
        "sloWarningCount": {
          "type": "integer",
          "minimum": 0
        },
        "sloFailureCount": {
          "type": "integer",
          "minimum": 0
        },
        "sloExemptCount": {
          "type": "integer",
          "minimum": 0
        },
        "firstSloFailureStepId": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/stepId"
            }
          ]
        },
        "elapsedMsTotal": {
          "type": "integer",
          "minimum": 0
        },
        "p50Ms": {
          "type": "integer",
          "minimum": 0
        },
        "p95Ms": {
          "type": "integer",
          "minimum": 0
        },
        "p99Ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "redactionStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rawTaskStringPresent",
        "rawQueryTextPresent",
        "rawMemoryBodyPresent",
        "rawMailBodyPresent",
        "absoluteHostPathPresent",
        "secretsPresent",
        "environmentDumpPresent",
        "fullFileListingPresent",
        "redactionProbesPassed"
      ],
      "properties": {
        "rawTaskStringPresent": {
          "type": "boolean",
          "const": false
        },
        "rawQueryTextPresent": {
          "type": "boolean",
          "const": false
        },
        "rawMemoryBodyPresent": {
          "type": "boolean",
          "const": false
        },
        "rawMailBodyPresent": {
          "type": "boolean",
          "const": false
        },
        "absoluteHostPathPresent": {
          "type": "boolean",
          "const": false
        },
        "secretsPresent": {
          "type": "boolean",
          "const": false
        },
        "environmentDumpPresent": {
          "type": "boolean",
          "const": false
        },
        "fullFileListingPresent": {
          "type": "boolean",
          "const": false
        },
        "redactionProbesPassed": {
          "type": "boolean"
        }
      }
    },
    "resourceUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "peakRssBytes",
        "maxCommandRssBytes",
        "totalCpuMs",
        "ioReadBytes",
        "ioWriteBytes"
      ],
      "properties": {
        "peakRssBytes": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "maxCommandRssBytes": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "totalCpuMs": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "ioReadBytes": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "ioWriteBytes": {
          "type": ["integer", "null"],
          "minimum": 0
        }
      }
    },
    "firstFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stepId", "agentSlot", "code", "severity", "diagnosis"],
      "properties": {
        "stepId": {
          "$ref": "#/$defs/stepId"
        },
        "agentSlot": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1023
        },
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "severity": {
          "type": "string",
          "enum": ["info", "low", "warning", "medium", "high", "critical"]
        },
        "diagnosis": {
          "type": "string",
          "maxLength": 240
        },
        "repairHint": {
          "type": ["string", "null"],
          "maxLength": 240
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rchRequired",
        "rchStatus",
        "proofCapsule",
        "deterministic",
        "workloadHash",
        "replayHash",
        "volatileFieldsStripped"
      ],
      "properties": {
        "rchRequired": {
          "type": "boolean"
        },
        "rchStatus": {
          "type": "string",
          "enum": [
            "not_required",
            "passed",
            "blocked_before_cargo",
            "failed"
          ]
        },
        "proofCapsule": {
          "$ref": "#/$defs/verificationCapsule"
        },
        "deterministic": {
          "type": "boolean"
        },
        "workloadHash": {
          "$ref": "#/$defs/blake3Hash"
        },
        "replayHash": {
          "$ref": "#/$defs/blake3Hash"
        },
        "volatileFieldsStripped": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["elapsedMs", "cpuMs", "memoryRssBytes", "ioReadBytes", "ioWriteBytes"]
          }
        }
      }
    },
    "verificationCapsule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "proofLevel", "staticChecks", "rch"],
      "properties": {
        "schema": {
          "type": "string",
          "const": "ee.swarm_replay.verification_capsule.v1"
        },
        "proofLevel": {
          "type": "string",
          "enum": [
            "static_replay_only",
            "remote_verified",
            "rch_blocked",
            "remote_failed",
            "local_cargo_contaminated"
          ]
        },
        "staticChecks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/staticCheck"
          }
        },
        "rch": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/rchProofSummary"
            }
          ]
        }
      }
    },
    "staticCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "evidence"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,80}$"
        },
        "status": {
          "type": "string",
          "enum": ["passed", "degraded", "failed"]
        },
        "evidence": {
          "type": "string",
          "maxLength": 160
        }
      }
    },
    "rchProofSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceSchema",
        "status",
        "commandHash",
        "commandKind",
        "workerId",
        "remoteMarkerPresent",
        "cargoStarted",
        "localFallbackRefused",
        "localFallbackDetected",
        "localCargoProcessCount",
        "degradedCodes",
        "selectorAdmission",
        "knownBlocker",
        "rawOutputIncluded",
        "localPathsRedacted"
      ],
      "properties": {
        "sourceSchema": {
          "type": "string",
          "const": "ee.rch.verify.v1"
        },
        "status": {
          "type": "string",
          "maxLength": 80
        },
        "commandHash": {
          "$ref": "#/$defs/verificationCommandHash"
        },
        "commandKind": {
          "type": ["string", "null"],
          "pattern": "^[a-z][a-z0-9_]{1,80}$"
        },
        "workerId": {
          "type": ["string", "null"],
          "pattern": "^[A-Za-z0-9._-]{1,80}$"
        },
        "remoteMarkerPresent": {
          "type": "boolean"
        },
        "cargoStarted": {
          "type": ["boolean", "null"]
        },
        "localFallbackRefused": {
          "type": "boolean"
        },
        "localFallbackDetected": {
          "type": "boolean"
        },
        "localCargoProcessCount": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "degradedCodes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/degradedCode"
          }
        },
        "selectorAdmission": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/rchSelectorAdmission"
            }
          ]
        },
        "knownBlocker": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/knownBlocker"
            }
          ]
        },
        "rawOutputIncluded": {
          "type": "boolean",
          "const": false
        },
        "localPathsRedacted": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "rchSelectorAdmission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "requiredRuntime",
        "selectedWorker",
        "selectionFailureReason",
        "workersVsSelectionContradiction",
        "pathNormalizationWarning",
        "remoteRequired",
        "localFallbackRefused"
      ],
      "properties": {
        "status": {
          "type": ["string", "null"],
          "maxLength": 80
        },
        "requiredRuntime": {
          "type": ["string", "null"],
          "maxLength": 80
        },
        "selectedWorker": {
          "type": ["string", "null"],
          "maxLength": 80
        },
        "selectionFailureReason": {
          "type": ["string", "null"],
          "maxLength": 120
        },
        "workersVsSelectionContradiction": {
          "type": "boolean"
        },
        "pathNormalizationWarning": {
          "type": ["string", "null"],
          "maxLength": 240
        },
        "remoteRequired": {
          "type": "boolean"
        },
        "localFallbackRefused": {
          "type": "boolean"
        }
      }
    },
    "knownBlocker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blockerFingerprint",
        "blockerKind",
        "remediationBead",
        "retryAfter"
      ],
      "properties": {
        "blockerFingerprint": {
          "type": "string",
          "pattern": "^sha256:[A-Fa-f0-9]{64}$"
        },
        "blockerKind": {
          "type": ["string", "null"],
          "maxLength": 120
        },
        "remediationBead": {
          "type": ["string", "null"],
          "pattern": "^bd-[A-Za-z0-9_.-]+$"
        },
        "retryAfter": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      }
    }
  }
}
