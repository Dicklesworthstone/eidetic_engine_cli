{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eidetic-engine/schemas/ee.swarm_replay_result.v1.json",
  "title": "ee.swarm_replay_result.v1",
  "description": "Compact deterministic result ledger for a multi-agent swarm workload replay. It records host-profile admission, per-command latency, stdout/stderr byte counts, degraded codes, exit code, redaction status, agent-facing SLO budget classifications, optional resource measurements, command hashes, redacted artifact references, first-failure diagnosis, and verification posture with optional proof capsules. It does not carry raw task strings, raw query text, memory bodies, mail bodies, command output, secrets, environment dumps, full file listings, or absolute host paths.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "workloadId",
    "runId",
    "sideEffectFree",
    "status",
    "hostProfileAdmission",
    "commandResults",
    "aggregate",
    "redactionStatus",
    "resourceUsage",
    "firstFailure",
    "verification",
    "warnings"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "ee.swarm_replay_result.v1"
    },
    "workloadId": {
      "$ref": "#/$defs/workloadId"
    },
    "runId": {
      "type": "string",
      "pattern": "^swarmrun_[A-Fa-f0-9]{16,64}$"
    },
    "sideEffectFree": {
      "type": "boolean",
      "const": true
    },
    "status": {
      "type": "string",
      "enum": ["pass", "fail", "blocked", "degraded"]
    },
    "hostProfileAdmission": {
      "$ref": "#/$defs/hostProfileAdmission"
    },
    "commandResults": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/commandResult"
      }
    },
    "aggregate": {
      "$ref": "#/$defs/aggregate"
    },
    "redactionStatus": {
      "$ref": "#/$defs/redactionStatus"
    },
    "resourceUsage": {
      "$ref": "#/$defs/resourceUsage"
    },
    "firstFailure": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/firstFailure"
        }
      ]
    },
    "verification": {
      "$ref": "#/$defs/verification"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 240
      }
    }
  },
  "field_presets": {
    "minimal": [
      "schema",
      "workloadId",
      "runId",
      "sideEffectFree",
      "status",
      "hostProfileAdmission",
      "commandResults",
      "aggregate",
      "redactionStatus",
      "resourceUsage",
      "firstFailure",
      "verification",
      "warnings"
    ],
    "summary": [
      "schema",
      "workloadId",
      "runId",
      "status",
      "hostProfileAdmission",
      "aggregate",
      "redactionStatus",
      "firstFailure",
      "verification"
    ],
    "standard": ["*"],
    "full": ["*"]
  },
  "examples": [
    {
      "schema": "ee.swarm_replay_result.v1",
      "workloadId": "swarmwl_1111111111111111",
      "runId": "swarmrun_2222222222222222",
      "sideEffectFree": true,
      "status": "pass",
      "hostProfileAdmission": {
        "declaredProfile": "ci_smoke",
        "requestedParallelAgents": 1,
        "requiredClass": "smoke",
        "observedClass": "standard",
        "status": "admitted",
        "logicalCpuCount": 16,
        "availableMemoryMb": 32768,
        "targetDirPosture": "external",
        "tmpdirPosture": "external",
        "rchAvailable": true,
        "numaAvailable": false,
        "lexicalRamTierAvailable": true,
        "pathTailHashes": ["blake3:aaaaaaaaaaaaaaaa"],
        "degradedCodes": [],
        "refusalReasons": []
      },
      "commandResults": [
        {
          "stepId": "step_001",
          "agentSlot": 0,
          "commandHash": "blake3:3333333333333333333333333333333333333333333333333333333333333333",
          "exitCode": 0,
          "elapsedMs": 184,
          "stdoutBytes": 4096,
          "stderrBytes": 0,
          "degradedCodes": [],
          "artifactPaths": [
            {
              "kind": "json",
              "pathTail": "artifacts/pack-result.json",
              "pathHash": "blake3:4444444444444444"
            }
          ],
          "redactionStatus": "clean",
          "slo": {
            "class": "interactive_agent",
            "status": "pass",
            "budget": {
              "latencyWarningMs": 2500,
              "latencyFailureMs": 7500,
              "stdoutWarningBytes": 16384,
              "stdoutFailureBytes": 65536,
              "stderrWarningBytes": 4096,
              "stderrFailureBytes": 16384,
              "degradedWarningCount": 0,
              "degradedFailureCount": 2
            },
            "latencyStatus": "pass",
            "stdoutStatus": "pass",
            "stderrStatus": "pass",
            "degradedCountStatus": "pass",
            "discoverabilityStatus": "pass",
            "warningDimensions": [],
            "failedDimensions": [],
            "diagnosis": null,
            "exemptionRationale": null
          },
          "memoryRssBytes": 73400320,
          "cpuMs": 73
        }
      ],
      "aggregate": {
        "commandCount": 1,
        "successCount": 1,
        "failureCount": 0,
        "degradedCount": 0,
        "sloPassCount": 1,
        "sloWarningCount": 0,
        "sloFailureCount": 0,
        "sloExemptCount": 0,
        "firstSloFailureStepId": null,
        "elapsedMsTotal": 184,
        "p50Ms": 184,
        "p95Ms": 184,
        "p99Ms": 184
      },
      "redactionStatus": {
        "rawTaskStringPresent": false,
        "rawQueryTextPresent": false,
        "rawMemoryBodyPresent": false,
        "rawMailBodyPresent": false,
        "absoluteHostPathPresent": false,
        "secretsPresent": false,
        "environmentDumpPresent": false,
        "fullFileListingPresent": false,
        "redactionProbesPassed": true
      },
      "resourceUsage": {
        "peakRssBytes": 73400320,
        "maxCommandRssBytes": 73400320,
        "totalCpuMs": 73,
