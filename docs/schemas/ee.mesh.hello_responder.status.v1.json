{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eidetic-engine/schemas/ee.mesh.hello_responder.status.v1.json",
  "title": "ee.mesh.hello_responder.status.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "running",
    "listenAddress",
    "acceptedRequests1h",
    "deniedRequests1h",
    "rateLimitedRequests1h",
    "lastRequestAt",
    "lastRestartAt",
    "crashCount24h",
    "degraded"
  ],
  "properties": {
    "schema": {
      "const": "ee.mesh.hello_responder.status.v1"
    },
    "running": {
      "type": "boolean"
    },
    "listenAddress": {
      "type": [
        "string",
        "null"
      ]
    },
    "acceptedRequests1h": {
      "type": "integer",
      "minimum": 0
    },
    "deniedRequests1h": {
      "type": "integer",
      "minimum": 0
    },
    "rateLimitedRequests1h": {
      "type": "integer",
      "minimum": 0
    },
    "lastRequestAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "lastRestartAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "crashCount24h": {
      "type": "integer",
      "minimum": 0
    },
    "degraded": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "severity",
          "message",
          "repair"
        ],
        "properties": {
          "code": {
            "enum": [
              "hello_responder_not_running",
              "hello_responder_port_in_use",
              "hello_responder_no_tailscale_ip",
              "hello_responder_crash_loop",
              "hello_responder_rate_limited_storm"
            ]
          },
          "severity": {
            "enum": [
              "warning",
              "medium",
              "high"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "repair": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
