{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eidetic-engine/schemas/ee.pack.revision_token.v1.json",
  "title": "ee.pack.revision_token.v1",
  "description": "Explicit revisable-pack token metadata emitted only when mesh revisable mode is requested.",
  "type": "object",
  "required": [
    "schema",
    "mode",
    "token",
    "tier1Usable",
    "revisionAvailable",
    "reason",
    "queryHash",
    "packHash",
    "localMeshTipState",
    "selectedMemoryIds",
    "rebuildCommand",
    "diffCommand"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {"type": "string", "const": "ee.pack.revision_token.v1"},
    "mode": {"type": "string", "const": "revisable"},
    "token": {"type": "string", "pattern": "^packrev_[0-9a-f]{32}$"},
    "tier1Usable": {"type": "boolean"},
    "revisionAvailable": {"type": "boolean"},
    "reason": {"type": "string"},
    "queryHash": {"type": "string", "pattern": "^blake3:[0-9a-f]{64}$"},
    "packHash": {"type": "string", "minLength": 1},
    "localMeshTipState": {
      "type": "object",
      "required": ["status", "basis"],
      "additionalProperties": false,
      "properties": {
        "status": {"type": "string"},
        "basis": {"type": "string"}
      }
    },
    "selectedMemoryIds": {"type": "array", "items": {"type": "string"}},
    "rebuildCommand": {"type": "string"},
    "diffCommand": {"type": "string"}
  }
}
