{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eidetic-engine/schemas/ee.search.revision_token.v1.json",
  "title": "ee.search.revision_token.v1",
  "description": "Explicit revisable-search token metadata emitted only when mesh revisable mode is requested.",
  "type": "object",
  "required": [
    "schema",
    "mode",
    "token",
    "tier1Usable",
    "revisionAvailable",
    "reason",
    "queryHash",
    "resultFingerprint",
    "resultDocIds",
    "localMeshTipState",
    "rerunCommand"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {"type": "string", "const": "ee.search.revision_token.v1"},
    "mode": {"type": "string", "const": "revisable"},
    "token": {"type": "string", "pattern": "^searchrev_[0-9a-f]{32}$"},
    "tier1Usable": {"type": "boolean"},
    "revisionAvailable": {"type": "boolean"},
    "reason": {"type": "string"},
    "queryHash": {"type": "string", "pattern": "^blake3:[0-9a-f]{64}$"},
    "resultFingerprint": {"type": "string", "pattern": "^blake3:[0-9a-f]{64}$"},
    "resultDocIds": {"type": "array", "items": {"type": "string"}},
    "localMeshTipState": {
      "type": "object",
      "required": ["status", "basis"],
      "additionalProperties": false,
      "properties": {
        "status": {"type": "string"},
        "basis": {"type": "string"}
      }
    },
    "rerunCommand": {"type": "string"}
  }
}
