{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eidetic-engine/schemas/ee.failure_mode_fixture.v1.json",
  "title": "ee.failure_mode_fixture.v1",
  "description": "Catalog entry for one degraded response code. Fixtures live under tests/fixtures/failure_modes and are the structural reference used by docs/degraded_codes.md, closure-lint, and the J6 failure-mode contract tests.",
  "type": "object",
  "required": [
    "schema",
    "code",
    "introduced_by",
    "surfaces",
    "severity",
    "repair_present",
    "trigger",
    "expected_emission"
  ],
  "additionalProperties": true,
  "properties": {
    "schema": {
      "type": "string",
      "const": "ee.failure_mode_fixture.v1"
    },
    "code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "Exact degraded[] code emitted by production responses."
    },
    "honesty_only": {
      "type": "boolean",
      "description": "True when the fixture documents an explicit honesty-only degraded code rather than an implemented runtime failure mode. Required by closure-lint for codes ending in _unimplemented."
    },
    "introduced_by": {
      "type": "object",
      "required": ["bead"],
      "additionalProperties": true,
      "properties": {
        "bead": {
          "type": "string",
          "minLength": 1
        },
        "epic_letter": {
          "type": "string"
        }
      }
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "severity": {
      "type": "string",
      "enum": ["info", "low", "warning", "medium", "high", "critical"]
    },
    "repair_present": {
      "type": "boolean"
    },
    "repair_unavailable_reason": {
      "type": "string",
      "minLength": 1,
      "description": "Optional explanation used when repair_present is false because this build has no executable automatic recovery."
    },
    "retired": {
      "type": "boolean",
      "default": false
    },
    "retired_by": {
      "type": "object",
      "additionalProperties": true
    },
    "trigger": {
      "type": "object",
      "required": ["description", "invocation"],
      "additionalProperties": true,
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "setup_commands": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "invocation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "expected_emission": {
      "type": "object",
      "required": ["code", "severity", "message_contains"],
      "additionalProperties": true,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "severity": {
          "type": "string",
          "enum": ["info", "low", "warning", "medium", "high", "critical"]
        },
        "message_contains": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "repair_contains": {
          "type": "string"
        },
        "repair_string": {
          "type": "string"
        },
        "repair_strings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "repair_command_regex": {
          "type": "string"
        },
        "repair_safety": {
          "type": "array",
          "description": "Structured safety metadata for agent-facing repair hints that name a command or require a manual/operator-only path. Each entry mirrors ee.preflight.guard.v1 repairCommandAssessment fields plus an optional appliesTo pointer to the pinned repair text.",
          "items": {
            "type": "object",
            "required": [
              "command",
              "riskClass",
              "preflightCommand",
              "requiresHumanApproval",
              "mutatesExternalState",
              "mutatesTrackerState",
              "privacyClass",
              "nextAction",
              "ruleId",
              "source",
              "reasonCode",
              "evidence",
              "preconditions"
            ],
            "additionalProperties": true,
            "properties": {
              "appliesTo": {
                "type": "string",
                "description": "Pinned repair_string or repair_strings element this safety assessment classifies."
              },
              "command": {
                "type": ["string", "null"],
                "description": "Concrete command extracted from the repair hint, or null for manual-only repairs."
              },
              "riskClass": {
                "type": "string",
                "enum": [
                  "read_only_probe",
                  "idempotent_refresh",
                  "mutating_local_repair",
                  "mutating_external_coordination_repair",
                  "approval_required_repair",
                  "destructive_or_irreversible_repair",
                  "unavailable_or_manual_only"
                ]
              },
              "preflightCommand": {
                "type": ["string", "null"]
              },
              "requiresHumanApproval": {
                "type": "boolean"
              },
              "mutatesExternalState": {
                "type": "boolean"
              },
              "mutatesTrackerState": {
                "type": "boolean"
              },
              "privacyClass": {
                "type": "string",
                "minLength": 1
              },
              "nextAction": {
                "type": "string",
                "enum": [
                  "run_directly",
                  "run_preflight_first",
                  "coordinate_first",
                  "ask_human",
                  "manual_only",
                  "policy_denied"
                ]
              },
              "ruleId": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "reasonCode": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "preconditions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "manualStep": {
                "type": "string"
              }
            }
          }
        },
        "details_contains": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "recovery_kinds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
