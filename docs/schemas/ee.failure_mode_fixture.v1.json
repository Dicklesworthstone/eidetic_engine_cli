{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eidetic-engine/schemas/ee.failure_mode_fixture.v1.json",
  "title": "ee.failure_mode_fixture.v1",
  "description": "Catalog entry for one degraded response code. Fixtures live under tests/fixtures/failure_modes and are the structural reference used by docs/degraded_codes.md, closure-lint, and the J6 failure-mode contract tests.",
  "type": "object",
  "required": [
    "schema",
    "code",
    "introduced_by",
    "surfaces",
    "severity",
    "repair_present",
    "trigger",
    "expected_emission"
  ],
  "additionalProperties": true,
  "properties": {
    "schema": {
      "type": "string",
      "const": "ee.failure_mode_fixture.v1"
    },
    "code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "Exact degraded[] code emitted by production responses."
    },
    "introduced_by": {
      "type": "object",
      "required": ["bead"],
      "additionalProperties": true,
      "properties": {
        "bead": {
          "type": "string",
          "minLength": 1
        },
        "epic_letter": {
          "type": "string"
        }
      }
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "severity": {
      "type": "string",
      "enum": ["info", "low", "warning", "medium", "high", "critical"]
    },
    "repair_present": {
      "type": "boolean"
    },
    "retired": {
      "type": "boolean",
      "default": false
    },
    "retired_by": {
      "type": "object",
      "additionalProperties": true
    },
    "trigger": {
      "type": "object",
      "required": ["description", "invocation"],
      "additionalProperties": true,
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "setup_commands": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "invocation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "expected_emission": {
      "type": "object",
      "required": ["code", "severity", "message_contains"],
      "additionalProperties": true,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "severity": {
          "type": "string",
          "enum": ["info", "low", "warning", "medium", "high", "critical"]
        },
        "message_contains": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "repair_contains": {
          "type": "string"
        },
        "repair_string": {
          "type": "string"
        },
        "repair_strings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "repair_command_regex": {
          "type": "string"
        },
        "details_contains": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "recovery_kinds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
