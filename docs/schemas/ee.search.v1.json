{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eidetic-engine/schemas/ee.search.v1.json",
  "title": "ee.search.v1",
  "description": "ee search JSON response envelope and command payload.",
  "type": "object",
  "required": ["schema", "success", "data", "degraded"],
  "additionalProperties": false,
  "properties": {
    "schema": {"type": "string", "const": "ee.response.v2"},
    "success": {"type": "boolean"},
    "fields": {"type": "string"},
    "degraded": {"type": "array", "items": {"type": "object"}},
    "data": {
      "type": "object",
      "required": [
        "command",
        "embed_backend",
        "query",
        "status",
        "resultCount",
        "results",
        "degraded",
        "errors",
        "metrics",
        "rerank",
        "elapsedMs"
      ],
      "additionalProperties": false,
      "properties": {
        "command": {"type": "string", "const": "search"},
        "embed_backend": {"type": "string", "enum": ["neural_local", "hash_fallback"]},
        "query": {"type": "string"},
        "status": {"type": "string"},
        "request": {"type": "object", "additionalProperties": {"$ref": "#/$defs/jsonValue"}},
        "scopeStats": {"type": "object", "additionalProperties": {"$ref": "#/$defs/jsonValue"}},
        "consensus": {"type": "array", "items": {"$ref": "#/$defs/jsonValue"}},
        "conflicts": {"type": "array", "items": {"$ref": "#/$defs/jsonValue"}},
        "resultCount": {"type": "integer"},
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["memoryId", "docId", "score", "source", "why", "provenance"],
            "additionalProperties": false,
            "properties": {
              "memoryId": {"type": "string"},
              "docId": {"type": "string"},
              "score": {"type": "number"},
              "relevanceScore": {"type": "number", "minimum": 0, "maximum": 1},
              "scoreKind": {"type": "string", "enum": ["unit_normalized", "rrf_fused", "reranked"]},
              "scoreInterval": {
                "type": "array",
                "items": {"type": "number"},
                "minItems": 2,
                "maxItems": 2,
                "description": "Closed [lo, hi] uncertainty interval around `score`."
              },
              "coverageGuarantee": {
                "type": ["number", "null"],
                "minimum": 0.0,
                "maximum": 1.0,
                "description": "Calibrated coverage probability the scoreInterval is expected to satisfy (e.g. 0.95 for a 95% interval). Null when `calibrated` is false: no conformal residual quantile exists, so the scoreInterval is the trivial [0,1] band and coverage is unknown rather than 95%."
              },
              "calibrated": {
                "type": "boolean",
                "description": "True when a conformal residual quantile produced the scoreInterval/coverageGuarantee. When false, scoreInterval is the trivial [0,1] band and coverageGuarantee is null; treat `score` as an uncalibrated raw fusion score, not a calibrated [0,1] relevance."
              },
              "source": {"type": "string", "enum": ["lexical", "semantic_fast", "semantic_quality", "hybrid", "reranked"]},
              "why": {"type": "string"},
              "fastScore": {"type": ["number", "null"]},
              "qualityScore": {"type": ["number", "null"]},
              "lexicalScore": {"type": ["number", "null"]},
              "rerankScore": {"type": ["number", "null"]},
              "content": {"type": "string"},
              "content_truncated": {"type": "boolean"},
              "contentRedacted": {"type": "boolean"},
              "redactions": {"type": "array", "items": {"$ref": "#/$defs/jsonValue"}},
              "driftHint": {"$ref": "#/$defs/jsonValue"},
              "meshProvenance": {"type": "object", "additionalProperties": {"$ref": "#/$defs/jsonValue"}},
              "meshTrustAdjustment": {"$ref": "#/$defs/jsonValue"},
              "tombstoned": {"type": "boolean"},
              "tombstonedAt": {"type": "string"},
              "validFrom": {"type": "string"},
              "validTo": {"type": "string"},
              "validityStatus": {"type": "string"},
              "validityWindowKind": {"type": "string"},
              "metadata": {"type": "object", "additionalProperties": {"$ref": "#/$defs/jsonValue"}},
              "provenance": {"type": "array", "items": {"type": "object", "additionalProperties": {"$ref": "#/$defs/jsonValue"}}},
              "explanation": {"type": "object", "additionalProperties": {"$ref": "#/$defs/jsonValue"}}
            }
          }
        },
        "degraded": {"type": "array", "items": {"type": "object", "additionalProperties": {"$ref": "#/$defs/jsonValue"}}},
        "errors": {"type": "array", "items": {"type": "object", "additionalProperties": {"$ref": "#/$defs/jsonValue"}}},
        "metrics": {"type": "object", "additionalProperties": {"$ref": "#/$defs/jsonValue"}},
        "rerank": {"$ref": "#/$defs/rerankPosture"},
        "queryAssist": {"$ref": "#/$defs/queryAssist"},
        "indexFreshness": {
          "type": "object",
          "required": ["stale", "largeGap"],
          "additionalProperties": false,
          "properties": {
            "stale": {"type": "boolean"},
            "dbGeneration": {"type": "integer", "minimum": 0},
            "indexGeneration": {"type": "integer", "minimum": 0},
            "generationGap": {"type": "integer", "minimum": 0},
            "largeGap": {"type": "boolean"}
          }
        },
        "elapsedMs": {"type": "number"},
        "profileRuntime": {"type": "object", "additionalProperties": {"$ref": "#/$defs/jsonValue"}},
        "resultPath": {"type": "string", "const": "data.results"}
      }
    }
  },
  "field_presets": {
    "minimal": ["embed_backend", "memoryId", "docId", "score", "source"],
    "summary": ["query", "status", "embed_backend", "resultCount", "memoryId", "docId", "score", "source"],
    "standard": ["query", "status", "embed_backend", "resultCount", "results", "memoryId", "docId", "score", "source", "why", "provenance", "indexFreshness", "degraded", "errors", "metrics", "elapsedMs"],
    "full": ["*"]
  },
  "$defs": {
    "jsonValue": {
      "oneOf": [
        {"type": "null"},
        {"type": "boolean"},
        {"type": "number"},
        {"type": "string"},
        {"type": "array", "items": {"$ref": "#/$defs/jsonValue"}},
        {"type": "object", "additionalProperties": {"$ref": "#/$defs/jsonValue"}}
      ]
    },
    "queryAssist": {
      "type": "object",
      "required": ["schema", "weakResultReason", "reformulations", "didYouMean", "captureTemplate"],
      "additionalProperties": {"$ref": "#/$defs/jsonValue"},
      "properties": {
        "schema": {"type": "string", "const": "ee.query_assist.v1"},
        "weakResultReason": {"type": "string"},
        "reformulations": {"type": "array", "items": {"type": "object", "additionalProperties": {"$ref": "#/$defs/jsonValue"}}},
        "didYouMean": {"type": "array", "items": {"type": "object", "additionalProperties": {"$ref": "#/$defs/jsonValue"}}},
        "captureTemplate": {"type": "object", "additionalProperties": {"$ref": "#/$defs/jsonValue"}}
      }
    },
    "rerankPosture": {
      "type": "object",
      "required": [
        "schema",
        "mode",
        "configured",
        "topK",
        "rerankScoreCount",
        "scoreKind",
        "available",
        "degradedCode",
        "advisory",
        "advisorySummary"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {"type": "string", "const": "ee.rerank_posture.v1"},
        "mode": {"type": "string", "enum": ["reranked", "fusion_only", "fusion_only_degraded"]},
        "configured": {"type": "string", "enum": ["auto", "off"]},
        "topK": {"type": "integer", "minimum": 1},
        "rerankScoreCount": {"type": "integer", "minimum": 0},
        "scoreKind": {"type": "string", "enum": ["rrf_fused", "reranked"]},
        "available": {"type": "boolean"},
        "degradedCode": {"enum": ["rerank_model_unavailable", null]},
        "advisory": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/permanentRerankAdvisory"},
            {"$ref": "#/$defs/transientRerankAdvisory"}
          ]
        },
        "advisorySummary": {"$ref": "#/$defs/rerankAdvisorySummary"}
      }
    },
    "permanentRerankAdvisory": {
      "type": "object",
      "required": ["code", "severity", "permanent", "message", "repair", "resolution"],
      "additionalProperties": false,
      "properties": {
        "code": {"type": "string", "const": "rerank_model_unavailable"},
        "severity": {"type": "string", "enum": ["info", "low", "warning", "medium", "high", "critical"]},
        "permanent": {"type": "boolean", "const": true},
        "message": {"type": "string", "minLength": 1},
        "repair": {"type": "null"},
        "resolution": {"type": "string", "const": "automatic_repair_unavailable"}
      }
    },
    "transientRerankAdvisory": {
      "type": "object",
      "required": ["code", "severity", "permanent", "message", "repair", "resolution"],
      "additionalProperties": false,
      "properties": {
        "code": {"type": "string", "const": "rerank_model_unavailable"},
        "severity": {"type": "string", "enum": ["info", "low", "warning", "medium", "high", "critical"]},
        "permanent": {"type": "boolean", "const": false},
        "message": {"type": "string", "minLength": 1},
        "repair": {"type": ["string", "null"]},
        "resolution": {"type": "string", "const": "retry_or_inspect_local_registry"}
      }
    },
    "rerankAdvisorySummary": {
      "type": "object",
      "required": [
        "scope",
        "permanent",
        "distinctCount",
        "emittedCount",
        "suppressedCount",
        "sessionOccurrenceCount",
        "sessionSuppressedCount"
      ],
      "additionalProperties": false,
      "properties": {
        "scope": {"type": "string", "enum": ["invocation", "process", "response"]},
        "permanent": {"type": ["boolean", "null"]},
        "distinctCount": {"type": "integer", "minimum": 0},
        "emittedCount": {"type": "integer", "minimum": 0},
        "suppressedCount": {"type": "integer", "minimum": 0},
        "sessionOccurrenceCount": {"type": "integer", "minimum": 0},
        "sessionSuppressedCount": {"type": "integer", "minimum": 0}
      }
    }
  }
}
