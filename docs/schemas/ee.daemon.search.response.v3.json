{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eidetic-engine/schemas/ee.daemon.search.response.v3.json",
  "title": "ee.daemon.search.response.v3",
  "description": "Strict nested success result for ee.daemon.search. daemonTotal begins at method dispatch and ends after canonical machine/human rendering; daemon envelope serialization, frame writing, and transport time are excluded. embedderPreparation, indexOpen, and query aggregate named canonical SearchPerformanceTrace spans and are null when that phase did not run. The optional performance field is present only when requested through ee.daemon.search.request.v2 explainPerformance and carries the canonical redaction-safe ee.explain.performance.v1 envelope. All timings are observational and nondeterministic.",
  "type": "object",
  "required": ["schema", "response", "human", "reuseContract", "timing"],
  "additionalProperties": false,
  "properties": {
    "schema": {"type": "string", "const": "ee.daemon.search.response.v3"},
    "human": {"type": "string"},
    "performance": {"$ref": "#/$defs/performance"},
    "reuseContract": {
      "type": "object",
      "required": ["daemonProcess", "defaultSearchEmbedder", "searchIndex"],
      "additionalProperties": false,
      "properties": {
        "daemonProcess": {"type": "string", "const": "long_lived"},
        "defaultSearchEmbedder": {"type": "string", "const": "process_scoped"},
        "searchIndex": {"type": "string", "const": "per_request"}
      }
    },
    "timing": {
      "type": "object",
      "required": ["daemonTotal", "embedderPreparation", "indexOpen", "query"],
      "additionalProperties": false,
      "properties": {
        "daemonTotal": {"$ref": "#/$defs/timing"},
        "embedderPreparation": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/timing"}]},
        "indexOpen": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/timing"}]},
        "query": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/timing"}]}
      }
    },
    "response": {
      "type": "object",
      "required": ["schema", "success", "data", "degraded"],
      "additionalProperties": false,
      "properties": {
        "schema": {"type": "string", "const": "ee.response.v2"},
        "success": {"type": "boolean", "const": true},
        "degraded": {"type": "array", "items": {"$ref": "#/$defs/degradation"}},
        "data": {
          "type": "object",
          "required": ["command", "status", "embed_backend", "query", "request", "scopeStats", "results", "consensus", "conflicts", "resultCount", "elapsedMs", "metrics", "rerank", "profileRuntime", "errors", "degraded"],
          "additionalProperties": false,
          "properties": {
            "command": {"type": "string", "const": "search"},
            "status": {"type": "string", "enum": ["success", "no_results", "index_not_found", "index_error"]},
            "embed_backend": {"type": "string", "enum": ["neural_local", "hash_fallback"]},
            "query": {"type": "string"},
            "request": {"type": "object"},
            "scopeStats": {"type": "object"},
            "results": {"type": "array", "items": {"$ref": "#/$defs/searchDocument"}},
            "consensus": {"type": "array"},
            "conflicts": {"type": "array"},
            "resultCount": {"$ref": "#/$defs/uint64"},
            "elapsedMs": {"type": "number", "minimum": 0},
            "metrics": {"type": "object"},
            "rerank": {"$ref": "#/$defs/rerankPosture"},
            "profileRuntime": {"type": "object"},
            "errors": {"type": "array"},
            "degraded": {"type": "array"},
            "queryAssist": {"type": "object"},
            "indexFreshness": {"$ref": "#/$defs/indexFreshness"},
            "resultPath": {"type": "string", "const": "data.results"}
          }
        }
      }
    }
  },
  "$defs": {
    "indexFreshness": {
      "description": "Authoritative per-response index freshness truth, present whenever the index-status probe observed a stale index; emitted independently of advisory-episode dedupe so suppressed warnings never hide staleness (bd-index-auto-freshness-m5kwf).",
      "type": "object",
      "required": ["stale", "largeGap"],
      "additionalProperties": false,
      "properties": {
        "stale": {"type": "boolean"},
        "dbGeneration": {"$ref": "#/$defs/uint64"},
        "indexGeneration": {"$ref": "#/$defs/uint64"},
        "generationGap": {"$ref": "#/$defs/uint64"},
        "largeGap": {"type": "boolean"}
      }
    },
    "uint64": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "rerankPosture": {
      "type": "object",
      "required": ["schema", "mode", "configured", "topK", "rerankScoreCount", "scoreKind", "available", "degradedCode", "advisory", "advisorySummary"],
      "additionalProperties": false,
      "properties": {
        "schema": {"type": "string", "const": "ee.rerank_posture.v1"},
        "mode": {"type": "string", "enum": ["reranked", "fusion_only_degraded", "fusion_only"]},
        "configured": {"type": "string", "enum": ["auto", "off"]},
        "topK": {"$ref": "#/$defs/uint64"},
        "rerankScoreCount": {"$ref": "#/$defs/uint64"},
        "scoreKind": {"type": "string", "enum": ["reranked", "rrf_fused"]},
        "available": {"type": "boolean"},
        "degradedCode": {"type": ["string", "null"], "minLength": 1},
        "advisory": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/rerankAdvisory"}
          ]
        },
        "advisorySummary": {"$ref": "#/$defs/rerankAdvisorySummary"}
      }
    },
    "rerankAdvisory": {
      "type": "object",
      "required": ["code", "severity", "permanent", "message", "repair", "resolution"],
      "additionalProperties": false,
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "severity": {"type": "string", "enum": ["info", "low", "warning", "medium", "high", "critical"]},
        "permanent": {"type": "boolean"},
        "message": {"type": "string"},
        "repair": {"type": ["string", "null"]},
        "resolution": {"type": "string", "enum": ["automatic_repair_unavailable", "retry_or_inspect_local_registry"]}
      }
    },
    "rerankAdvisorySummary": {
      "type": "object",
      "required": ["scope", "permanent", "distinctCount", "emittedCount", "suppressedCount", "sessionOccurrenceCount", "sessionSuppressedCount"],
      "additionalProperties": false,
      "properties": {
        "scope": {"type": "string", "enum": ["invocation", "process", "response"]},
        "permanent": {"type": ["boolean", "null"]},
        "distinctCount": {"$ref": "#/$defs/uint64"},
        "emittedCount": {"$ref": "#/$defs/uint64"},
        "suppressedCount": {"$ref": "#/$defs/uint64"},
        "sessionOccurrenceCount": {"$ref": "#/$defs/uint64"},
        "sessionSuppressedCount": {"$ref": "#/$defs/uint64"}
      }
    },
    "performance": {
      "type": "object",
      "required": ["schema", "success", "data"],
      "additionalProperties": false,
      "properties": {
        "schema": {"type": "string", "const": "ee.explain.performance.v1"},
        "success": {"type": "boolean", "const": true},
        "data": {
          "type": "object",
          "required": ["command", "query", "queryPlan", "profileRuntime", "dbReads", "search", "timings", "pack", "cache", "graph", "fallbacks", "redaction"],
          "additionalProperties": false,
          "properties": {
            "command": {"type": "string", "const": "search"},
            "query": {
              "type": "object",
              "required": ["textIncluded", "lengthBytes", "fingerprint"],
              "additionalProperties": false,
              "properties": {
                "textIncluded": {"type": "boolean", "const": false},
                "lengthBytes": {"$ref": "#/$defs/uint64"},
                "fingerprint": {"type": "string", "pattern": "^blake3:[0-9a-f]{64}$"}
              }
            },
            "queryPlan": {
              "type": "object",
              "required": ["retrievalMode", "requestedLimit", "candidateBudget", "usesEmbeddings", "scoreExplanationsRequested", "sourceModeRequested", "sourceModeApplied", "strictSourceMode", "fallbackApplied", "memoryScope", "strictScope"],
              "additionalProperties": false,
              "properties": {
                "retrievalMode": {"type": "string", "enum": ["instant", "default", "quality"]},
                "requestedLimit": {"$ref": "#/$defs/uint64"},
                "candidateBudget": {"$ref": "#/$defs/uint64"},
                "usesEmbeddings": {"type": "boolean"},
                "scoreExplanationsRequested": {"type": "boolean"},
                "sourceModeRequested": {"type": "string", "enum": ["lexical_only", "semantic_only", "hybrid"]},
                "sourceModeApplied": {"type": "string", "enum": ["lexical_only", "semantic_only", "hybrid"]},
                "strictSourceMode": {"type": "boolean"},
                "fallbackApplied": {"type": "boolean"},
                "memoryScope": {"type": "string", "enum": ["self", "team", "global", "workspace", "verified", "swarm"]},
                "strictScope": {"type": "boolean"}
              }
            },
            "profileRuntime": {"$ref": "#/$defs/performanceRuntimeProfile"},
            "dbReads": {
              "type": "object",
              "required": ["indexStatusChecks", "memoryReads", "tagReads", "artifactLinkReads"],
              "additionalProperties": false,
              "properties": {
                "indexStatusChecks": {"$ref": "#/$defs/uint64"},
                "memoryReads": {"$ref": "#/$defs/uint64"},
                "tagReads": {"$ref": "#/$defs/uint64"},
                "artifactLinkReads": {"$ref": "#/$defs/uint64"}
              }
            },
            "search": {"$ref": "#/$defs/performanceSearch"},
            "timings": {"type": "array", "items": {"$ref": "#/$defs/performanceNamedTiming"}},
            "pack": {"$ref": "#/$defs/notUsed"},
            "cache": {"$ref": "#/$defs/notUsed"},
            "graph": {"$ref": "#/$defs/notUsed"},
            "fallbacks": {"type": "array", "items": {"$ref": "#/$defs/performanceFallback"}},
            "redaction": {
              "type": "object",
              "required": ["memoryContentIncluded", "queryTextIncluded", "safeFields"],
              "additionalProperties": false,
              "properties": {
                "memoryContentIncluded": {"type": "boolean", "const": false},
                "queryTextIncluded": {"type": "boolean", "const": false},
                "safeFields": {
                  "type": "array",
                  "const": ["counts", "elapsedMs", "elapsedMsBucket", "status", "fingerprints", "degradationCodes"]
                }
              }
            }
          }
        }
      }
    },
    "performanceRuntimeProfile": {
      "type": "object",
      "required": ["schema", "activeProfile", "source", "budgets"],
      "additionalProperties": false,
      "properties": {
        "schema": {"type": "string", "const": "ee.profile.runtime.v1"},
        "activeProfile": {"type": "string", "enum": ["constrained", "portable", "workstation", "swarm"]},
        "source": {"type": "string", "minLength": 1},
        "budgets": {
          "type": "object",
          "required": ["search", "pack", "cache", "writeSpool", "steward", "verification", "diagnostics"],
          "additionalProperties": false,
          "properties": {
            "search": {
              "type": "object",
              "required": ["candidateLimit", "concurrentIndexReaders", "staleIndexTolerance"],
              "additionalProperties": false,
              "properties": {
                "candidateLimit": {"$ref": "#/$defs/uint64"},
                "concurrentIndexReaders": {"$ref": "#/$defs/uint64"},
                "staleIndexTolerance": {"type": "string", "enum": ["strict", "repair_hint"]}
              }
            },
            "pack": {
              "type": "object",
              "required": ["maxTokens", "maxCandidateMemories", "explanationVerbosity"],
              "additionalProperties": false,
              "properties": {
                "maxTokens": {"$ref": "#/$defs/uint64"},
                "maxCandidateMemories": {"$ref": "#/$defs/uint64"},
                "explanationVerbosity": {"type": "string", "enum": ["standard", "full"]}
              }
            },
            "cache": {
              "type": "object",
              "required": ["memoryCapMb", "entryCap", "hotsetPrewarmLimit"],
              "additionalProperties": false,
              "properties": {
                "memoryCapMb": {"$ref": "#/$defs/uint64"},
                "entryCap": {"$ref": "#/$defs/uint64"},
                "hotsetPrewarmLimit": {"$ref": "#/$defs/uint64"}
              }
            },
            "writeSpool": {
              "type": "object",
              "required": ["queueCap", "batchCap", "retryBudget"],
              "additionalProperties": false,
              "properties": {
                "queueCap": {"$ref": "#/$defs/uint64"},
                "batchCap": {"$ref": "#/$defs/uint64"},
                "retryBudget": {"$ref": "#/$defs/uint64"}
              }
            },
            "steward": {
              "type": "object",
              "required": ["maintenanceWindowMs", "graphRefreshBudget", "daemonPrewarm"],
              "additionalProperties": false,
              "properties": {
                "maintenanceWindowMs": {"$ref": "#/$defs/uint64"},
                "graphRefreshBudget": {"$ref": "#/$defs/uint64"},
                "daemonPrewarm": {"type": "boolean"}
              }
            },
            "verification": {
              "type": "object",
              "required": ["recipe", "targetDirPosture", "timeoutClass", "heavyStrategy"],
              "additionalProperties": false,
              "properties": {
                "recipe": {"type": "string", "enum": ["quick", "workspace", "full"]},
                "targetDirPosture": {"type": "string", "enum": ["shared", "isolated"]},
                "timeoutClass": {"type": "string", "enum": ["short", "standard", "extended"]},
                "heavyStrategy": {"type": "string", "enum": ["manual", "rch_preferred", "rch_default"]}
              }
            },
            "diagnostics": {
              "type": "object",
              "required": ["supportBundleProfile", "redaction"],
              "additionalProperties": false,
              "properties": {
                "supportBundleProfile": {"type": "string", "enum": ["minimal", "standard", "full"]},
                "redaction": {"type": "string", "enum": ["strict", "policy_applied"]}
              }
            }
          }
        }
      }
    },
    "performanceSearch": {
      "type": "object",
      "required": ["status", "returnedHits", "sourceCounts", "scoreDistribution", "fieldCoverage", "errors", "elapsed", "timings"],
      "additionalProperties": false,
      "properties": {
        "status": {"type": "string", "enum": ["success", "no_results", "index_not_found", "index_error"]},
        "returnedHits": {"$ref": "#/$defs/uint64"},
        "sourceCounts": {
          "type": "object",
          "required": ["lexical", "semanticFast", "semanticQuality", "hybrid", "reranked"],
          "additionalProperties": false,
          "properties": {
            "lexical": {"$ref": "#/$defs/uint64"},
            "semanticFast": {"$ref": "#/$defs/uint64"},
            "semanticQuality": {"$ref": "#/$defs/uint64"},
            "hybrid": {"$ref": "#/$defs/uint64"},
            "reranked": {"$ref": "#/$defs/uint64"}
          }
        },
        "scoreDistribution": {
          "type": "object",
          "description": "Distribution of normalized relevanceScore values, never a mixture of native BM25, cosine, RRF, or reranker scales.",
          "required": ["top", "min", "max", "mean"],
          "additionalProperties": false,
          "properties": {
            "top": {"type": ["number", "null"]},
            "min": {"type": ["number", "null"]},
            "max": {"type": ["number", "null"]},
            "mean": {"type": ["number", "null"]}
          }
        },
        "fieldCoverage": {
          "type": "object",
          "required": ["fastScoreCount", "qualityScoreCount", "lexicalScoreCount", "rerankScoreCount", "metadataCount", "explanationCount"],
          "additionalProperties": false,
          "properties": {
            "fastScoreCount": {"$ref": "#/$defs/uint64"},
            "qualityScoreCount": {"$ref": "#/$defs/uint64"},
            "lexicalScoreCount": {"$ref": "#/$defs/uint64"},
            "rerankScoreCount": {"$ref": "#/$defs/uint64"},
            "metadataCount": {"$ref": "#/$defs/uint64"},
            "explanationCount": {"$ref": "#/$defs/uint64"}
          }
        },
        "errors": {"type": "array", "items": {"type": "string"}},
        "elapsed": {"$ref": "#/$defs/timing"},
        "timings": {"type": "array", "items": {"$ref": "#/$defs/performanceNamedTiming"}}
      }
    },
    "performanceNamedTiming": {
      "type": "object",
      "required": ["elapsedMs", "elapsedMsBucket", "nondeterministic", "name"],
      "additionalProperties": false,
      "properties": {
        "elapsedMs": {"type": "number", "minimum": 0},
        "elapsedMsBucket": {"type": "string", "enum": ["lt_1ms", "1_9ms", "10_49ms", "50_99ms", "100_499ms", "500_999ms", "gte_1000ms"]},
        "nondeterministic": {"type": "boolean", "const": true},
        "name": {"type": "string", "minLength": 1}
      }
    },
    "notUsed": {
      "type": "object",
      "required": ["status", "reason"],
      "additionalProperties": false,
      "properties": {
        "status": {"type": "string", "const": "not_used"},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "performanceFallback": {
      "type": "object",
      "required": ["code", "severity", "message", "sources"],
      "additionalProperties": false,
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "severity": {"type": "string", "enum": ["info", "low", "warning", "medium", "high", "critical"]},
        "message": {"type": "string", "const": "Fallback details are redacted; inspect the degradation code and canonical response."},
        "sources": {"type": "array", "const": ["search"]}
      }
    },
    "degradation": {
      "type": "object",
      "required": ["code", "severity", "message"],
      "additionalProperties": false,
      "properties": {
        "code": {"type": "string"},
        "severity": {"type": "string", "enum": ["info", "low", "warning", "medium", "high", "critical"]},
        "message": {"type": "string"},
        "repair": {"type": "string"},
        "repairKind": {"type": "string", "enum": ["actionable", "template", "placeholder", "unknown", "empty"]},
        "sources": {"type": "array", "items": {"type": "string"}},
        "details": {"type": "object"}
      }
    },
    "timing": {
      "type": "object",
      "required": ["elapsedMs", "elapsedMsBucket", "nondeterministic"],
      "additionalProperties": false,
      "properties": {
        "elapsedMs": {"type": "number", "minimum": 0},
        "elapsedMsBucket": {"type": "string", "enum": ["lt_1ms", "1_9ms", "10_49ms", "50_99ms", "100_499ms", "500_999ms", "gte_1000ms"]},
        "nondeterministic": {"type": "boolean", "const": true}
      }
    },
    "searchDocument": {
      "type": "object",
      "required": ["docId", "score", "relevanceScore", "scoreKind", "scoreInterval", "coverageGuarantee", "calibrated", "source", "why", "provenance"],
      "additionalProperties": false,
      "properties": {
        "docId": {"type": "string"},
        "memoryId": {"type": "string"},
        "score": {"type": "number"},
        "relevanceScore": {"type": "number", "minimum": 0, "maximum": 1},
        "scoreKind": {"type": "string", "enum": ["unit_normalized", "cosine_similarity", "rrf_fused", "reranked"]},
        "scoreInterval": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
        "coverageGuarantee": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "calibrated": {"type": "boolean"},
        "source": {"type": "string", "enum": ["lexical", "semantic_fast", "semantic_quality", "hash_control", "hybrid", "reranked"]},
        "why": {"type": "string"},
        "provenance": {"type": "array"},
        "fastScore": {"type": "number"},
        "qualityScore": {"type": "number"},
        "lexicalScore": {"type": "number"},
        "rerankScore": {"type": "number"},
        "metadata": {"type": "object"},
        "driftHint": {},
        "meshProvenance": {"type": "object"},
        "meshTrustAdjustment": {},
        "content": {"type": "string"},
        "content_truncated": {"type": "boolean"},
        "contentRedacted": {"type": "boolean"},
        "redactions": {"type": "array"},
        "tombstoned": {"type": "boolean"},
        "tombstonedAt": {"type": "string"},
        "validFrom": {"type": "string"},
        "validTo": {"type": "string"},
        "validityStatus": {"type": "string"},
        "validityWindowKind": {"type": "string"},
        "explanation": {"type": "object"}
      }
    }
  }
}
