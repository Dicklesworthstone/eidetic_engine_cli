{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eidetic-engine/schemas/ee.why.v1.json",
  "title": "ee.why.v1",
  "description": "Augmentation contract for ee why output with graph-derived explanation blocks.",
  "type": "object",
  "required": ["schema", "memoryId", "graph"],
  "additionalProperties": false,
  "properties": {
    "schema": {"type": "string", "const": "ee.why.v1"},
    "memoryId": {"type": "string"},
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bayesPosterior": {"$ref": "#/$defs/jsonValue"},
        "loadBearing": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/loadBearingWhy"}
          ]
        },
        "hits": {"$ref": "#/$defs/jsonValue"},
        "revisionLineage": {"$ref": "#/$defs/jsonValue"}
      }
    }
  },
  "examples": [
    {
      "schema": "ee.why.v1",
      "memoryId": "mem_load_bearing_release_rule",
      "graph": {
        "bayesPosterior": null,
        "loadBearing": {
          "isLoadBearing": true,
          "loadBearingScore": 0.8732,
          "authorityRank": 1,
          "citingRuleCount": 2,
          "citingRules": [
            {"ruleId": "rule_release_safety", "relation": "cites"},
            {"ruleId": "rule_rch_remote_only", "relation": "cites"}
          ],
          "interpretation": "load_bearing",
          "evidence": {
            "schema": "ee.graph.hits.v1",
            "algorithm": "bipartite_hits",
            "projection": "rule_provenance_bipartite",
            "snapshotVersion": 42
          },
          "rationale": "This memory is cited by multiple procedural rules in the rule-provenance bipartite projection."
        },
        "hits": null,
        "revisionLineage": null
      }
    }
  ],
  "field_presets": {
    "minimal": ["schema", "memoryId"],
    "summary": ["schema", "memoryId", "graph"],
    "standard": ["schema", "memoryId", "graph"],
    "full": ["*"]
  },
  "$defs": {
    "loadBearingWhy": {
      "type": "object",
      "required": [
        "isLoadBearing",
        "loadBearingScore",
        "authorityRank",
        "citingRuleCount",
        "citingRules",
        "interpretation",
        "evidence",
        "rationale"
      ],
      "additionalProperties": false,
      "properties": {
        "isLoadBearing": {"type": "boolean"},
        "loadBearingScore": {"type": ["number", "null"], "minimum": 0},
        "authorityRank": {"type": ["integer", "null"], "minimum": 1},
        "citingRuleCount": {"type": "integer", "minimum": 0},
        "citingRules": {"type": "array", "items": {"$ref": "#/$defs/ruleReference"}},
        "interpretation": {
          "type": "string",
          "enum": ["load_bearing", "not_load_bearing", "unavailable"]
        },
        "evidence": {"$ref": "#/$defs/loadBearingEvidence"},
        "rationale": {"type": "string"}
      }
    },
    "ruleReference": {
      "type": "object",
      "required": ["ruleId", "relation"],
      "additionalProperties": false,
      "properties": {
        "ruleId": {"type": "string"},
        "relation": {"type": "string", "const": "cites"}
      }
    },
    "loadBearingEvidence": {
      "type": "object",
      "required": ["schema", "algorithm", "projection", "snapshotVersion"],
      "additionalProperties": false,
      "properties": {
        "schema": {"type": "string", "const": "ee.graph.hits.v1"},
        "algorithm": {"type": "string", "const": "bipartite_hits"},
        "projection": {"type": "string", "const": "rule_provenance_bipartite"},
        "snapshotVersion": {"type": "integer", "minimum": 0}
      }
    },
    "jsonValue": {
      "oneOf": [
        {"type": "null"},
        {"type": "boolean"},
        {"type": "number"},
        {"type": "string"},
        {"type": "array", "items": {"$ref": "#/$defs/jsonValue"}},
        {"type": "object", "additionalProperties": {"$ref": "#/$defs/jsonValue"}}
      ]
    }
  }
}
