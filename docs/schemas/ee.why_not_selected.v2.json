{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eidetic-engine/schemas/ee.why_not_selected.v2.json",
  "title": "ee.why_not_selected.v2",
  "description": "Read-only native-entity explanation observed in the actual mixed-source context pack. Source bodies are never included.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "entity", "taskHash", "selected", "retrievalStageReached", "primaryReason", "reasonSource", "reasonCodes", "message", "tokenBudgetFrontier", "degraded", "counterfactualHints", "provenance"],
  "properties": {
    "schema": { "const": "ee.why_not_selected.v2" },
    "entity": { "$ref": "#/$defs/entity" },
    "taskHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "selected": { "type": "boolean" },
    "retrievalStageReached": { "enum": ["retrieval", "degraded_index", "candidate_filter", "pagination", "selection", "selected"] },
    "primaryReason": { "enum": ["selected", "not_retrieved", "not_retrieved_due_to_degraded_index", "excluded_by_filter", "excluded_by_scope", "excluded_by_redaction", "excluded_by_validity_window", "excluded_by_policy", "omitted_by_score_floor", "omitted_by_pagination", "omitted_by_token_budget", "omitted_by_result_limit", "represented_by_other_item", "represented_by_incident_card"] },
    "reasonSource": { "enum": ["authoritative", "reconstructed"] },
    "reasonCodes": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "message": { "type": "string", "minLength": 1 },
    "representedBy": { "$ref": "#/$defs/entity" },
    "representativeSelected": { "type": "boolean" },
    "scores": {
      "type": "object", "additionalProperties": false,
      "required": ["targetRelevance", "targetUtility"],
      "properties": {
        "targetRelevance": { "type": "number", "minimum": 0, "maximum": 1 },
        "targetUtility": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "tokenBudgetFrontier": {
      "type": "object", "additionalProperties": false,
      "required": ["maxTokens", "usedTokens"],
      "properties": {
        "maxTokens": { "type": "integer", "minimum": 1 },
        "usedTokens": { "type": "integer", "minimum": 0 },
        "targetEstimatedTokens": { "type": "integer", "minimum": 1 },
        "requiredAdditionalTokens": { "type": "integer", "minimum": 0 },
        "couldFitWithBudget": { "type": "integer", "minimum": 1 }
      }
    },
    "degraded": { "type": "array", "items": { "$ref": "#/$defs/degradation" } },
    "counterfactualHints": { "type": "array", "items": { "$ref": "#/$defs/hint" } },
    "provenance": { "type": "array", "items": { "$ref": "#/$defs/provenance" } }
  },
  "$defs": {
    "entity": {
      "type": "object", "additionalProperties": false, "required": ["kind", "id"],
      "oneOf": [
        { "properties": { "kind": { "const": "memory" }, "id": { "type": "string", "pattern": "^mem_" } } },
        { "properties": { "kind": { "const": "rule" }, "id": { "type": "string", "pattern": "^rule_" } } },
        { "properties": { "kind": { "const": "evidence_span" }, "id": { "type": "string", "pattern": "^ev_" } } }
      ],
      "properties": { "kind": { "type": "string" }, "id": { "type": "string" } }
    },
    "degradation": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "severity", "stage", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "severity": { "type": "string", "minLength": 1 },
        "stage": { "const": "retrieval" },
        "message": { "type": "string" },
        "repairAction": { "type": "string" }
      }
    },
    "hint": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "action", "rationale"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "action": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["uri", "label", "scheme", "note"],
      "properties": {
        "uri": { "type": "string" },
        "label": { "type": "string" },
        "scheme": { "type": "string" },
        "locator": { "type": ["string", "null"] },
        "note": { "type": "string" }
      }
    }
  }
}
