{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eidetic-engine/schemas/ee.capture_suggestions.v1.json",
  "title": "ee.capture_suggestions.v1",
  "description": "Read-only ambient capture suggestions distilled from session evidence. Candidates are proposals only; durable storage requires an explicit curation command.",
  "type": "object",
  "required": [
    "schema",
    "command",
    "version",
    "workspaceId",
    "workspacePath",
    "databasePath",
    "selection",
    "readOnly",
    "durableMutation",
    "sessionId",
    "cassSessionId",
    "evidenceSpanCount",
    "candidateCount",
    "suppressedCount",
    "minConfidence",
    "limit",
    "candidates",
    "suppressed",
    "degraded",
    "nextAction"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {"type": "string", "const": "ee.capture_suggestions.v1"},
    "command": {"type": "string", "const": "capture suggest"},
    "version": {"type": "string"},
    "workspaceId": {"type": "string"},
    "workspacePath": {"type": "string"},
    "databasePath": {"type": "string"},
    "selection": {"$ref": "#/$defs/selection"},
    "readOnly": {"type": "boolean", "const": true},
    "durableMutation": {"type": "boolean", "const": false},
    "sessionId": {"type": "string"},
    "cassSessionId": {"type": "string"},
    "evidenceSpanCount": {"type": "integer", "minimum": 0},
    "candidateCount": {"type": "integer", "minimum": 0},
    "suppressedCount": {"type": "integer", "minimum": 0},
    "minConfidence": {"type": "number", "minimum": 0, "maximum": 1},
    "limit": {"type": "integer", "minimum": 1},
    "candidates": {
      "type": "array",
      "items": {"$ref": "#/$defs/candidate"}
    },
    "suppressed": {
      "type": "array",
      "items": {"$ref": "#/$defs/suppression"}
    },
    "degraded": {
      "type": "array",
      "items": {"$ref": "#/$defs/degradation"}
    },
    "nextAction": {"type": "string"}
  },
  "$defs": {
    "selection": {
      "type": "object",
      "required": ["source", "requestedSessionId"],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "enum": ["from_recent", "from_session", "latest_session"]
        },
        "requestedSessionId": {"type": ["string", "null"]}
      }
    },
    "candidate": {
      "type": "object",
      "required": [
        "candidateId",
        "candidateType",
        "candidateKind",
        "topicKey",
        "targetMemoryId",
        "proposedFields",
        "evidence",
        "confidence",
        "dedupeStatus",
        "reviewCommand",
        "acceptCommand",
        "rejectCommand"
      ],
      "additionalProperties": false,
      "properties": {
        "candidateId": {"type": "string"},
        "candidateType": {"type": "string"},
        "candidateKind": {"type": "string"},
        "topicKey": {"type": "string"},
        "targetMemoryId": {"type": ["string", "null"]},
        "proposedFields": {"$ref": "#/$defs/proposedFields"},
        "evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/evidence"}
        },
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "dedupeStatus": {"$ref": "#/$defs/dedupeStatus"},
        "reviewCommand": {"type": "string"},
        "acceptCommand": {"type": "string"},
        "rejectCommand": {"type": "string"}
      }
    },
    "proposedFields": {
      "type": "object",
      "required": ["level", "kind", "tags", "content", "confidence"],
      "additionalProperties": false,
      "properties": {
        "level": {"type": "string"},
        "kind": {"type": "string"},
        "tags": {
          "type": "array",
          "items": {"type": "string"}
        },
        "content": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "evidenceSpanId",
        "cassSpanId",
        "role",
        "startLine",
        "endLine",
        "contentHash",
        "excerpt"
      ],
      "additionalProperties": false,
      "properties": {
        "evidenceSpanId": {"type": "string"},
        "cassSpanId": {"type": "string"},
        "role": {"type": ["string", "null"]},
        "startLine": {"type": "integer", "minimum": 0},
        "endLine": {"type": "integer", "minimum": 0},
        "contentHash": {"type": "string"},
        "excerpt": {"type": "string"}
      }
    },
    "dedupeStatus": {
      "type": "object",
      "required": [
        "status",
        "method",
        "reason",
        "matchedCandidateId",
        "matchedMemoryId",
        "similarity"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {"type": "string"},
        "method": {"type": "string"},
        "reason": {"type": "string"},
        "matchedCandidateId": {"type": ["string", "null"]},
        "matchedMemoryId": {"type": ["string", "null"]},
        "similarity": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      }
    },
    "suppression": {
      "type": "object",
      "required": ["candidateId", "topicKey", "dedupeStatus"],
      "additionalProperties": false,
      "properties": {
        "candidateId": {"type": "string"},
        "topicKey": {"type": "string"},
        "dedupeStatus": {"$ref": "#/$defs/dedupeStatus"}
      }
    },
    "degradation": {
      "type": "object",
      "required": ["code", "severity", "message", "repair"],
      "additionalProperties": false,
      "properties": {
        "code": {"type": "string"},
        "severity": {"type": "string"},
        "message": {"type": "string"},
        "repair": {"type": "string"}
      }
    }
  }
}
