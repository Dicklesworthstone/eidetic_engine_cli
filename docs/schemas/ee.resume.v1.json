{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eidetic-engine/schemas/ee.resume.v1.json",
  "title": "ee.resume.v1",
  "description": "Session-resume bundle for ee resume (bd-resume-verb-v0f57): the 'where was I' report a resuming agent needs in one read-only call. Recent episodic sessions are newest-first (session-* tags are stable identities even across interleaved/backfilled writes; untagged rows cluster by write-time gap), public-admitted items carry redaction-safe provenance and explicit redaction posture, open-loop lanes expose exact totals plus bounded truncation, staleness is flagged rather than silently ranked down, and nearby populated stores are reported when the addressed store has nothing episodic.",
  "type": "object",
  "required": [
    "schema",
    "workspaceId",
    "episodicTotal",
    "sessions",
    "openLoops",
    "staleCount",
    "nearbyStores",
    "nextCommands"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "const": "ee.resume.v1"
    },
    "workspaceId": {
      "type": "string"
    },
    "episodicTotal": {
      "type": "integer",
      "minimum": 0
    },
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "memberCount", "newestAt", "oldestAt", "items"],
        "additionalProperties": false,
        "properties": {
          "label": { "type": "string" },
          "memberCount": { "type": "integer", "minimum": 1 },
          "newestAt": { "type": "string" },
          "oldestAt": { "type": "string" },
          "items": {
            "type": "array",
            "items": { "$ref": "#/$defs/item" }
          }
        }
      }
    },
    "openLoops": {
      "type": "object",
      "required": [
        "revisitDecisionsTotal",
        "revisitDecisionsTruncated",
        "revisitDecisions",
        "taggedItemsTotal",
        "taggedItemsTruncated",
        "taggedItems"
      ],
      "additionalProperties": false,
      "properties": {
        "revisitDecisionsTotal": {
          "type": "integer",
          "minimum": 0,
          "description": "Exact count of current decisions carrying a revisit condition before output bounding."
        },
        "revisitDecisionsTruncated": { "type": "boolean" },
        "revisitDecisions": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": [
              "memoryId",
              "topic",
              "chosen",
              "revisitBy",
              "revisitStatus",
              "createdAt"
            ],
            "additionalProperties": false,
            "properties": {
              "memoryId": { "type": "string" },
              "topic": { "type": "string" },
              "chosen": { "type": "string" },
              "revisitBy": { "type": ["string", "null"] },
              "revisitStatus": { "type": "string" },
              "createdAt": { "type": "string" }
            }
          }
        },
        "taggedItemsTotal": {
          "type": "integer",
          "minimum": 0,
          "description": "Exact count of current next/queue/blocking/pending/todo-tagged memories before output bounding."
        },
        "taggedItemsTruncated": { "type": "boolean" },
        "taggedItems": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/item" }
        }
      }
    },
    "staleCount": {
      "type": "integer",
      "minimum": 0
    },
    "nearbyStores": {
      "type": ["object", "null"],
      "description": "Populated only when the store has nothing episodic; reuses the orient nearby-store scan shape.",
      "required": ["stores", "truncated"],
      "properties": {
        "stores": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["workspaceRoot", "storeDir", "documents", "lastWrite"],
            "properties": {
              "workspaceRoot": { "type": "string" },
              "storeDir": { "type": "string" },
              "documents": { "type": "integer", "minimum": 0 },
              "lastWrite": { "type": ["string", "null"] }
            }
          }
        },
        "truncated": { "type": "boolean" }
      }
    },
    "nextCommands": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": [
        "memoryId",
        "level",
        "kind",
        "content",
        "tags",
        "createdAt",
        "selectionReason",
        "provenance",
        "redaction",
        "stale"
      ],
      "additionalProperties": false,
      "properties": {
        "memoryId": { "type": "string" },
        "level": { "type": "string" },
        "kind": { "type": "string" },
        "content": { "type": "string" },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "createdAt": { "type": "string" },
        "selectionReason": {
          "type": "string",
          "enum": ["recent_session_member", "open_loop_tag"],
          "description": "Why this memory was admitted to the bounded resume view."
        },
        "provenance": {
          "type": "object",
          "required": ["uri", "trustClass", "verificationStatus"],
          "additionalProperties": false,
          "properties": {
            "uri": {
              "type": ["string", "null"],
              "description": "Public-redacted provenance URI; unsafe path/token-bearing values are replaced by a deterministic marker."
            },
            "trustClass": { "type": "string" },
            "verificationStatus": { "type": "string" }
          }
        },
        "redaction": {
          "type": "object",
          "required": ["applied", "reasons"],
          "additionalProperties": false,
          "properties": {
            "applied": { "type": "boolean" },
            "reasons": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "stale": {
          "type": ["object", "null"],
          "required": ["supersededBy", "supersededByCreatedAt", "sharedTags"],
          "additionalProperties": false,
          "properties": {
            "supersededBy": { "type": "string" },
            "supersededByCreatedAt": { "type": "string" },
            "sharedTags": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
