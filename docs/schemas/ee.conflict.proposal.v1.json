{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eidetic-engine/schemas/ee.conflict.proposal.v1.json",
  "title": "ee.conflict.proposal.v1",
  "description": "A pending, explicit conflict-resolution proposal. Creation persists only a curation candidate and its audit; source memories and the conflict remain unchanged until explicit curation review and application. Repeating the same request against unchanged sources returns the same candidate. Apply revalidates source snapshots and the live conflict under the decision writer transaction, then commits all resolution effects and candidate completion atomically.",
  "type": "object",
  "required": ["schema", "status", "candidateId", "candidateStatus", "dryRun", "persisted", "created", "plan", "nextCommands"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "ee.conflict.proposal.v1"},
    "status": {"const": "proposed"},
    "candidateId": {"type": "string", "pattern": "^curate_[A-Za-z0-9]{26}$"},
    "candidateStatus": {"type": "string", "enum": ["pending", "approved", "rejected", "applied", "expired"]},
    "dryRun": {"const": false},
    "persisted": {"const": true},
    "created": {"type": "boolean", "description": "False when the identical durable proposal already exists; no duplicate candidate or create audit is inserted."},
    "nextCommands": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "plan": {
      "type": "object",
      "required": ["conflictId", "verb", "memoryA", "memoryB", "keep", "lose", "actions"],
      "additionalProperties": false,
      "properties": {
        "conflictId": {"type": "string"},
        "verb": {"type": "string", "enum": ["supersede", "reject-one", "scope-split", "both-valid"]},
        "memoryA": {"type": "string"},
        "memoryB": {"type": "string"},
        "keep": {"type": ["string", "null"]},
        "lose": {"type": ["string", "null"]},
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["action"],
            "properties": {
              "action": {"type": "string", "enum": ["recordDecision", "tombstoneMemory", "createLink", "addTags"]}
            }
          }
        }
      }
    }
  }
}
