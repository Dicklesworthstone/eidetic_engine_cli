{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eidetic-engine/schemas/ee.conflict.resolve.v1.json",
  "title": "ee.conflict.resolve.v1",
  "description": "Audited conflict-resolution report for ee conflict resolve (ADR 0066). Dry-run is the default. Under --apply, the writer revalidates the complete plan against the live conflict surface and source authority, then commits all effects, rationale, provenance, audit and durable index work in one transaction. Supersede retires the losing revision; reject-one tombstones it; scope-split and both-valid preserve both sources. A canonical completion audit settles the pair for both the conflict surface and pack guard. Failed or stale plans persist no partial resolution.",
  "type": "object",
  "required": ["schema", "status", "dryRun", "persisted", "verb", "reason", "plan"],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "const": "ee.conflict.resolve.v1"
    },
    "status": {
      "type": "string",
      "enum": ["planned", "applied"]
    },
    "dryRun": {
      "type": "boolean"
    },
    "persisted": {
      "type": "boolean"
    },
    "verb": {
      "type": "string",
      "enum": ["supersede", "reject-one", "scope-split", "both-valid"]
    },
    "reason": {
      "type": "string"
    },
    "plan": {
      "type": "object",
      "required": ["conflictId", "verb", "memoryA", "memoryB", "keep", "lose", "actions"],
      "additionalProperties": false,
      "properties": {
        "conflictId": {
          "type": "string"
        },
        "verb": {
          "type": "string",
          "enum": ["supersede", "reject-one", "scope-split", "both-valid"]
        },
        "memoryA": {
          "type": "string"
        },
        "memoryB": {
          "type": "string"
        },
        "keep": {
          "type": ["string", "null"]
        },
        "lose": {
          "type": ["string", "null"]
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["action"],
            "properties": {
              "action": {
                "type": "string",
                "enum": ["recordDecision", "tombstoneMemory", "createLink", "addTags"]
              }
            }
          }
        }
      }
    },
    "results": {
      "type": ["array", "null"],
      "description": "Per-atom execution evidence; null on dry-run.",
      "items": {
        "type": "object",
        "required": ["action", "auditIds", "createdMemoryId"],
        "additionalProperties": false,
        "properties": {
          "action": {
            "type": "string"
          },
          "auditIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "createdMemoryId": {
            "type": ["string", "null"]
          }
        }
      }
    }
  }
}
