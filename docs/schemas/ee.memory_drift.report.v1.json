{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eidetic-engine/schemas/ee.memory_drift.report.v1.json",
  "title": "ee.memory_drift.report.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "mode",
    "generatedAt",
    "summary",
    "items",
    "recoveryActions",
    "degraded"
  ],
  "properties": {
    "schema": {
      "const": "ee.memory_drift.report.v1"
    },
    "mode": {
      "description": "Report scope. recent_pack_items validates integrity-bound pack-ledger timestamps, includes the exact seven-day boundary, and fails closed on scan truncation, malformed/future timestamps, or ambiguous revision lineage.",
      "type": "string",
      "enum": ["all_memories", "one_memory", "recent_pack_items"]
    },
    "generatedAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "totalMemories",
        "current",
        "changed",
        "missingSource",
        "staleAnchor",
        "unverifiable",
        "suppressed"
      ],
      "properties": {
        "totalMemories": {
          "type": "integer",
          "minimum": 0
        },
        "current": {
          "type": "integer",
          "minimum": 0
        },
        "changed": {
          "type": "integer",
          "minimum": 0
        },
        "missingSource": {
          "type": "integer",
          "minimum": 0
        },
        "staleAnchor": {
          "type": "integer",
          "minimum": 0
        },
        "unverifiable": {
          "type": "integer",
          "minimum": 0
        },
        "suppressed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "items": {
      "description": "Revision-chain-deduplicated findings for recent_pack_items mode; a newer selection of the unique live revision supersedes an older selection of a historical revision.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/selectionHint"
      }
    },
    "recoveryActions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/recoveryAction"
      }
    },
    "degraded": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/degraded"
      }
    }
  },
  "$defs": {
    "selectionHint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memoryId",
        "driftStatus",
        "topReason",
        "evidenceCount",
        "revalidationCommand",
        "degradedCode",
        "severity",
        "freshness",
        "staleAnchor",
        "capturedAtCommit",
        "currentCommit",
        "commitDistance",
        "changedRegions",
        "anchors"
      ],
      "properties": {
        "memoryId": {
          "type": "string",
          "minLength": 1
        },
        "driftStatus": {
          "type": "string",
          "enum": [
            "current",
            "changed",
            "missing_source",
            "stale_anchor",
            "unverifiable",
            "suppressed"
          ]
        },
        "topReason": {
          "type": "string",
          "minLength": 1
        },
        "evidenceCount": {
          "type": "integer",
          "minimum": 0
        },
        "revalidationCommand": {
          "type": "string",
          "minLength": 1
        },
        "degradedCode": {
          "type": ["string", "null"]
        },
        "severity": {
          "type": "string",
          "enum": ["info", "low", "warning", "medium", "high", "critical"]
        },
        "freshness": {
          "type": "string",
          "minLength": 1
        },
        "staleAnchor": {
          "type": "boolean"
        },
        "capturedAtCommit": {
          "type": ["string", "null"]
        },
        "currentCommit": {
          "type": ["string", "null"]
        },
        "commitDistance": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "changedRegions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "anchors": {
          "type": "array",
          "items": { "$ref": "#/$defs/codeAnchor" }
        }
      }
    },
    "codeAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anchorKind",
        "anchorValueHash",
        "redactedAnchorValue",
        "capturedSpanHash",
        "freshnessState",
        "freshness",
        "generation",
        "staleAnchor"
      ],
      "properties": {
        "anchorKind": { "type": "string", "minLength": 1 },
        "anchorValueHash": { "type": "string", "minLength": 1 },
        "redactedAnchorValue": { "type": "string" },
        "capturedSpanHash": { "type": "string", "minLength": 1 },
        "freshnessState": { "type": "string", "minLength": 1 },
        "freshness": { "type": "string", "minLength": 1 },
        "generation": { "type": "integer" },
        "staleAnchor": { "type": "boolean" }
      }
    },
    "recoveryAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["priority", "kind", "command", "description"],
      "properties": {
        "priority": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "rerun_source_validation",
            "revise_memory",
            "mark_source_unavailable",
            "ignore_with_audit"
          ]
        },
        "command": {
          "type": ["string", "null"]
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "degraded": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message"],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
