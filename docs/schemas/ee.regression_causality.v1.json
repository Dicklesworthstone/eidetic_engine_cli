{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eidetic-engine/schemas/ee.regression_causality.v1.json",
  "title": "ee.regression_causality.v1",
  "description": "Redaction-safe regression causality capsule for explaining why a verification, replay, pack, performance, tracker, or support-bundle gate appears to have failed now. The capsule carries compact evidence summaries and ranked deterministic hypotheses. Hypotheses are diagnostic leads, not proof, and raw logs, raw memory bodies, raw mail bodies, private paths, and secrets are forbidden.",
  "type": "object",
  "required": [
    "schema",
    "subject",
    "sourceState",
    "evidenceSources",
    "hypotheses",
    "redaction",
    "degraded",
    "nextCommands"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "const": "ee.regression_causality.v1"
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "sourceState": {
      "$ref": "#/$defs/sourceState"
    },
    "evidenceSources": {
      "type": "array",
      "description": "Accepted input artifacts, normalized to compact redaction-safe summaries.",
      "items": {
        "$ref": "#/$defs/evidenceSource"
      }
    },
    "hypotheses": {
      "type": "array",
      "description": "Deterministically ranked cause hypotheses. These are derived diagnostic leads and must not be treated as authoritative evidence.",
      "items": {
        "$ref": "#/$defs/hypothesis"
      }
    },
    "redaction": {
      "$ref": "#/$defs/redaction"
    },
    "degraded": {
      "type": "array",
      "description": "Capsule-generation degradations that affected this report.",
      "items": {
        "$ref": "#/$defs/degradedEntry"
      }
    },
    "nextCommands": {
      "type": "array",
      "description": "Read-only follow-up commands for deeper inspection. Heavy Rust commands must be routed through RCH by callers.",
      "items": {
        "$ref": "#/$defs/command"
      }
    }
  },
  "field_presets": {
    "minimal": [
      "schema",
      "subject",
      "hypotheses"
    ],
    "summary": [
      "schema",
      "subject",
      "sourceState",
      "evidenceSources",
      "hypotheses",
      "degraded",
      "nextCommands"
    ],
    "standard": [
      "schema",
      "subject",
      "sourceState",
      "evidenceSources",
      "hypotheses",
      "redaction",
      "degraded",
      "nextCommands"
    ],
    "full": [
      "*"
    ]
  },
  "examples": [
    {
      "schema": "ee.regression_causality.v1",
      "subject": {
        "surface": "verification_gate",
        "artifactKind": "rch_verify",
        "artifactId": "artifact:rch-verify-abc123",
        "commandHash": "blake3:1111111111111111",
        "observedAt": "2026-06-04T01:00:00Z",
        "workspaceHash": "blake3:2222222222222222"
      },
      "sourceState": {
        "materialization": "remote_checkout_unverified",
        "verificationAttribution": "local_checkout_observed_remote_source_unknown",
        "localDirty": true,
        "remoteSourceMaterialized": null,
        "sourceHash": null,
        "degradedCodes": [
          "rch_verify_remote_source_unknown"
        ]
      },
      "evidenceSources": [
        {
          "id": "evidence:rch",
          "kind": "verification_evidence",
          "schema": "ee.verification_evidence.v1",
          "status": "available",
          "artifactHash": "blake3:3333333333333333",
          "summary": "RCH proof reports an environment blocker before a source-materialized verdict.",
          "redactionStatus": "safe",
          "authoritative": true
        },
        {
          "id": "evidence:beads",
          "kind": "beads_history",
          "schema": null,
          "status": "available",
          "artifactHash": "blake3:4444444444444444",
          "summary": "Tracker history links the failing gate to an in-progress verification bead.",
          "redactionStatus": "hash_only",
          "authoritative": true
        }
      ],
      "hypotheses": [
        {
          "rank": 1,
          "code": "source_not_materialized",
          "confidence": 0.84,
          "severity": "high",
          "summary": "The failing gate cannot yet be used as a source verdict because remote source materialization was not proven.",
          "evidenceRefs": [
            "evidence:rch"
          ],
          "counterEvidence": [
            {
              "sourceId": "evidence:beads",
              "summary": "The tracker confirms the intended bead, but does not prove the remote source tree.",
              "effect": "weakens"
            }
          ],
          "ownerHints": [
            {
              "kind": "bead",
              "value": "bd-ppbue.18",
              "confidence": 0.72
            }
          ],
          "nextCommands": [
            {
              "command": "RCH_REQUIRE_REMOTE=1 ./scripts/rch_verify.sh --bead-id bd-ppbue.18 --summary --no-write -- cargo test --test contracts regression_causality_schema -- --nocapture",
              "rationale": "Rerun the focused proof through the remote verifier and inspect the source-state capsule.",
              "mutatesWorkspace": false,
              "requiresRch": true
            }
          ],
          "authoritative": false
        }
      ],
      "redaction": {
        "rawLogsPresent": false,
        "rawMailBodiesPresent": false,
        "rawMemoryBodiesPresent": false,
        "privatePathsPresent": false,
        "secretScanApplied": true,
        "truncationApplied": true,
        "hashesOnly": true
      },
      "degraded": [
        {
          "code": "source_state_incomplete",
          "severity": "warning",
          "message": "Remote source materialization was not available in the input evidence.",
          "evidenceSourceId": "evidence:rch"
        }
      ],
      "nextCommands": [
        {
          "command": "br show bd-ppbue.18 --json",
          "rationale": "Inspect the owning verification bead before changing source code.",
          "mutatesWorkspace": false,
          "requiresRch": false
        }
      ]
    }
  ],
  "$defs": {
    "subject": {
      "type": "object",
      "required": [
        "surface",
        "artifactKind",
        "artifactId",
        "commandHash",
        "observedAt",
        "workspaceHash"
      ],
      "additionalProperties": false,
      "properties": {
        "surface": {
          "type": "string",
          "enum": [
            "verification_gate",
            "swarm_replay",
            "e2e_event_radar",
            "pack_quality",
            "perf_budget",
            "tracker_state",
            "support_bundle",
            "unknown"
          ]
        },
        "artifactKind": {
          "type": "string",
          "description": "Human-readable artifact class such as rch_verify, pack_diff, perf_report, or beads_history."
        },
        "artifactId": {
          "type": [
            "string",
            "null"
          ],
          "description": "Stable artifact id when available; never a host-private absolute path."
        },
        "commandHash": {
          "type": [
            "string",
            "null"
          ],
          "description": "Hash of the triggering command or null when the subject was not command-driven."
        },
        "observedAt": {
          "type": [
            "string",
            "null"
          ],
          "description": "Observation timestamp from the input artifact when already present; generators should avoid inventing wall-clock values."
        },
        "workspaceHash": {
          "type": [
            "string",
            "null"
          ],
          "description": "Hash or fingerprint of the workspace identity; never an absolute checkout path."
        }
      }
    },
    "sourceState": {
      "type": "object",
      "required": [
        "materialization",
        "verificationAttribution",
        "localDirty",
        "remoteSourceMaterialized",
        "sourceHash",
        "degradedCodes"
      ],
      "additionalProperties": false,
      "properties": {
        "materialization": {
          "type": "string",
          "enum": [
            "committed_tree",
            "dirty_source_materialized",
            "remote_checkout_unverified",
            "source_state_refused",
            "not_applicable",
            "unknown"
          ]
        },
        "verificationAttribution": {
          "type": [
            "string",
            "null"
          ],
          "description": "Compact attribution string from verification evidence, or null when unavailable."
        },
        "localDirty": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Whether the local checkout was dirty according to the source evidence."
        },
        "remoteSourceMaterialized": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "True only when the remote worker source tree was proven to match the intended source input."
        },
        "sourceHash": {
          "type": [
            "string",
            "null"
          ],
          "description": "Commit, tree, dirty-status, or source-package hash when available."
        },
        "degradedCodes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "evidenceSource": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "schema",
        "status",
        "artifactHash",
        "summary",
        "redactionStatus",
        "authoritative"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Capsule-local evidence id used by hypotheses and degraded entries."
        },
        "kind": {
          "type": "string",
          "enum": [
            "verification_evidence",
            "rch_selector_admission",
            "swarm_replay",
            "e2e_event_log",
            "pack_replay",
            "pack_diff",
            "perf_report",
            "beads_history",
            "bv_history",
            "degraded_fixture",
            "git_metadata",
            "support_bundle"
          ]
        },
        "schema": {
          "type": [
            "string",
            "null"
          ],
          "description": "Input schema id when the artifact is schema-versioned."
        },
        "status": {
          "type": "string",
          "enum": [
            "available",
            "missing",
            "malformed",
            "stale",
            "blocked",
            "unsupported",
            "redacted_only"
          ]
        },
        "artifactHash": {
          "type": [
            "string",
            "null"
          ],
          "description": "Hash of the source artifact or null when unavailable."
        },
        "summary": {
          "type": "string",
          "description": "Short redaction-safe evidence summary. Never raw command output."
        },
        "redactionStatus": {
          "type": "string",
          "enum": [
            "safe",
            "redacted",
            "hash_only",
            "refused",
            "unknown"
          ]
        },
        "authoritative": {
          "type": "boolean",
          "description": "True when this entry is direct evidence from an input artifact; false for derived summaries."
        }
      }
    },
    "hypothesis": {
      "type": "object",
      "required": [
        "rank",
        "code",
        "confidence",
        "severity",
        "summary",
        "evidenceRefs",
        "counterEvidence",
        "ownerHints",
        "nextCommands",
        "authoritative"
      ],
      "additionalProperties": false,
      "properties": {
        "rank": {
          "type": "integer",
          "minimum": 1
        },
        "code": {
          "type": "string",
          "enum": [
            "source_not_materialized",
            "schema_contract_drift",
            "stale_derived_asset",
            "known_environment_blocker",
            "output_budget_regression",
            "fixture_gap",
            "pack_selection_change",
            "perf_budget_regression",
            "tracker_state_mismatch",
            "unknown_insufficient_evidence"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "severity": {
          "$ref": "#/$defs/severity"
        },
        "summary": {
          "type": "string"
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "counterEvidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/counterEvidence"
          }
        },
        "ownerHints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ownerHint"
          }
        },
        "nextCommands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/command"
          }
        },
        "authoritative": {
          "type": "boolean",
          "const": false,
          "description": "Hypotheses are derived leads and must remain non-authoritative."
        }
      }
    },
    "counterEvidence": {
      "type": "object",
      "required": [
        "sourceId",
        "summary",
        "effect"
      ],
      "additionalProperties": false,
      "properties": {
        "sourceId": {
          "type": [
            "string",
            "null"
          ]
        },
        "summary": {
          "type": "string"
        },
        "effect": {
          "type": "string",
          "enum": [
            "supports",
            "weakens",
            "neutral",
            "missing_required_source"
          ]
        }
      }
    },
    "ownerHint": {
      "type": "object",
      "required": [
        "kind",
        "value",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "bead",
            "agent",
            "module",
            "command",
            "unknown"
          ]
        },
        "value": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "command": {
      "type": "object",
      "required": [
        "command",
        "rationale",
        "mutatesWorkspace",
        "requiresRch"
      ],
      "additionalProperties": false,
      "properties": {
        "command": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        },
        "mutatesWorkspace": {
          "type": "boolean",
          "const": false
        },
        "requiresRch": {
          "type": "boolean"
        }
      }
    },
    "redaction": {
      "type": "object",
      "required": [
        "rawLogsPresent",
        "rawMailBodiesPresent",
        "rawMemoryBodiesPresent",
        "privatePathsPresent",
        "secretScanApplied",
        "truncationApplied",
        "hashesOnly"
      ],
      "additionalProperties": false,
      "properties": {
        "rawLogsPresent": {
          "type": "boolean",
          "const": false
        },
        "rawMailBodiesPresent": {
          "type": "boolean",
          "const": false
        },
        "rawMemoryBodiesPresent": {
          "type": "boolean",
          "const": false
        },
        "privatePathsPresent": {
          "type": "boolean",
          "const": false
        },
        "secretScanApplied": {
          "type": "boolean",
          "const": true
        },
        "truncationApplied": {
          "type": "boolean"
        },
        "hashesOnly": {
          "type": "boolean"
        }
      }
    },
    "degradedEntry": {
      "type": "object",
      "required": [
        "code",
        "severity",
        "message",
        "evidenceSourceId"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/severity"
        },
        "message": {
          "type": "string"
        },
        "evidenceSourceId": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "low",
        "warning",
        "medium",
        "high",
        "critical"
      ]
    }
  }
}
