{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eidetic-engine/schemas/ee.ask.v1.json",
  "title": "ee.ask.v1",
  "description": "Deterministic extractive question answering with citations and honest abstention (ADR 0067). Carried under ee.response.v2 data. Every emitted answer sentence byte-equals its cited stored source. Memories retain memoryId; native procedural rules use typed identity and revision, never a memory alias.",
  "x-ee-status": "shipped:true",
  "x-ee-bead": "bd-169v0.1",
  "type": "object",
  "required": ["schema", "question", "abstained", "confidence", "confidenceCalibration", "confidenceComponents", "citations"],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "ee.ask.v1",
      "description": "Schema identifier."
    },
    "question": {
      "type": "string",
      "description": "The question echoed back verbatim."
    },
    "abstained": {
      "type": "boolean",
      "description": "True when confidence < min_confidence (or corpus empty). Abstention is a SUCCESS response (exit 0), not an error. Exit 6 only under --require-confidence."
    },
    "answerText": {
      "type": ["string", "null"],
      "description": "The composed extractive answer with [n] citation markers. Null when abstained or conflict_detected. Every sentence byte-equals a cited span."
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Overall confidence: top_span_score × corroboration × (1 − contradiction_penalty), clamped to [0,1]."
    },
    "confidenceCalibration": {
      "type": "object",
      "required": ["status", "calibrated", "scoreKind", "calibrationId"],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "const": "heuristic_uncalibrated",
          "description": "The ask score is a deterministic ranking/admission heuristic, not an empirically calibrated probability."
        },
        "calibrated": {
          "type": "boolean",
          "const": false
        },
        "scoreKind": {
          "type": "string",
          "const": "ask_span_heuristic_v1",
          "description": "Stable identity for the scoring rule that produced confidence."
        },
        "calibrationId": {
          "type": "null",
          "description": "No fitted calibration artifact is active for ask confidence."
        }
      }
    },
    "confidenceComponents": {
      "type": "object",
      "required": ["topSpanScore", "corroboration", "contradictionPenalty"],
      "additionalProperties": false,
      "properties": {
        "topSpanScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Score of the highest-scoring cluster representative after corroboration."
        },
        "corroboration": {
          "type": "number",
          "minimum": 1,
          "maximum": 1.3,
          "description": "Corroboration multiplier: 1 + 0.1·ln(cluster_size), capped at 1.3."
        },
        "contradictionPenalty": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Penalty applied when top clusters oppose each other (0 = no conflict)."
        }
      }
    },
    "citations": {
      "type": "array",
      "description": "Per-span citations; parallel to the [n] markers in answerText. Empty when abstained.",
      "items": {
        "$ref": "#/$defs/citation"
      }
    },
    "sides": {
      "type": ["array", "null"],
      "description": "Present in conflict mode. Each side is a self-contained extractive answer with its own citations.",
      "items": {
        "$ref": "#/$defs/side"
      }
    },
    "nearestEvidence": {
      "type": ["array", "null"],
      "description": "Present when abstained. Top sub-threshold spans. Governor truncation point (ADR 0063).",
      "items": {
        "$ref": "#/$defs/nearestEvidence"
      }
    },
    "counterfactualHint": {
      "type": ["string", "null"],
      "description": "Human-readable abstention reason mirroring why-not phrasing."
    },
    "candidatesScanned": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of admitted memory and native-rule candidates examined by the engine."
    },
    "_semanticDegraded": {
      "type": "boolean",
      "description": "True when the hash-embedder fallback was used (w2 renormalized into w1). Corresponds to the ask_semantic_degraded degradation code in the envelope."
    },
    "_conflictDetected": {
      "type": "boolean",
      "description": "True when the top evidence clusters oppose each other. Corresponds to ask_conflicting_evidence in the envelope."
    },
    "conflictLink": {
      "type": "object",
      "required": ["id", "srcMemoryId", "dstMemoryId", "confidence", "source"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "srcMemoryId": {"type": "string"},
        "dstMemoryId": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "source": {"type": "string", "enum": ["human", "agent"]}
      }
    },
    "queryAssist": {
      "$ref": "#/$defs/queryAssist",
      "description": "Deterministic query-assist guidance emitted when ask abstains."
    }
  },
  "field_presets": {
    "minimal": [
      "schema",
      "question",
      "abstained",
      "answerText",
      "confidence",
      "confidenceCalibration",
      "citations"
    ],
    "summary": [
      "schema",
      "question",
      "abstained",
      "answerText",
      "confidence",
      "confidenceCalibration",
      "confidenceComponents",
      "citations",
      "candidatesScanned",
      "nearestEvidence",
      "counterfactualHint",
      "queryAssist"
    ],
    "standard": [
      "schema",
      "question",
      "abstained",
      "answerText",
      "confidence",
      "confidenceCalibration",
      "confidenceComponents",
      "citations",
      "sides",
      "nearestEvidence",
      "counterfactualHint",
      "candidatesScanned",
      "queryAssist"
    ],
    "full": ["*"]
  },
  "$defs": {
    "sourceIdentity": {
      "description": "A native entity is never represented as a memory. Entity and kind-specific IDs must identify the same stored source; the engine validates their equality.",
      "oneOf": [
        {
          "required": ["memoryId"],
          "not": {"anyOf": [{"required": ["entityKind"]}, {"required": ["entityId"]}, {"required": ["entityRevision"]}, {"required": ["ruleId"]}, {"required": ["evidenceId"]}]}
        },
        {
          "required": ["entityKind", "entityId", "ruleId", "entityRevision"],
          "properties": {"entityKind": {"const": "rule"}},
          "not": {"anyOf": [{"required": ["memoryId"]}, {"required": ["evidenceId"]}]}
        },
        {
          "required": ["entityKind", "entityId", "evidenceId", "entityRevision"],
          "properties": {"entityKind": {"const": "evidence_span"}},
          "not": {"anyOf": [{"required": ["memoryId"]}, {"required": ["ruleId"]}]}
        }
      ]
    },
    "span": {
      "type": "object",
      "required": ["byteStart", "byteEnd"],
      "additionalProperties": false,
      "properties": {
        "byteStart": {
          "type": "integer",
          "minimum": 0,
          "description": "Inclusive byte offset in the stored memory content."
        },
        "byteEnd": {
          "type": "integer",
          "minimum": 0,
          "description": "Exclusive byte offset in the stored memory content."
        }
      }
    },
    "citation": {
      "type": "object",
      "required": ["index", "span", "text", "trustClass", "confidence"],
      "allOf": [{"$ref": "#/$defs/sourceIdentity"}],
      "additionalProperties": false,
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 1,
          "description": "The [n] marker in answerText."
        },
        "memoryId": {
          "type": "string",
          "description": "ID of the source memory."
        },
        "entityKind": {"type": "string", "enum": ["rule", "evidence_span"]},
        "entityId": {"type": "string"},
        "ruleId": {"type": "string", "pattern": "^rule_"},
        "evidenceId": {"type": "string", "pattern": "^ev_"},
        "entityRevision": {"type": "string", "pattern": "^blake3:[0-9a-f]{64}$"},
        "span": {
          "$ref": "#/$defs/span",
          "description": "Byte range in the source memory. text MUST byte-equal content[byteStart:byteEnd]."
        },
        "text": {
          "type": "string",
          "description": "Byte-equal copy of the cited span. Verifiable by byte comparison against the source memory."
        },
        "provenanceUri": {
          "type": ["string", "null"],
          "description": "Provenance URI of the source memory."
        },
        "trustClass": {
          "type": "string",
          "enum": ["human_explicit", "peer_human_attested", "agent_validated", "agent_assertion", "cass_evidence", "legacy_import"],
          "description": "Trust class of the source memory."
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Confidence of the source memory."
        },
        "teamProvenance": {
          "type": "object",
          "description": "Receiver-derived teammate attribution for a peer_human_attested citation. Same ee.team.provenance.v1 block search and pack emit.",
          "additionalProperties": true,
          "properties": {
            "schema": {"type": "string", "const": "ee.team.provenance.v1"},
            "memberDisplayName": {"type": "string"},
            "projectName": {"type": ["string", "null"]},
            "originTrustClass": {"type": "string"},
            "producedAt": {"type": "string"},
            "originTimeAssurance": {"type": "string"}
          }
        }
      }
    },
    "side": {
      "type": "object",
      "required": ["label", "answerText", "citations"],
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "enum": ["affirming", "negating", "query_match", "linked_opposition"],
          "description": "Which side of the conflict this represents."
        },
        "answerText": {
          "type": "string",
          "description": "Extractive answer for this side with [n] citation markers."
        },
        "citations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citation"
          }
        }
      }
    },
    "nearestEvidence": {
      "type": "object",
      "required": ["span", "text", "score"],
      "allOf": [{"$ref": "#/$defs/sourceIdentity"}],
      "additionalProperties": false,
      "properties": {
        "memoryId": {
          "type": "string"
        },
        "entityKind": {"type": "string", "enum": ["rule", "evidence_span"]},
        "entityId": {"type": "string"},
        "ruleId": {"type": "string", "pattern": "^rule_"},
        "evidenceId": {"type": "string", "pattern": "^ev_"},
        "entityRevision": {"type": "string", "pattern": "^blake3:[0-9a-f]{64}$"},
        "span": {
          "$ref": "#/$defs/span"
        },
        "text": {
          "type": "string"
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "queryAssist": {
      "type": "object",
      "required": ["schema", "weakResultReason", "reformulations", "didYouMean", "captureTemplate"],
      "additionalProperties": true,
      "properties": {
        "schema": {
          "type": "string",
          "const": "ee.query_assist.v1"
        },
        "weakResultReason": {
          "type": "string"
        },
        "reformulations": {
          "type": "array"
        },
        "didYouMean": {
          "type": "array"
        },
        "captureTemplate": {
          "type": "object"
        }
      }
    }
  }
}
