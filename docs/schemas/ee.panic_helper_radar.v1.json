{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eidetic-engine.local/schemas/ee.panic_helper_radar.v1.json",
  "title": "Panic Helper Radar Report",
  "description": "Cargo-free report for touched Rust .expect* / .unwrap* panic-helper usage.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generatedAt",
    "verdict",
    "summary",
    "violations",
    "skipped"
  ],
  "properties": {
    "schema": {
      "const": "ee.panic_helper_radar.v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "pass",
        "fail"
      ]
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "violations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/violation"
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/skipped"
      }
    }
  },
  "$defs": {
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scannedFileCount",
        "violationCount",
        "skippedCount",
        "scannedPaths"
      ],
      "properties": {
        "scannedFileCount": {
          "type": "integer",
          "minimum": 0
        },
        "violationCount": {
          "type": "integer",
          "minimum": 0
        },
        "skippedCount": {
          "type": "integer",
          "minimum": 0
        },
        "scannedPaths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "violation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "line",
        "helper",
        "lint",
        "text"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "helper": {
          "type": "string",
          "enum": [
            "expect",
            "expect_err",
            "unwrap",
            "unwrap_err"
          ]
        },
        "lint": {
          "type": "string",
          "enum": [
            "expect_used",
            "unwrap_used"
          ]
        },
        "text": {
          "type": "string"
        }
      }
    },
    "skipped": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "reason"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "enum": [
            "missing",
            "not_regular_file",
            "not_rust_file"
          ]
        }
      }
    }
  }
}
