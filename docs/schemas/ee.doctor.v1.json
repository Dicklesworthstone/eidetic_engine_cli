{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eidetic-engine/schemas/ee.doctor.v1.json",
  "title": "ee.doctor.v1",
  "description": "ee doctor response envelope.",
  "type": "object",
  "required": ["schema", "success", "data"],
  "additionalProperties": false,
  "properties": {
    "schema": {"type": "string", "const": "ee.response.v2"},
    "success": {"type": "boolean"},
    "fields": {"type": "string"},
    "degraded": {"type": "array", "items": {"type": "object"}},
    "data": {
      "type": "object",
      "required": ["command", "version", "posture", "healthy", "singleFlight", "flightRecorder", "qos", "rchWorkerPressure", "verificationPosture", "verificationLedger", "hostCalibration", "meshAutoEnrollment", "advisories", "checks"],
      "additionalProperties": false,
      "properties": {
        "command": {"type": "string", "const": "doctor"},
        "version": {"type": "string"},
        "posture": {"type": "string"},
        "healthy": {"type": "boolean"},
        "singleFlight": {"$ref": "#/$defs/singleFlightPosture"},
        "flightRecorder": {"type": "object", "additionalProperties": true},
        "qos": {"$ref": "#/$defs/qosStatus"},
        "rchWorkerPressure": {"$ref": "#/$defs/rchWorkerPressure"},
        "verificationPosture": {"$ref": "#/$defs/verificationPosture"},
        "verificationLedger": {"$ref": "#/$defs/verificationLedger"},
        "hostCalibration": {"type": "object", "additionalProperties": true},
        "meshAutoEnrollment": {"$ref": "#/$defs/meshAutoEnrollment"},
        "advisories": {
          "type": "array",
          "items": {"$ref": "#/$defs/doctorCheck"}
        },
        "checks": {
          "type": "array",
          "items": {"$ref": "#/$defs/doctorCheck"}
        }
      }
    }
  },
  "field_presets": {
    "minimal": ["command", "version", "posture", "healthy"],
    "summary": ["command", "version", "posture", "healthy", "qos"],
    "standard": ["command", "version", "posture", "healthy", "checks", "qos"],
    "full": ["*"]
  },
  "$defs": {
    "singleFlightStatus": {
      "type": "string",
      "enum": ["idle", "active", "observed_failures", "state_poisoned", "unconfigured"]
    },
    "doctorCheck": {
      "type": "object",
      "required": ["name", "tier", "severity", "message"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "tier": {"type": "string", "enum": ["core", "advisory"]},
        "severity": {"type": "string", "enum": ["ok", "warning", "error"]},
        "message": {"type": "string"},
        "errorCode": {"type": "string"},
        "repair": {"type": "string"}
      }
    },
    "qosStatus": {
      "type": "object",
      "required": [
        "schema",
        "workspaceHash",
        "foregroundActiveCount",
        "backgroundActiveCount",
        "verificationActiveCount",
        "maintenanceActiveCount",
        "staleIgnoredCount",
        "foregroundPressure",
        "backgroundWorkActive",
        "registryHealthy",
        "degraded"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {"type": "string", "const": "ee.qos.active_lane_summary.v1"},
        "workspaceHash": {"type": "string", "minLength": 8},
        "foregroundActiveCount": {"type": "integer", "minimum": 0},
        "backgroundActiveCount": {"type": "integer", "minimum": 0},
        "verificationActiveCount": {"type": "integer", "minimum": 0},
        "maintenanceActiveCount": {"type": "integer", "minimum": 0},
        "staleIgnoredCount": {"type": "integer", "minimum": 0},
        "foregroundPressure": {"type": "boolean"},
        "backgroundWorkActive": {"type": "boolean"},
        "registryHealthy": {"type": "boolean"},
        "activeRecords": {
          "type": "array",
          "items": {"type": "object", "additionalProperties": true}
        },
        "degraded": {
          "type": "array",
          "items": {"type": "object", "additionalProperties": true}
        }
      }
    },
    "singleFlightPosture": {
      "type": "object",
      "required": [
        "schema",
        "status",
        "configuredSurfaceCount",
        "activeLeaderCount",
        "leaderStartCount",
        "followerWaitCount",
        "followerTimeoutCount",
        "leaderFailureCount",
        "reusedResultCount",
        "surfaces"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {"type": "string", "const": "ee.singleflight.posture.v1"},
        "status": {"$ref": "#/$defs/singleFlightStatus"},
        "configuredSurfaceCount": {"type": "integer", "minimum": 0},
        "activeLeaderCount": {"type": "integer", "minimum": 0},
        "leaderStartCount": {"type": "integer", "minimum": 0},
        "followerWaitCount": {"type": "integer", "minimum": 0},
        "followerTimeoutCount": {"type": "integer", "minimum": 0},
        "leaderFailureCount": {"type": "integer", "minimum": 0},
        "reusedResultCount": {"type": "integer", "minimum": 0},
        "surfaces": {
          "type": "array",
          "items": {"$ref": "#/$defs/singleFlightSurfacePosture"}
        }
      }
    },
    "singleFlightSurfacePosture": {
      "type": "object",
      "required": [
        "surface",
        "status",
        "configured",
        "activeLeaderCount",
        "leaderStartCount",
        "completedLeaderCount",
        "followerJoinCount",
        "followerTimeoutCount",
        "leaderFailureCount",
        "reusedResultCount",
        "statePoisonedCount",
        "followerTimeoutMs",
        "lastKey",
        "suggestedAction"
      ],
      "additionalProperties": false,
      "properties": {
        "surface": {
          "type": "string",
          "enum": ["context", "search", "graph_snapshot", "graph_feature_enrichment"]
        },
        "status": {"$ref": "#/$defs/singleFlightStatus"},
        "configured": {"type": "boolean"},
        "activeLeaderCount": {"type": "integer", "minimum": 0},
        "leaderStartCount": {"type": "integer", "minimum": 0},
        "completedLeaderCount": {"type": "integer", "minimum": 0},
        "followerJoinCount": {"type": "integer", "minimum": 0},
        "followerTimeoutCount": {"type": "integer", "minimum": 0},
        "leaderFailureCount": {"type": "integer", "minimum": 0},
        "reusedResultCount": {"type": "integer", "minimum": 0},
        "statePoisonedCount": {"type": "integer", "minimum": 0},
        "followerTimeoutMs": {"type": "integer", "minimum": 0},
        "lastKey": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/singleFlightLastKey"}]
        },
        "suggestedAction": {"type": "string", "minLength": 1}
      }
    },
    "singleFlightLastKey": {
      "type": "object",
      "required": ["keyHash", "workspaceGeneration", "indexGeneration", "graphGeneration"],
      "additionalProperties": false,
      "properties": {
        "keyHash": {"type": "string", "minLength": 8},
        "workspaceGeneration": {"type": "integer", "minimum": 0},
        "indexGeneration": {"type": ["integer", "null"], "minimum": 0},
        "graphGeneration": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "verificationPosture": {
      "type": "object",
      "required": ["schema", "status", "windowHours", "recordCount", "recentRunCount", "staleRunCount", "unknownAgeCount", "recentReusableRunCount", "inFlightEquivalentCommandCount", "advisoryCounts", "evidenceHealth", "recoveryActions"],
      "additionalProperties": false,
      "properties": {
        "schema": {"type": "string", "const": "ee.verification.posture.v1"},
        "status": {"type": "string"},
        "windowHours": {"type": "integer", "minimum": 0},
        "recordCount": {"type": "integer", "minimum": 0},
        "recentRunCount": {"type": "integer", "minimum": 0},
        "staleRunCount": {"type": "integer", "minimum": 0},
        "unknownAgeCount": {"type": "integer", "minimum": 0},
        "recentReusableRunCount": {"type": "integer", "minimum": 0},
        "inFlightEquivalentCommandCount": {"type": "integer", "minimum": 0},
        "advisoryCounts": {
          "type": "object",
          "required": ["remoteSuccess", "remoteFailed", "remoteInFlight", "localDisallowed", "topologyBlocked", "missingArtifactManifest"],
          "additionalProperties": false,
          "properties": {
            "remoteSuccess": {"type": "integer", "minimum": 0},
            "remoteFailed": {"type": "integer", "minimum": 0},
            "remoteInFlight": {"type": "integer", "minimum": 0},
            "localDisallowed": {"type": "integer", "minimum": 0},
            "topologyBlocked": {"type": "integer", "minimum": 0},
            "missingArtifactManifest": {"type": "integer", "minimum": 0}
          }
        },
        "evidenceHealth": {
          "type": "object",
          "required": ["ledgerAvailable", "status", "malformedTimestampCount", "missingArtifactManifestCount", "localDisallowedCount", "topologyBlockedCount", "issueCount", "reason"],
          "additionalProperties": false,
          "properties": {
            "ledgerAvailable": {"type": "boolean"},
            "status": {"type": "string"},
            "malformedTimestampCount": {"type": "integer", "minimum": 0},
            "missingArtifactManifestCount": {"type": "integer", "minimum": 0},
            "localDisallowedCount": {"type": "integer", "minimum": 0},
            "topologyBlockedCount": {"type": "integer", "minimum": 0},
            "issueCount": {"type": "integer", "minimum": 0},
            "reason": {"type": ["string", "null"]}
          }
        },
        "recoveryActions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["priority", "kind", "command", "message", "relatedBeadId"],
            "additionalProperties": false,
            "properties": {
              "priority": {"type": "integer", "minimum": 0},
              "kind": {"type": "string"},
              "command": {"type": ["string", "null"]},
              "message": {"type": "string"},
              "relatedBeadId": {"type": ["string", "null"]}
            }
          }
        }
      }
    },
    "verificationLedger": {
      "type": "object",
      "required": ["schema", "status", "ledgerAvailable", "activeBlockerCount", "localFallbackRefused", "localFallbackRefusedCount", "oldestRetryAfter", "newestRetryAfter", "blockerRefs", "recoveryActions"],
      "additionalProperties": false,
      "properties": {
        "schema": {"type": "string", "const": "ee.rch.verify.ledger_status.v1"},
        "status": {"type": "string", "enum": ["not_inspected", "not_initialized", "unavailable", "clear", "active_blockers", "serialization_failed"]},
        "ledgerAvailable": {"type": "boolean"},
        "activeBlockerCount": {"type": "integer", "minimum": 0},
        "localFallbackRefused": {"type": "boolean"},
        "localFallbackRefusedCount": {"type": "integer", "minimum": 0},
        "oldestRetryAfter": {"type": ["string", "null"]},
        "newestRetryAfter": {"type": ["string", "null"]},
        "blockerRefs": {
          "type": "array",
          "maxItems": 8,
          "items": {"$ref": "#/$defs/verificationLedgerBlockerRef"}
        },
        "recoveryActions": {
          "type": "array",
          "items": {"$ref": "#/$defs/verificationLedgerRecoveryAction"}
        }
      }
    },
    "verificationLedgerBlockerRef": {
      "type": "object",
      "required": ["commandHash", "status", "blockerFingerprint", "remediationBead", "retryAfter", "degradedCodes", "verificationAttribution"],
      "additionalProperties": false,
      "properties": {
        "commandHash": {"type": "string", "minLength": 1},
        "status": {"type": "string"},
        "blockerFingerprint": {"type": "string", "minLength": 1},
        "remediationBead": {"type": ["string", "null"]},
        "retryAfter": {"type": ["string", "null"]},
        "degradedCodes": {"type": "array", "items": {"type": "string"}},
        "verificationAttribution": {"type": "string"}
      }
    },
    "verificationLedgerRecoveryAction": {
      "type": "object",
      "required": ["priority", "kind", "command", "message"],
      "additionalProperties": false,
      "properties": {
        "priority": {"type": "integer", "minimum": 0},
        "kind": {"type": "string"},
        "command": {"type": "string"},
        "message": {"type": "string"}
      }
    },
    "rchWorkerPressure": {
      "type": "object",
      "required": [
        "schema",
        "status",
        "workerCount",
        "usableWorkerCount",
        "blockedWorkerCount",
        "staleWorkerCount",
        "unknownWorkerCount",
        "workers"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {"type": "string", "const": "ee.rch.worker_pressure.v1"},
        "status": {
          "type": "string",
          "enum": [
            "pressure_clear",
            "pressure_degraded",
            "healthy_but_pressure_blocked",
            "telemetry_stale",
            "pressure_policy_denied",
            "pressure_unknown",
            "not_collected"
          ]
        },
        "workerCount": {"type": "integer", "minimum": 0},
        "usableWorkerCount": {"type": "integer", "minimum": 0},
        "blockedWorkerCount": {"type": "integer", "minimum": 0},
        "staleWorkerCount": {"type": "integer", "minimum": 0},
        "unknownWorkerCount": {"type": "integer", "minimum": 0},
        "workers": {
          "type": "array",
          "items": {"$ref": "#/$defs/rchWorkerPressureWorker"}
        }
      }
    },
    "rchWorkerPressureWorker": {
      "type": "object",
      "required": [
        "workerId",
        "pressureState",
        "confidence",
        "reasonCode",
        "freeGb",
        "freeRatioBps",
        "telemetryFreshness",
        "admissionImpact"
      ],
      "additionalProperties": false,
      "properties": {
        "workerId": {"type": "string"},
        "pressureState": {"type": "string"},
        "confidence": {"type": "string", "enum": ["low", "medium", "high"]},
        "reasonCode": {"type": "string"},
        "freeGb": {"type": ["integer", "null"], "minimum": 0},
        "freeRatioBps": {"type": ["integer", "null"], "minimum": 0},
        "telemetryFreshness": {"type": "string"},
        "admissionImpact": {"type": "string"}
      }
    },
    "meshAutoEnrollment": {
      "type": "object",
      "required": [
        "schema",
        "enabled",
        "posture",
        "workspacePath",
        "tailscale",
        "helloResponder",
        "discoveryCache",
        "materializedConfig",
        "driftPosture",
        "checks",
        "categorizedSummary",
        "actionGraph",
        "degraded"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {"type": "string", "const": "ee.doctor.mesh_auto_enrollment.v1"},
        "enabled": {"type": "boolean"},
        "posture": {"type": "string", "enum": ["ok", "warning", "fail", "skipped"]},
        "workspacePath": {"type": "string"},
        "tailscale": {"type": "object", "additionalProperties": true},
        "helloResponder": {"type": "object", "additionalProperties": true},
        "discoveryCache": {"type": "object", "additionalProperties": true},
        "materializedConfig": {"type": "object", "additionalProperties": true},
        "driftPosture": {"type": "object", "additionalProperties": true},
        "checks": {
          "type": "array",
          "minItems": 15,
          "items": {"$ref": "#/$defs/meshAutoEnrollmentCheck"}
        },
        "categorizedSummary": {
          "type": "object",
          "required": ["ok", "warning", "fail", "skipped", "total"],
          "additionalProperties": false,
          "properties": {
            "ok": {"type": "integer", "minimum": 0},
            "warning": {"type": "integer", "minimum": 0},
            "fail": {"type": "integer", "minimum": 0},
            "skipped": {"type": "integer", "minimum": 0},
            "total": {"type": "integer", "minimum": 15}
          }
        },
        "actionGraph": {"$ref": "#/$defs/repairActionGraph"},
        "degraded": {
          "type": "array",
          "items": {"type": "object", "additionalProperties": true}
        }
      }
    },
    "meshAutoEnrollmentCheck": {
      "type": "object",
      "required": ["name", "status", "message", "evidence", "fixActionId"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "status": {"type": "string", "enum": ["ok", "warning", "fail", "skipped"]},
        "message": {"type": "string"},
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key", "value"],
            "additionalProperties": false,
            "properties": {
              "key": {"type": "string"},
              "value": {"type": "string"}
            }
          }
        },
        "fixActionId": {"type": ["string", "null"]}
      }
    },
    "repairActionGraph": {
      "type": "object",
      "required": [
        "schema",
        "actions",
        "topologicallyOrderedExecution",
        "parallelizableGroups",
        "estimatedTotalDurationSeconds"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {"type": "string", "const": "ee.repair_action_graph.v1"},
        "actions": {
          "type": "array",
          "items": {"type": "object", "additionalProperties": true}
        },
        "topologicallyOrderedExecution": {
          "type": "array",
          "items": {"type": "string"}
        },
        "parallelizableGroups": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "estimatedTotalDurationSeconds": {"type": "integer", "minimum": 0}
      }
    }
  }
}
