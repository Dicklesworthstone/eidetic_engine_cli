{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://eidetic-engine/schemas/swarm/ee.swarm.work_packet.claim_gate.v1.json",
  "title": "ee.swarm.work_packet.claim_gate.v1",
  "description": "Read-only claim gate projection derived from ee.swarm.work_packet.v1 for agent harnesses that need a deterministic may-I-claim verdict before mutating Beads or reserving files.",
  "type": "object",
  "required": [
    "schema",
    "gateId",
    "packetId",
    "workspace",
    "redactionStatus",
    "requestedCandidateId",
    "verdict",
    "safeToClaim",
    "selectedCandidate",
    "recommendedAction",
    "recommendedSafeToClaim",
    "sourceAuthority",
    "actionableQueue",
    "unsafeReasons",
    "staleReasons",
    "sourceRefs",
    "degradedCodes",
    "nextCommandActions",
    "claimCommandAction",
    "recoveryActions"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {"type": "string", "const": "ee.swarm.work_packet.claim_gate.v1"},
    "gateId": {
      "type": "string",
      "pattern": "^swarm_work_packet_claim_gate_[a-f0-9]{24}$",
      "description": "Deterministic content identifier for this gate projection."
    },
    "packetId": {
      "type": "string",
      "pattern": "^swarm_work_packet_[a-f0-9]{24}$",
      "description": "The source work-packet content identifier."
    },
    "workspace": {
      "type": "string",
      "description": "Redacted workspace label or stable workspace hash, never an unredacted home path."
    },
    "redactionStatus": {
      "type": "string",
      "const": "counts_ids_statuses_path_patterns_command_templates_no_mail_body_no_file_content"
    },
    "requestedCandidateId": {
      "type": ["string", "null"],
      "description": "The explicitly requested Bead ID when the harness asks about one candidate, otherwise null for the recommended/default candidate."
    },
    "verdict": {"$ref": "#/definitions/gateVerdict"},
    "safeToClaim": {"type": "boolean"},
    "selectedCandidate": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/definitions/selectedCandidate"}
      ]
    },
    "recommendedAction": {
      "type": "string",
      "minLength": 1,
      "description": "The source packet recommendedAction.action value."
    },
    "recommendedSafeToClaim": {
      "type": ["boolean", "null"],
      "description": "Whether the selected or requested candidate is safe under the packet recommendation, candidate identity, tracker authority, Agent Mail authority, and RCH posture."
    },
    "sourceAuthority": {"$ref": "#/definitions/sourceAuthority"},
    "actionableQueue": {"$ref": "#/definitions/actionableQueueAuthority"},
    "resourceAdmission": {"$ref": "#/definitions/resourceAdmission"},
    "unsafeReasons": {"$ref": "#/definitions/stringArray"},
    "staleReasons": {"$ref": "#/definitions/stringArray"},
    "sourceRefs": {"$ref": "#/definitions/stringArray"},
    "degradedCodes": {"$ref": "#/definitions/stringArray"},
    "nextCommandActions": {
      "type": "array",
      "description": "Non-mutating inspection actions only. Claim/reopen/update actions are never mixed into this array.",
      "items": {"$ref": "#/definitions/inspectionCommandAction"}
    },
    "claimCommandAction": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/definitions/commandAction"}
      ],
      "description": "Mutating Beads claim guidance. Present only when safeToClaim is true and verdict is safe_to_claim."
    },
    "recoveryActions": {
      "type": "array",
      "description": "Structured recovery guidance for authority blockers. Entries may be read-only commands or human/operator actions; they are not claim permission.",
      "items": {"$ref": "#/definitions/recoveryAction"}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"safeToClaim": {"const": false}},
        "required": ["safeToClaim"]
      },
      "then": {
        "properties": {"claimCommandAction": {"const": null}}
      }
    },
    {
      "if": {
        "properties": {"safeToClaim": {"const": true}},
        "required": ["safeToClaim"]
      },
      "then": {
        "properties": {
          "verdict": {"const": "safe_to_claim"},
          "recommendedSafeToClaim": {"const": true},
          "selectedCandidate": {
            "type": "object",
            "required": ["decision"],
            "properties": {
              "decision": {"const": "safe_to_claim"}
            }
          },
          "claimCommandAction": {"type": "object"},
          "actionableQueue": {
            "type": "object",
            "required": ["candidateState", "bvAdvisoryContradiction"],
            "properties": {
              "candidateState": {
                "enum": ["candidate_present_actionable", "not_evaluated"]
              },
              "bvAdvisoryContradiction": {"const": false}
            }
          }
        }
      }
    }
  ],
  "definitions": {
    "stringArray": {
      "type": "array",
      "items": {"type": "string"}
    },
    "safeString": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          {"pattern": "BEGIN PRIVATE KEY"},
          {"pattern": "BEGIN OPENSSH PRIVATE KEY"},
          {"pattern": "ghp_[A-Za-z0-9_]+"},
          {"pattern": "Bearer [A-Za-z0-9._-]+"},
          {"pattern": "DATABASE_URL="},
          {"pattern": "From: "},
          {"pattern": "Subject: "},
          {"pattern": "Message-ID:"},
          {"pattern": "body:"},
          {"pattern": "raw_inbox"},
          {"pattern": "stdout:"},
          {"pattern": "stderr:"},
          {"pattern": "/Users/[^\\s]+"},
          {"pattern": "/home/[^\\s]+"}
        ]
      }
    },
    "argvArray": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/safeString"}
    },
    "copySafety": {
      "type": "string",
      "enum": [
        "safe_structured_argv",
        "display_only",
        "shell_required_review",
        "forbidden_until_human_approval"
      ]
    },
    "commandSubstrate": {
      "type": "string",
      "enum": ["agent_mail", "beads", "bv", "ee", "git", "human", "jq", "rch", "static_local", "none"]
    },
    "commandAction": {
      "type": "object",
      "required": [
        "commandId",
        "displayCommand",
        "argv",
        "shellRequired",
        "copySafety",
        "mutatesState",
        "requiredSubstrate",
        "when",
        "rationale"
      ],
      "additionalProperties": false,
      "properties": {
        "commandId": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]+$"},
        "displayCommand": {"$ref": "#/definitions/safeString"},
        "argv": {"$ref": "#/definitions/argvArray"},
        "shellRequired": {"type": "boolean"},
        "copySafety": {"$ref": "#/definitions/copySafety"},
        "mutatesState": {"type": "boolean"},
        "requiredSubstrate": {"$ref": "#/definitions/commandSubstrate"},
        "when": {"$ref": "#/definitions/safeString"},
        "rationale": {
          "allOf": [{"$ref": "#/definitions/safeString"}],
          "maxLength": 240
        }
      },
      "allOf": [
        {
          "if": {"properties": {"shellRequired": {"const": true}}, "required": ["shellRequired"]},
          "then": {"properties": {"copySafety": {"enum": ["shell_required_review", "forbidden_until_human_approval"]}}}
        },
        {
          "if": {"properties": {"copySafety": {"const": "safe_structured_argv"}}, "required": ["copySafety"]},
          "then": {"properties": {"shellRequired": {"const": false}}}
        }
      ]
    },
    "inspectionCommandAction": {
      "description": "Read-only inspection action derived from commandAction. Claim, reopen, update, Cargo, Git staging, and Agent Mail send actions are not valid here.",
      "allOf": [
        {"$ref": "#/definitions/commandAction"}
      ],
      "required": ["mutatesState"],
      "properties": {
        "mutatesState": {"const": false}
      }
    },
    "recoveryAction": {
      "type": "object",
      "required": [
        "priority",
        "kind",
        "commandAction",
        "mutatesState",
        "requiredSubstrate",
        "rationale"
      ],
      "additionalProperties": false,
      "properties": {
        "priority": {"type": "integer", "minimum": 0, "maximum": 255},
        "kind": {
          "type": "string",
          "enum": [
            "verify_source_version",
            "plan_current_artifact_adoption",
            "request_operator_exception",
            "retry_claim_gate"
          ]
        },
        "commandAction": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/definitions/commandAction"}
          ]
        },
        "mutatesState": {"type": "boolean"},
        "requiredSubstrate": {"$ref": "#/definitions/commandSubstrate"},
        "rationale": {
          "allOf": [{"$ref": "#/definitions/safeString"}],
          "maxLength": 240
        }
      }
    },
    "gateVerdict": {
      "type": "string",
      "enum": [
        "safe_to_claim",
        "already_owned",
        "unsafe_due_to_conflict",
        "blocked_by_dependency",
        "blocked_by_verification",
        "stale_but_reclaimable",
        "stale_review",
        "external_state_required",
        "release_operator_required",
        "rollup_only",
        "blocked_rollup",
        "coordinate_first",
        "blocked",
        "stale_or_advisory",
        "skip",
        "candidate_not_found",
        "no_candidate"
      ]
    },
    "selectedCandidate": {
      "type": "object",
      "required": [
        "id",
        "title",
        "source",
        "status",
        "priority",
        "assignee",
        "decision",
        "collisionRisk"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "title": {"type": "string"},
        "source": {"type": "string"},
        "status": {"type": "string"},
        "priority": {"type": ["integer", "null"]},
        "assignee": {"type": ["string", "null"]},
        "decision": {"$ref": "#/definitions/gateVerdict"},
        "collisionRisk": {"type": "string", "enum": ["none", "low", "medium", "high", "unknown"]}
      }
    },
    "sourceAuthority": {
      "type": "object",
      "required": [
        "trackerAuthoritative",
        "trackerHealth",
        "agentMailStatus",
        "reservationAuthoritative",
        "inboxAuthoritative",
        "rchRemoteOnlyRequired",
        "rchSafeToLaunchCargoVerification",
        "environmentVerdict",
        "sourceTestVerdict",
        "remoteVerificationAdmitted",
        "localCargoFallbackObserved",
        "installFreshnessVerdict",
        "installFreshnessAuthoritative",
        "installFreshnessRepair",
        "sourceCount"
      ],
      "additionalProperties": false,
      "properties": {
        "trackerAuthoritative": {"type": "boolean"},
        "trackerHealth": {
          "type": "string",
          "description": "Concrete tracker authority state (bd-3w4pv.6). Live gates emit the split vocabulary clean|doctor_metadata_message_only|dirty_issues|jsonl_newer|db_newer|merge_artifacts|count_mismatch|parse_error; the legacy coarse trackerIntegrity.health vocabulary stays valid for archived payloads. doctor_metadata_message_only means the br doctor sync.metadata message claims pending external changes while every concrete dirty/import signal is clean: trackerAuthoritative stays true and the contradiction surfaces as a warning-severity beads_tracker_metadata_drift degraded code. Every other non-clean state keeps trackerAuthoritative=false (fail closed).",
          "enum": [
            "ok",
            "merge_artifacts_warn",
            "external_changes_pending_import",
            "db_jsonl_count_mismatch",
            "jsonl_parse_error",
            "clean",
            "doctor_metadata_message_only",
            "dirty_issues",
            "jsonl_newer",
            "db_newer",
            "merge_artifacts",
            "count_mismatch",
            "parse_error"
          ]
        },
        "agentMailStatus": {"type": "string"},
        "reservationAuthoritative": {"type": ["boolean", "null"]},
        "inboxAuthoritative": {"type": ["boolean", "null"]},
        "rchRemoteOnlyRequired": {"type": "boolean"},
        "rchSafeToLaunchCargoVerification": {"type": ["boolean", "null"]},
        "environmentVerdict": {
          "type": "string",
          "enum": [
            "safe_to_claim",
            "coordinate_before_claim",
            "unsafe_due_to_conflict",
            "remote_verification_admitted",
            "proof_environment_blocked",
            "source_authority_ambiguous",
            "stale_binary_suspected",
            "tracker_stale",
            "local_cargo_bypass_detected",
            "unknown_insufficient_evidence"
          ]
        },
        "sourceTestVerdict": {
          "type": "string",
          "enum": [
            "not_evaluated",
            "source_not_tested",
            "source_passed",
            "source_failed",
            "environment_blocked_before_source",
            "stale_source",
            "unknown"
          ]
        },
        "remoteVerificationAdmitted": {"type": ["boolean", "null"]},
        "localCargoFallbackObserved": {"type": ["boolean", "null"]},
        "installFreshnessVerdict": {
          "type": "string",
          "enum": [
            "not_evaluated",
            "fresh",
            "stale",
            "shadowed_binary",
            "path_binary_missing",
            "missing_required_surface",
            "unknown_source_version",
            "unknown_installed_version"
          ]
        },
        "installFreshnessAuthoritative": {"type": ["boolean", "null"]},
        "installFreshnessRepair": {"type": ["string", "null"], "maxLength": 240},
        "sourceCount": {"type": "integer", "minimum": 0}
      }
    },
    "actionableQueueAuthority": {
      "type": "object",
      "description": "First-class actionable-queue evidence (bd-3w4pv.7). scripts/br_retry.sh actionable --json is the safe claimable-leaf queue; raw br ready and bv --robot-next are broad/advisory. Precedence: (1) actionable presence is necessary but never sufficient — tracker authority, reservations, RCH posture, and the conflict gate must still agree; (2) BV recommendations are advisory unless the id is in the actionable queue AND the gate passes; a BV pick that Beads marks blocked or that is absent from the queue surfaces as bvAdvisoryContradiction, never as a claim; (3) raw br ready rows never override the actionable queue or gate safety — excluded rows appear only in exclusionAccounting; (4) timed_out is never collapsed into absence; (5) queueState=not_evaluated (archived payloads, snapshot-only consumers) never blocks. Redaction: bounded bead ids and counts only — no row titles, no raw command stdout, no host-private paths.",
      "required": [
        "commandId",
        "displayCommand",
        "mutatesState",
        "collectionMode",
        "queueState",
        "exitClass",
        "authoritative",
        "rowCount",
        "candidateIds",
        "truncatedCandidateCount",
        "filterContract",
        "exclusionAccounting",
        "candidateState",
        "bvAdvisoryContradiction",
        "trackerAuthorityDegraded",
        "contradictionEvidence"
      ],
      "additionalProperties": false,
      "properties": {
        "commandId": {"type": "string", "const": "beads_actionable_queue"},
        "displayCommand": {"type": "string", "const": "scripts/br_retry.sh actionable --json"},
        "mutatesState": {"type": "boolean", "const": false},
        "collectionMode": {
          "type": "string",
          "description": "br_retry_script: the queue command ran with a bounded timeout. brief_ready_filter: the workspace does not ship the script, so the same filter contract was applied in-process to the brief's fresh br ready rows. skipped_by_flag: the Beads source was disabled for this collection. not_evaluated: the packet was built without the collector.",
          "enum": ["not_evaluated", "br_retry_script", "brief_ready_filter", "skipped_by_flag"]
        },
        "queueState": {
          "type": "string",
          "description": "ready: the queue answered inside budget. unavailable: spawn/parse failure or skipped — no queue answer exists. timed_out: budget exhausted; MUST NOT be collapsed into absence. stale_fallback: only degraded/stale fallback evidence answered; advisory only. not_evaluated: collector not run.",
          "enum": ["not_evaluated", "ready", "unavailable", "timed_out", "stale_fallback"]
        },
        "exitClass": {
          "type": "string",
          "enum": ["not_evaluated", "ok", "timeout", "spawn_failed", "parse_failed", "unknown"]
        },
        "authoritative": {
          "type": "boolean",
          "description": "True only when queueState=ready and tracker authority is intact. The queue is a br view, so a degraded tracker degrades the queue with it."
        },
        "rowCount": {"type": ["integer", "null"], "minimum": 0},
        "candidateIds": {
          "type": "array",
          "maxItems": 32,
          "items": {"type": "string", "minLength": 1, "maxLength": 120}
        },
        "truncatedCandidateCount": {"type": "integer", "minimum": 0},
        "filterContract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "excludesEpics",
            "excludesAssigned",
            "excludesBlocked",
            "excludesDeferred",
            "excludesInProgress"
          ],
          "properties": {
            "excludesEpics": {"type": "boolean", "const": true},
            "excludesAssigned": {"type": "boolean", "const": true},
            "excludesBlocked": {"type": "boolean", "const": true},
            "excludesDeferred": {"type": "boolean", "const": true},
            "excludesInProgress": {"type": "boolean", "const": true}
          }
        },
        "exclusionAccounting": {
          "type": "object",
          "description": "Counts of tracker rows the actionable queue excludes (counts only, never row content). Structural buckets (blocked/deferred/inProgress) come from the tracker buckets br ready already excludes; the epic/assigned/other buckets classify raw ready rows absent from the queue.",
          "additionalProperties": false,
          "required": [
            "rawReadyCount",
            "excludedEpicCount",
            "excludedAssignedCount",
            "excludedBlockedCount",
            "excludedDeferredCount",
            "excludedInProgressCount",
            "excludedOtherCount"
          ],
          "properties": {
            "rawReadyCount": {"type": ["integer", "null"], "minimum": 0},
            "excludedEpicCount": {"type": "integer", "minimum": 0},
            "excludedAssignedCount": {"type": "integer", "minimum": 0},
            "excludedBlockedCount": {"type": "integer", "minimum": 0},
            "excludedDeferredCount": {"type": "integer", "minimum": 0},
            "excludedInProgressCount": {"type": "integer", "minimum": 0},
            "excludedOtherCount": {"type": "integer", "minimum": 0}
          }
        },
        "candidateState": {
          "type": "string",
          "description": "Candidate-conditional queue outcome. candidate_present_actionable: the queue is ready and contains the candidate (necessary, not sufficient). candidate_absent_from_actionable: the queue is ready and confirms absence. actionable_queue_unavailable / actionable_queue_timed_out / actionable_queue_stale_fallback: the queue could not confirm presence or absence — the gate fails closed. not_evaluated: no candidate in play or collector not run.",
          "enum": [
            "not_evaluated",
            "candidate_present_actionable",
            "candidate_absent_from_actionable",
            "actionable_queue_unavailable",
            "actionable_queue_timed_out",
            "actionable_queue_stale_fallback"
          ]
        },
        "bvAdvisoryContradiction": {
          "type": "boolean",
          "description": "True when the selected/requested candidate is a BV recommendation that Beads contradicts (marked blocked, or absent from the ready actionable queue)."
        },
        "trackerAuthorityDegraded": {
          "type": "boolean",
          "description": "True when queue evidence was evaluated while tracker reads were not authoritative; the queue inherits the degraded authority."
        },
        "contradictionEvidence": {
          "type": "array",
          "maxItems": 8,
          "items": {"$ref": "#/definitions/safeString"},
          "description": "Bounded packet-wide BV-vs-Beads contradiction entries, e.g. bv_recommends_blocked_id:<id> or bv_recommends_id_absent_from_actionable_queue:<id>. Ids only."
        }
      }
    },
    "resourceAdmission": {
      "type": "object",
      "description": "Side-effect-free advisory resource-profile admission copied into the claim gate. This block can suggest waiting for RCH or using a lean profile, but canAuthorizeClaim is always false and cannot make an unsafe claim safe.",
      "required": [
        "schema",
        "policyDomain",
        "policyId",
        "sideEffectFree",
        "advisoryOnly",
        "canAuthorizeClaim",
        "surface",
        "commandClass",
        "decision",
        "requestedProfile",
        "effectiveProfile",
        "recommendedProfile",
        "estimatedCostClass",
        "sourcePosture",
        "evidenceFreshness",
        "reasonCodes",
        "abstentionReasons",
        "nextCommands",
        "nextCommandActions"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {"type": "string", "const": "ee.resource_admission.v1"},
        "policyDomain": {"type": "string", "const": "resource_profile_budget_admission"},
        "policyId": {"type": "string", "const": "candidate.resource_profile_budget_admission"},
        "sideEffectFree": {"type": "boolean", "const": true},
        "advisoryOnly": {"type": "boolean", "const": true},
        "canAuthorizeClaim": {"type": "boolean", "const": false},
        "surface": {"type": "string", "enum": ["claim_gate", "work_packet"]},
        "commandClass": {"type": "string", "enum": ["coordination", "read_only"]},
        "decision": {
          "type": "string",
          "enum": [
            "admit",
            "degrade_to_lean",
            "queue",
            "wait_for_rch",
            "split_workload",
            "refuse_local_cargo",
            "abstain"
          ]
        },
        "requestedProfile": {"type": ["string", "null"], "enum": ["constrained", "portable", "workstation", "swarm", null]},
        "effectiveProfile": {"type": "string", "enum": ["constrained", "portable", "workstation", "swarm"]},
        "recommendedProfile": {"type": "string", "enum": ["constrained", "portable", "workstation", "swarm"]},
        "estimatedCostClass": {"type": "string", "enum": ["tiny", "small", "standard", "swarm_heavy", "unknown"]},
        "sourcePosture": {"$ref": "#/definitions/resourceAdmissionSourcePosture"},
        "evidenceFreshness": {"type": "string", "enum": ["fresh", "partial", "degraded", "unsafe"]},
        "reasonCodes": {"$ref": "#/definitions/stringArray"},
        "abstentionReasons": {"$ref": "#/definitions/stringArray"},
        "nextCommands": {"$ref": "#/definitions/stringArray"},
        "nextCommandActions": {
          "type": "array",
          "items": {"$ref": "#/definitions/inspectionCommandAction"}
        }
      }
    },
    "resourceAdmissionSourcePosture": {
      "type": "object",
      "required": [
        "hostCalibration",
        "resourceBudget",
        "rch",
        "localCargo",
        "lanePressure",
        "workloadPressure",
        "daemon",
        "replay",
        "redactionPostureVerified",
        "sourceCount"
      ],
      "additionalProperties": false,
      "properties": {
        "hostCalibration": {"type": "string"},
        "resourceBudget": {"type": "string"},
        "rch": {"type": "string"},
        "localCargo": {"type": "string"},
        "lanePressure": {"type": "string"},
        "workloadPressure": {"type": "string"},
        "daemon": {"type": "string"},
        "replay": {"type": "string"},
        "redactionPostureVerified": {"type": "boolean"},
        "sourceCount": {"type": "integer", "minimum": 0}
      }
    }
  },
  "examples": [
    {
      "schema": "ee.swarm.work_packet.claim_gate.v1",
      "gateId": "swarm_work_packet_claim_gate_111111111111111111111111",
      "packetId": "swarm_work_packet_222222222222222222222222",
      "workspace": "repo:25e38e130474e7f0292de2a3",
      "redactionStatus": "counts_ids_statuses_path_patterns_command_templates_no_mail_body_no_file_content",
      "requestedCandidateId": "bd-example.1",
      "verdict": "safe_to_claim",
      "safeToClaim": true,
      "selectedCandidate": {
        "id": "bd-example.1",
        "title": "Document a small schema improvement",
        "source": "beads_ready",
        "status": "open",
        "priority": 2,
        "assignee": null,
        "decision": "safe_to_claim",
        "collisionRisk": "none"
      },
      "recommendedAction": "inspect_and_claim",
      "recommendedSafeToClaim": true,
      "sourceAuthority": {
        "trackerAuthoritative": true,
        "trackerHealth": "ok",
        "agentMailStatus": "healthy",
        "reservationAuthoritative": true,
        "inboxAuthoritative": true,
        "rchRemoteOnlyRequired": true,
        "rchSafeToLaunchCargoVerification": true,
        "environmentVerdict": "remote_verification_admitted",
        "sourceTestVerdict": "not_evaluated",
        "remoteVerificationAdmitted": true,
        "localCargoFallbackObserved": null,
        "installFreshnessVerdict": "not_evaluated",
        "installFreshnessAuthoritative": null,
        "installFreshnessRepair": null,
        "sourceCount": 4
      },
      "actionableQueue": {
        "commandId": "beads_actionable_queue",
        "displayCommand": "scripts/br_retry.sh actionable --json",
        "mutatesState": false,
        "collectionMode": "br_retry_script",
        "queueState": "ready",
        "exitClass": "ok",
        "authoritative": true,
        "rowCount": 1,
        "candidateIds": ["bd-example.1"],
