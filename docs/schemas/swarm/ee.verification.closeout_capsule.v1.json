          "properties": {
            "verificationHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "artifactName": { "type": "string", "minLength": 1 },
            "artifactId": { "type": "string", "pattern": "^[1-9][0-9]*$" },
            "repository": { "type": "string", "minLength": 1 },
            "workflow": { "type": "string", "minLength": 1 },
            "runId": { "type": "string", "pattern": "^[1-9][0-9]*$" },
            "runAttempt": { "type": "integer", "minimum": 1 },
            "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
            "gitTree": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
            "manifestHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "buildCommandHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "effectiveInputHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "provenanceHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "target": { "type": "string", "minLength": 1 },
            "profile": { "type": "string", "minLength": 1 },
            "binaryHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "archiveHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "probeIds": {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      ]
    },
    "retainedLogReference": { "type": ["string", "null"] },
    "caveats": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "reusableUntil": { "type": ["string", "null"] },
    "sourceMustMatch": { "type": "boolean" },
    "failureModeCodes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "evidence_incomplete",
          "local_cargo_disallowed",
          "no_artifact_manifest",
          "remote_artifact_attestation_invalid",
          "requested_source_hash_missing",
          "source_hash_mismatch"
        ]
      }
    },
    "supportBundleMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "stdoutHash",
        "stderrExcerptHash",
        "provenance",
        "rawOutputIncluded",
        "localPathsRedacted"
      ],
      "properties": {
        "runId": { "type": "string", "minLength": 1 },
        "stdoutHash": { "type": ["string", "null"] },
        "stderrExcerptHash": { "type": ["string", "null"] },
        "provenance": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "eventKind", "line"],
            "properties": {
              "source": { "type": "string" },
              "eventKind": { "type": "string" },
              "line": { "type": ["integer", "null"], "minimum": 1 }
            }
          }
        },
        "rawOutputIncluded": { "type": "boolean", "const": false },
        "localPathsRedacted": { "type": "boolean", "const": true }
      }
    }
  },
