{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://eidetic-engine/schemas/swarm/ee.proof_broker.v1.json",
  "title": "ee.proof_broker.v1",
  "description": "Redaction-safe proof broker fingerprint, ledger row, and admission decision contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "rowId",
    "fingerprint",
    "state",
    "admission",
    "runId",
    "owner",
    "createdAt",
    "startedAt",
    "completedAt",
    "expiresAt",
    "sourceStateValidUntil",
    "invalidationReasons",
    "evidenceRefs",
    "rawOutputIncluded"
  ],
  "properties": {
    "schema": { "type": "string", "const": "ee.proof_broker.v1" },
    "rowId": { "type": "string", "minLength": 1 },
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fingerprintId",
        "beadId",
        "commandClass",
        "commandHash",
        "normalizedArgvHash",
        "sourceTreeFingerprint",
        "sourceMaterialization",
        "dirtyStatusHash",
        "envFingerprintClass",
        "targetProfile",
        "executionSubstrate",
        "rchRuntimeClass",
        "workerRequirement",
        "localCargoTripwireClass",
        "buildAdmissionPosture"
      ],
      "properties": {
        "fingerprintId": { "type": "string", "minLength": 1 },
        "beadId": { "type": ["string", "null"] },
        "commandClass": { "type": "string", "minLength": 1 },
        "commandHash": { "type": "string", "minLength": 1 },
        "normalizedArgvHash": { "type": "string", "minLength": 1 },
        "sourceTreeFingerprint": { "type": "string", "minLength": 1 },
        "sourceMaterialization": { "type": "string", "minLength": 1 },
        "dirtyStatusHash": { "type": "string", "minLength": 1 },
        "envFingerprintClass": { "type": "string", "minLength": 1 },
        "targetProfile": { "type": ["string", "null"] },
        "executionSubstrate": { "type": "string", "minLength": 1 },
        "rchRuntimeClass": { "type": "string", "minLength": 1 },
        "workerRequirement": { "type": "string", "minLength": 1 },
        "localCargoTripwireClass": { "type": "string", "minLength": 1 },
        "buildAdmissionPosture": { "type": "string", "minLength": 1 }
      }
    },
    "state": {
      "type": "string",
      "enum": ["admission_only", "in_flight", "completed", "rejected"]
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "reasonCodes", "nextAction", "reuseRunId", "waitOwner"],
      "properties": {
        "verdict": {
          "type": "string",
          "enum": [
            "reuse_existing",
            "wait_for_inflight",
            "dispatch_allowed",
            "source_state_mismatch",
            "environment_blocked",
            "proof_unusable",
            "unknown_insufficient_evidence"
          ]
        },
        "reasonCodes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "nextAction": { "type": "string", "minLength": 1 },
        "reuseRunId": { "type": ["string", "null"] },
        "waitOwner": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["agentName", "beadId", "mailThreadId", "buildSlot", "rchJobId"],
          "properties": {
            "agentName": { "type": ["string", "null"] },
            "beadId": { "type": ["string", "null"] },
            "mailThreadId": { "type": ["string", "null"] },
            "buildSlot": { "type": ["string", "null"] },
            "rchJobId": { "type": ["string", "null"] }
          }
        }
      }
    },
    "runId": { "type": ["string", "null"] },
    "owner": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["agentName", "beadId", "mailThreadId", "buildSlot", "rchJobId"],
      "properties": {
        "agentName": { "type": ["string", "null"] },
        "beadId": { "type": ["string", "null"] },
        "mailThreadId": { "type": ["string", "null"] },
        "buildSlot": { "type": ["string", "null"] },
        "rchJobId": { "type": ["string", "null"] }
      }
    },
    "createdAt": { "type": "string", "minLength": 1 },
    "startedAt": { "type": ["string", "null"] },
    "completedAt": { "type": ["string", "null"] },
    "expiresAt": { "type": ["string", "null"] },
    "sourceStateValidUntil": { "type": ["string", "null"] },
    "invalidationReasons": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "id", "contentHash", "redacted"],
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "id": { "type": "string", "minLength": 1 },
          "contentHash": { "type": ["string", "null"] },
          "redacted": { "type": "boolean", "const": true }
        }
      }
    },
    "rawOutputIncluded": { "type": "boolean", "const": false }
  },
  "x-ee-status": {
    "shipped": false,
    "available_in_build": false,
    "tracking_bead": "bd-1n3x1.1"
  },
  "x-ee-doc": "docs/swarm/proof_broker.md",
