{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://eidetic-engine/schemas/swarm/ee.swarm.work_packet.v1.json",
  "title": "ee.swarm.work_packet.v1",
  "description": "Deterministic, redacted, read-only work packet for crowded agent checkouts.",
  "type": "object",
  "required": [
    "schema",
    "packetId",
    "workspace",
    "redactionStatus",
    "observedStateClass",
    "recommendedAction",
    "candidates",
    "coordination",
    "trackerIntegrity",
    "rchProofPosture",
    "verification",
    "sourceProvenance",
    "mutationPolicy",
    "degraded"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {"type": "string", "const": "ee.swarm.work_packet.v1"},
    "packetId": {
      "type": "string",
      "description": "Deterministic content identifier for the redacted packet payload."
    },
    "workspace": {
      "type": "string",
      "description": "Redacted workspace label or stable workspace hash, never an unredacted home path."
    },
    "redactionStatus": {
      "type": "string",
      "const": "counts_ids_statuses_path_patterns_command_templates_no_mail_body_no_file_content"
    },
    "observedStateClass": {
      "type": "string",
      "enum": ["healthy_small_repo", "crowded_checkout", "degraded_mail_rch_topology", "unknown"]
    },
    "recommendedAction": {"$ref": "#/definitions/recommendedAction"},
    "candidates": {
      "type": "array",
      "items": {"$ref": "#/definitions/candidate"}
    },
    "coordination": {"$ref": "#/definitions/coordination"},
    "trackerIntegrity": {"$ref": "#/definitions/trackerIntegrity"},
    "rchProofPosture": {"$ref": "#/definitions/rchProofPosture"},
    "verification": {"$ref": "#/definitions/verification"},
    "sourceProvenance": {
      "type": "array",
      "items": {"$ref": "#/definitions/sourceProvenance"}
    },
    "mutationPolicy": {"$ref": "#/definitions/mutationPolicy"},
    "degraded": {
      "type": "array",
      "items": {"$ref": "#/definitions/degradation"}
    }
  },
  "definitions": {
    "stringArray": {
      "type": "array",
      "items": {"type": "string"}
    },
    "safeCommandString": {
      "type": "string",
      "minLength": 1,
      "description": "Bounded command metadata string. Executable command fields must not embed raw mail bodies, raw command output, raw home paths, secret-looking tokens, or private file contents.",
      "not": {
        "anyOf": [
          {"pattern": "BEGIN PRIVATE KEY"},
          {"pattern": "BEGIN OPENSSH PRIVATE KEY"},
          {"pattern": "ghp_[A-Za-z0-9_]+"},
          {"pattern": "Bearer [A-Za-z0-9._-]+"},
          {"pattern": "DATABASE_URL="},
          {"pattern": "From: "},
          {"pattern": "Subject: "},
          {"pattern": "Message-ID:"},
          {"pattern": "body:"},
          {"pattern": "raw_inbox"},
          {"pattern": "stdout:"},
          {"pattern": "stderr:"},
          {"pattern": "/Users/[^\\s]+"},
          {"pattern": "/home/[^\\s]+"}
        ]
      }
    },
    "argvArray": {
      "type": "array",
      "minItems": 1,
      "description": "Shell-free argv vector for agent execution. Consumers may run this directly only when copySafety is safe_structured_argv and shellRequired is false.",
      "items": {"$ref": "#/definitions/safeCommandString"}
    },
    "copySafety": {
      "type": "string",
      "enum": [
        "safe_structured_argv",
        "display_only",
        "shell_required_review",
        "forbidden_until_human_approval"
      ]
    },
    "commandSubstrate": {
      "type": "string",
      "enum": ["agent_mail", "beads", "bv", "ee", "git", "human", "jq", "rch", "static_local", "none"]
    },
    "commandAction": {
      "type": "object",
      "description": "Structured command action for agent-facing work packets. The displayCommand is for humans; argv is the only execution surface for safe automatic use.",
      "required": [
        "commandId",
        "displayCommand",
        "argv",
        "shellRequired",
        "copySafety",
        "mutatesState",
        "requiredSubstrate",
        "when",
        "rationale"
      ],
      "additionalProperties": false,
      "properties": {
        "commandId": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]+$"},
        "displayCommand": {"$ref": "#/definitions/safeCommandString"},
        "argv": {"$ref": "#/definitions/argvArray"},
        "shellRequired": {"type": "boolean"},
        "copySafety": {"$ref": "#/definitions/copySafety"},
        "mutatesState": {"type": "boolean"},
        "requiredSubstrate": {"$ref": "#/definitions/commandSubstrate"},
        "when": {"$ref": "#/definitions/safeCommandString"},
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "not": {
            "anyOf": [
              {"pattern": "BEGIN PRIVATE KEY"},
              {"pattern": "ghp_[A-Za-z0-9_]+"},
              {"pattern": "DATABASE_URL="},
              {"pattern": "From: "},
              {"pattern": "Subject: "},
              {"pattern": "Message-ID:"}
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"shellRequired": {"const": true}}, "required": ["shellRequired"]},
          "then": {"properties": {"copySafety": {"enum": ["shell_required_review", "forbidden_until_human_approval"]}}}
        },
        {
          "if": {"properties": {"copySafety": {"const": "safe_structured_argv"}}, "required": ["copySafety"]},
          "then": {"properties": {"shellRequired": {"const": false}}}
        }
      ]
    },
    "recommendedAction": {
      "type": "object",
      "required": [
        "action",
        "candidateId",
        "confidence",
        "safeToClaim",
        "reasons",
        "proofObligations",
        "suggestedCommands"
      ],
      "additionalProperties": false,
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "inspect_and_claim",
            "coordinate_before_claim",
            "continue_existing_claim",
            "prefer_static_docs_work",
            "reopen_stale_work",
            "blocked_no_action"
          ]
        },
        "candidateId": {"type": ["string", "null"]},
        "confidence": {"type": "string", "enum": ["low", "medium", "high"]},
        "safeToClaim": {"type": ["boolean", "null"]},
        "reasons": {"$ref": "#/definitions/stringArray"},
        "proofObligations": {"$ref": "#/definitions/stringArray"},
        "suggestedCommands": {
          "$ref": "#/definitions/stringArray",
          "description": "Legacy display-only command strings retained during migration. Consumers must prefer suggestedCommandActions.argv when present and must not treat these strings as shell-safe executable commands."
        },
        "suggestedCommandActions": {
          "type": "array",
          "description": "Structured command actions for normal agent workflows. Shell-free argv entries with copySafety=safe_structured_argv are safe to execute without shell evaluation.",
          "items": {"$ref": "#/definitions/commandAction"}
        }
      }
    },
    "candidate": {
      "type": "object",
      "required": [
        "id",
        "title",
        "source",
        "status",
        "priority",
        "assignee",
        "decision",
        "collisionRisk",
        "unsafeReasons",
        "staleReasons",
        "sourceRefs"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "title": {"type": "string"},
        "source": {
          "type": "string",
          "enum": ["bv_top_pick", "beads_ready", "beads_in_progress", "idea_wizard", "manual"]
        },
        "status": {"type": "string"},
        "priority": {"type": ["integer", "null"]},
        "assignee": {"type": ["string", "null"]},
        "decision": {
          "type": "string",
          "enum": ["safe_to_claim", "coordinate_first", "blocked", "stale_review", "skip"]
        },
        "collisionRisk": {"type": "string", "enum": ["none", "low", "medium", "high", "unknown"]},
        "unsafeReasons": {"$ref": "#/definitions/stringArray"},
        "staleReasons": {"$ref": "#/definitions/stringArray"},
        "sourceRefs": {"$ref": "#/definitions/stringArray"}
      }
    },
    "coordination": {
      "type": "object",
      "required": [
        "activeClaimCount",
        "dirtyPathCount",
        "fileCollisionCount",
        "agentMail",
        "activeClaims",
        "fileCollisions"
      ],
      "additionalProperties": false,
      "properties": {
        "activeClaimCount": {"type": "integer", "minimum": 0},
        "dirtyPathCount": {"type": "integer", "minimum": 0},
        "fileCollisionCount": {"type": "integer", "minimum": 0},
        "agentMail": {"$ref": "#/definitions/agentMail"},
        "activeClaims": {
          "type": "array",
          "items": {"$ref": "#/definitions/activeClaim"}
        },
        "fileCollisions": {
          "type": "array",
          "items": {"$ref": "#/definitions/fileCollision"}
        }
      }
    },
    "agentMail": {
      "type": "object",
      "description": "bd-2z5ly.8: redacted Agent Mail coordination health. `status` carries the broad availability and recovery class; the `*Authoritative` flags and `archiveIndexParity` tell a downstream candidate-safety classifier whether reservation or inbox evidence can be trusted. `fallbackActions` is an ordered, structured recovery workflow that replaces prose-only repair strings so agents do not parse natural language. No mail bodies, raw inbox contents, agent identities, or unredacted reservation paths may appear in this block.",
      "required": ["status", "healthLevel", "unreadCount", "ackRequiredCount", "degradedCodes"],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "fresh",
            "healthy",
            "degraded_read_only",
            "archive_ahead_of_sqlite",
            "inbox_unavailable",
            "reservation_unavailable",
            "outbox_only",
            "semantic_readiness_failed",
            "unreachable",
            "unavailable",
            "skipped"
          ],
          "description": "bd-2z5ly.8: broad Agent Mail health class. `fresh` and `healthy` are aliases; `healthy` is preferred for new emitters. `degraded_read_only` keeps the index queryable but blocks writes. `archive_ahead_of_sqlite` flags archive/index parity drift. `inbox_unavailable` and `reservation_unavailable` are sub-component failures where partial coordination evidence remains. `outbox_only` allows sends but not reads. bd-2z5ly.8.1: `semantic_readiness_failed` covers the green-transport contradiction where the health endpoint responds with `healthLevel=green` but `semantic_readiness.status=fail` (for example malformed SQLite storage) so reservation/inbox reads cannot be trusted. `unreachable` means the transport itself is down. `unavailable` and `skipped` retain their legacy `swarm brief` meaning."
        },
        "healthLevel": {"type": ["string", "null"], "enum": ["green", "yellow", "red", null]},
        "unreadCount": {"type": ["integer", "null"], "minimum": 0},
        "ackRequiredCount": {"type": ["integer", "null"], "minimum": 0},
        "degradedCodes": {"$ref": "#/definitions/stringArray"},
        "recoveryMode": {
          "type": ["string", "null"],
          "enum": ["none", "wait_for_repair", "proceed_via_beads", "static_work_only", "manual_coordination", null],
          "description": "bd-2z5ly.8: structured recovery posture for downstream candidate-safety logic. `null` when status is fresh/healthy or evidence is insufficient to recommend a specific recovery path."
        },
        "archiveIndexParity": {
          "type": ["string", "null"],
          "enum": ["aligned", "archive_ahead", "sqlite_ahead", "unknown", null],
          "description": "bd-2z5ly.8: bounded summary of Agent Mail archive/SQLite index parity. `archive_ahead` is the canonical degraded shape observed in this checkout when JSONL archive writes are accepted but the SQLite index has not yet caught up. `null` when parity was not probed."
        },
        "reservationAuthoritative": {
          "type": ["boolean", "null"],
          "description": "bd-2z5ly.8: whether `file_reservation` evidence in this packet can be trusted. `false` or `null` means a candidate-safety classifier must downgrade confidence rather than treat the lane as conflict-free; never use a missing reservation list as positive evidence of no collision when this flag is not `true`."
        },
        "inboxAuthoritative": {
          "type": ["boolean", "null"],
          "description": "bd-2z5ly.8: whether `unreadCount` and `ackRequiredCount` reflect a fresh indexed snapshot. `false` or `null` means agents must not interpret a zero count as `no peer messages`."
        },
        "fallbackActions": {
          "type": "array",
          "description": "bd-2z5ly.8: ordered, structured recovery actions for an agent operating under degraded Agent Mail. MUST be sorted lexicographically by `kind` so the packet stays deterministic across runs. Empty when status is `fresh`/`healthy`. Replaces prose-only repair strings so harnesses can branch mechanically without parsing natural language.",
          "items": {"$ref": "#/definitions/agentMailFallbackAction"}
        },
        "semanticReadiness": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["status"],
          "description": "bd-2z5ly.8.1: independent semantic-readiness signal from the Agent Mail health response, parsed separately from `status` and `healthLevel` so a green transport response cannot mask a failing semantic-read path (for example malformed SQLite storage). When `status` is `fail` the candidate-safety classifier MUST treat reservation and inbox evidence as non-authoritative even when `healthLevel` is `green`; `reservationAuthoritative` and `inboxAuthoritative` MUST be `false` in that case. `reason` is a bounded reason class; never include filesystem paths, B-tree page numbers, raw error strings, PIDs, or stack frames.",
          "properties": {
            "status": {
              "type": "string",
              "enum": ["pass", "fail", "unknown"]
            },
            "reason": {
              "type": ["string", "null"],
              "enum": [
                "malformed_sqlite",
                "archive_corruption",
                "index_rebuild_required",
                "permission_denied",
                "unknown",
                null
              ],
              "description": "bd-2z5ly.8.1: bounded reason class for a semantic-readiness failure. Use `malformed_sqlite` when the SQLite storage image is corrupt, `archive_corruption` when the JSONL archive cannot be parsed, `index_rebuild_required` when the index is missing or out of date, `permission_denied` when the process cannot open the store, and `unknown` when classification was not possible. MUST NOT carry raw error text, file paths, or page offsets."
            }
          }
        }
      }
    },
    "agentMailFallbackAction": {
      "type": "object",
      "description": "bd-2z5ly.8: a single structured Agent Mail fallback step. `command` and `manualStep` are mutually informative: emitters set whichever applies and leave the other `null`. When `command` is present, `commandAction.argv` is the shell-free execution surface. No mail bodies, raw inbox content, or agent identities may appear in `summary`, `command`, `commandAction`, or `manualStep`.",
      "required": ["kind", "summary", "command", "commandAction", "manualStep"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "beads_comment",
            "manual_coordination",
            "record_only",
            "retry_later",
            "support_bundle",
            "switch_to_static_work"
          ]
        },
        "summary": {"type": "string"},
        "command": {"type": ["string", "null"]},
        "commandAction": {
          "anyOf": [
            {"$ref": "#/definitions/commandAction"},
            {"type": "null"}
          ]
        },
        "manualStep": {"type": ["string", "null"]}
      }
    },
    "activeClaim": {
      "type": "object",
      "required": ["beadId", "assignee", "status", "updatedAt", "sourceRefs"],
      "additionalProperties": false,
      "properties": {
        "beadId": {"type": "string"},
        "assignee": {"type": ["string", "null"]},
        "status": {"type": "string"},
        "updatedAt": {"type": ["string", "null"]},
        "sourceRefs": {"$ref": "#/definitions/stringArray"}
      }
    },
    "fileCollision": {
      "type": "object",
      "required": ["pathPattern", "risk", "owners", "relatedBeadIds", "evidence"],
      "additionalProperties": false,
      "properties": {
        "pathPattern": {"type": "string"},
        "risk": {"type": "string", "enum": ["low", "medium", "high"]},
        "owners": {"$ref": "#/definitions/stringArray"},
        "relatedBeadIds": {"$ref": "#/definitions/stringArray"},
        "evidence": {"$ref": "#/definitions/stringArray"}
      }
    },
    "trackerIntegrity": {
      "type": "object",
      "description": "bd-2z5ly.9: bounded Beads tracker integrity posture derived from `br doctor --json` or equivalent collector evidence. This section tells candidate-safety logic whether normal `br` reads are authoritative before an agent claims work. It never includes raw JSONL rows, DB contents, issue bodies, or repair mutations.",
      "required": [
        "health",
        "jsonlPath",
        "dbPath",
        "jsonlRecordCount",
        "dbRecordCount",
        "pendingImportCount",
        "externalChangesPendingImport",
        "dirtyIssueCount",
        "mergeArtifactPaths",
        "mergeArtifactCount",
        "jsonlParseError",
        "brReadsAuthoritative",
        "requiresCandidateDowngrade",
        "recoveryHint"
      ],
      "additionalProperties": false,
      "properties": {
        "health": {
          "type": "string",
          "enum": [
            "ok",
            "merge_artifacts_warn",
            "external_changes_pending_import",
            "db_jsonl_count_mismatch",
            "jsonl_parse_error"
          ]
        },
        "jsonlPath": {"type": "string"},
        "dbPath": {"type": "string"},
        "jsonlRecordCount": {"type": "integer", "minimum": 0},
        "dbRecordCount": {"type": "integer", "minimum": 0},
        "pendingImportCount": {"type": "integer", "minimum": 0},
        "externalChangesPendingImport": {"type": "boolean"},
        "dirtyIssueCount": {"type": "integer", "minimum": 0},
        "mergeArtifactPaths": {"$ref": "#/definitions/stringArray"},
        "mergeArtifactCount": {"type": "integer", "minimum": 0},
        "jsonlParseError": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["line", "column", "excerpt"],
          "properties": {
            "line": {"type": "integer", "minimum": 1},
            "column": {"type": ["integer", "null"], "minimum": 1},
            "excerpt": {
              "type": "string",
              "description": "Redacted and length-capped excerpt of the first malformed JSONL row."
            }
          }
        },
        "brReadsAuthoritative": {
          "type": "boolean",
          "description": "True only when the tracker health is `ok`; consumers must not treat ready-work or zero-conflict evidence as authoritative when false."
        },
        "requiresCandidateDowngrade": {
          "type": "boolean",
          "description": "True for parse errors and DB/JSONL count mismatches. Candidate-safety logic must refuse auto-claim style recommendations while true."
        },
        "recoveryHint": {"type": ["string", "null"]}
      }
    },
    "rchProofPosture": {
      "type": "object",
      "required": [
        "sourceEnabled",
        "remoteOnlyRequired",
        "posture",
        "healthyWorkerCount",
        "safeToLaunchCargoVerification",
        "localFallbackPrevented",
        "blockerCodes",
        "knownBlockers",
        "retryAfter"
      ],
      "additionalProperties": false,
      "properties": {
        "sourceEnabled": {"type": "boolean"},
        "remoteOnlyRequired": {"type": "boolean"},
        "posture": {
          "type": "string",
          "enum": ["remote_ready", "degraded_capacity", "topology_blocked", "unavailable", "unknown"]
        },
        "healthyWorkerCount": {"type": ["integer", "null"], "minimum": 0},
        "safeToLaunchCargoVerification": {"type": ["boolean", "null"]},
        "localFallbackPrevented": {"type": "boolean"},
        "blockerCodes": {"$ref": "#/definitions/stringArray"},
        "knownBlockers": {
          "type": "array",
          "items": {"$ref": "#/definitions/knownBlocker"}
        },
        "retryAfter": {"type": ["string", "null"]}
      }
    },
    "knownBlocker": {
      "type": "object",
      "description": "bd-2z5ly.6: bounded record of an RCH preflight / known-blocker hit that prevented a verification command from running. Preserves enough evidence (code, fingerprint, command hash, remediation bead, retry hint) for agents to decide whether to retry now, wait for retry_after, or record blocked evidence without local Cargo fallback. Source-health (rchProofPosture.posture) is separate from per-command verification outcome (verificationOutcome enum); a healthy RCH worker pool can still surface a known blocker for a specific argv shape.",
      "required": ["code", "fingerprint", "remoteRequired", "localFallbackRefused"],
      "additionalProperties": false,
      "properties": {
        "code": {"type": "string"},
        "fingerprint": {
          "type": "string",
          "description": "sha256-prefixed fingerprint of the blocker (e.g. `sha256:64139c3370a1...`). MUST match the upstream RCH known_blocker fingerprint verbatim so downstream reconciliation can compare without normalization."
        },
        "commandHash": {
          "type": ["string", "null"],
          "description": "Normalized argv hash of the blocked command if RCH supplied one. Bounded; do not embed raw stdout/stderr."
        },
        "message": {"type": ["string", "null"]},
        "remediationBead": {
          "type": ["string", "null"],
          "description": "Beads issue id (e.g. `bd-17c65.10.17.1.2`) tracking the remediation. Null when no canonical remediation bead is registered for this blocker."
        },
        "retryAfter": {"type": ["string", "null"]},
        "remoteRequired": {"type": "boolean"},
        "localFallbackRefused": {"type": "boolean"},
        "degradedCodes": {"$ref": "#/definitions/stringArray"}
      }
    },
    "verification": {
      "type": "object",
      "required": ["requiredCommands", "staticChecks", "closeoutEvidenceRequired"],
      "additionalProperties": false,
      "properties": {
        "requiredCommands": {
          "type": "array",
          "items": {"$ref": "#/definitions/verificationCommand"}
        },
        "staticChecks": {
          "type": "array",
          "items": {"$ref": "#/definitions/verificationCommand"}
        },
        "closeoutEvidenceRequired": {"type": "boolean"}
      }
    },
    "verificationCommand": {
      "type": "object",
      "required": ["commandId", "commandTemplate", "requiredSubstrate", "when", "lastOutcome"],
      "additionalProperties": false,
      "properties": {
        "commandId": {"type": "string"},
        "commandTemplate": {
          "type": "string",
          "description": "Legacy display-only command text retained during migration. This field MUST NOT be executed directly and is not shell-safe; consumers must prefer commandAction.argv when present."
        },
        "commandAction": {"$ref": "#/definitions/commandAction"},
        "requiredSubstrate": {"type": "string", "enum": ["rch", "static_local", "none"]},
        "when": {"type": "string"},
        "lastOutcome": {
          "type": "string",
          "description": "bd-2z5ly.6: outcome of the most recent attempted run of this command, as recorded by the work-packet generator. Distinguishes pre-Cargo RCH failures (`environment_blocked`) from test failures (`failed_project`) so agents do not retry a command whose blocker is environmental.",
          "enum": ["not_run", "passed", "failed_project", "environment_blocked"]
        },
        "lastCommandHash": {
          "type": ["string", "null"],
          "description": "Normalized argv hash of the most recent attempted run. Joins with `knownBlocker.commandHash` for cross-evidence reconciliation."
        }
      }
    },
    "sourceProvenance": {
      "type": "object",
      "required": ["source", "collector", "status", "freshness", "digest", "redaction"],
      "additionalProperties": false,
      "properties": {
        "source": {"type": "string"},
        "collector": {"type": "string"},
        "status": {"type": "string", "enum": ["fresh", "stale", "degraded", "unavailable", "skipped"]},
        "freshness": {"type": ["string", "null"]},
        "digest": {"type": ["string", "null"]},
        "redaction": {"type": "string"}
      }
    },
    "mutationPolicy": {
      "type": "object",
      "required": [
        "sideEffectFree",
        "claimsBeads",
        "reservesFiles",
        "sendsAgentMail",
        "runsCargo",
        "stagesGit",
        "deletesFiles"
      ],
      "additionalProperties": false,
      "properties": {
        "sideEffectFree": {"type": "boolean", "const": true},
        "claimsBeads": {"type": "boolean", "const": false},
        "reservesFiles": {"type": "boolean", "const": false},
        "sendsAgentMail": {"type": "boolean", "const": false},
        "runsCargo": {"type": "boolean", "const": false},
        "stagesGit": {"type": "boolean", "const": false},
        "deletesFiles": {"type": "boolean", "const": false}
      }
    },
    "degradation": {
      "type": "object",
      "required": ["code", "source", "severity", "message", "repair"],
      "additionalProperties": false,
      "properties": {
        "code": {"type": "string"},
        "source": {"type": "string"},
        "severity": {"type": "string", "enum": ["info", "low", "warning", "medium", "high", "critical"]},
        "message": {"type": "string"},
        "repair": {"type": ["string", "null"]}
      }
    }
  },
  "examples": [
    {
      "schema": "ee.swarm.work_packet.v1",
      "packetId": "swarm_work_packet_healthy_small_repo_0001",
      "workspace": "repo:25e38e130474e7f0292de2a3",
      "redactionStatus": "counts_ids_statuses_path_patterns_command_templates_no_mail_body_no_file_content",
      "observedStateClass": "healthy_small_repo",
