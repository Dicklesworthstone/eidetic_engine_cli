      "additionalProperties": false,
      "properties": {
        "schema": {"type": "string"},
        "status": {"type": "string"},
        "available": {"type": "boolean"},
        "headRef": {"oneOf": [{"type": "null"}, {"type": "string"}]},
        "upstreamRef": {"oneOf": [{"type": "null"}, {"type": "string"}]},
