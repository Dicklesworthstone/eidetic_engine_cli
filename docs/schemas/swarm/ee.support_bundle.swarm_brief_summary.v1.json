    "resourcePressurePosture",
    "singleFlight",
    "degradedCodes",
    "fileSurfaceRiskSummary",
    "readyReservationPressureSummary",
    "stalledBeadLivenessSummary",
    "symbolRiskSummary",
    "topRecommendations",
    "provenance",
    "redaction"
