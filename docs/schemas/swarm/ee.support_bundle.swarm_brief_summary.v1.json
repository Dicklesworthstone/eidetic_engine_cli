    "resourcePressurePosture": {"type": "string"},
    "rchWorkerPressure": {"$ref": "#/definitions/rchWorkerPressure"},
    "singleFlight": {"$ref": "#/definitions/singleFlightPosture"},
    "degradedCodes": {
      "type": "array",
      "items": {"type": "string"}
