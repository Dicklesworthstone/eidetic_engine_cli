  "definitions": {
    "stringArray": {
      "type": "array",
      "items": {"type": "string"}
    },
    "fileSurfaceRiskSummary": {
      "type": "object",
      "required": ["countsBySeverity", "countsByReservationHolder", "countsByGitStatus", "topRisks"],
      "additionalProperties": false,
      "properties": {
        "countsBySeverity": {"type": "object"},
        "countsByReservationHolder": {
          "type": "object",
          "description": "Counts keyed by BLAKE3 hashes of reservation-holder labels from the underlying swarm brief."
        },
        "countsByGitStatus": {"type": "object"},
        "topRisks": {
          "type": "array",
          "items": {"$ref": "#/definitions/topRisk"}
        }
      }
    },
    "readyReservationPressureSummary": {
      "type": "object",
      "required": ["countsByAction", "countsBySeverity", "countsByReservationHolder", "topReadyBeads"],
      "additionalProperties": false,
      "properties": {
        "countsByAction": {"type": "object"},
        "countsBySeverity": {"type": "object"},
        "countsByReservationHolder": {
          "type": "object",
          "description": "Counts keyed by BLAKE3 hashes of reservation-holder labels from the underlying swarm brief."
