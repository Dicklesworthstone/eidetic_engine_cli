{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://eidetic-engine/schemas/swarm/ee.swarm.unsafe_claim_plan.v1.json",
  "title": "ee.swarm.unsafe_claim_plan.v1",
  "description": "Companion, non-mutating planner contract for an unsafe ee.swarm.work_packet.claim_gate.v1 result. The plan preserves the original gate evidence, groups blockers into a stable reason taxonomy, and emits advisory actions that never claim, reserve, stage, run Cargo, send Agent Mail, or otherwise mutate state.",
  "type": "object",
  "additionalProperties": false,
  "x-ee-status": {
    "shipped": true,
    "available_in_build": true,
    "tracking_bead": "bd-1n3x1.16.1",
    "notes": "Shipped: `ee swarm work-packet --unsafe-plan` emits this companion plan for an unsafe claim gate (bd-1n3x1.16). The plan is advisory only and intentionally does not make unsafe claims safe."
  },
  "x-ee-doc": "docs/swarm/unsafe_claim_plan.md",
  "required": [
    "schema",
    "planId",
    "generatedAt",
    "workspace",
    "redactionStatus",
    "ordering",
    "sourceGate",
    "reasonGroups",
    "candidatePlans",
    "plannerActions",
    "nextCommandActions",
    "evidenceSources",
    "nonMutationPolicy",
    "degraded",
    "provenanceHash"
  ],
  "properties": {
    "schema": { "type": "string", "const": "ee.swarm.unsafe_claim_plan.v1" },
    "planId": {
      "type": "string",
      "pattern": "^unsafe_claim_plan_[a-f0-9]{24}$",
      "description": "Deterministic content identifier for this plan projection."
    },
    "generatedAt": { "type": "string", "format": "date-time" },
    "workspace": {
      "type": "string",
      "minLength": 1,
      "description": "Redacted workspace label or stable workspace hash, never an unredacted home path."
    },
    "redactionStatus": {
      "type": "string",
      "const": "counts_ids_statuses_path_patterns_command_templates_no_mail_body_no_file_content"
    },
    "ordering": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reasonGroups",
        "candidatePlans",
        "plannerActions",
        "evidenceSources"
      ],
      "properties": {
        "reasonGroups": {
          "type": "string",
          "const": "reasonCategory enum order, then groupId ascending byte order"
        },
        "candidatePlans": {
          "type": "string",
          "const": "candidateId ascending byte order"
        },
        "plannerActions": {
          "type": "string",
          "const": "plannerActionKind enum order, then actionId ascending byte order"
        },
        "evidenceSources": {
          "type": "string",
          "const": "sourceId ascending byte order"
        }
      }
    },
    "sourceGate": { "$ref": "#/definitions/sourceGate" },
    "reasonGroups": {
      "type": "array",
      "items": { "$ref": "#/definitions/reasonGroup" },
      "description": "Grouped blockers, sorted by the ordering contract. Unknown future reasons must remain visible in the unknown group."
    },
    "candidatePlans": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/candidatePlan" }
    },
    "plannerActions": {
      "type": "array",
      "items": { "$ref": "#/definitions/plannerAction" }
    },
    "nextCommandActions": {
      "type": "array",
      "description": "Additional non-mutating inspections derived by the planner. The original gate nextCommandActions remain preserved under sourceGate.",
      "items": { "$ref": "#/definitions/readOnlyCommandAction" }
    },
    "evidenceSources": {
      "type": "array",
      "items": { "$ref": "#/definitions/evidenceSource" }
    },
    "nonMutationPolicy": { "$ref": "#/definitions/nonMutationPolicy" },
    "degraded": {
      "type": "array",
      "items": { "$ref": "#/definitions/degradation" }
    },
    "provenanceHash": {
      "type": "string",
      "pattern": "^(blake3|sha256):[0-9a-f]{8,64}$"
    }
  },
  "definitions": {
    "safeString": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          { "pattern": "BEGIN PRIVATE KEY" },
          { "pattern": "BEGIN OPENSSH PRIVATE KEY" },
          { "pattern": "ghp_[A-Za-z0-9_]+" },
          { "pattern": "Bearer [A-Za-z0-9._-]+" },
          { "pattern": "DATABASE_URL=" },
          { "pattern": "From: " },
          { "pattern": "Subject: " },
          { "pattern": "Message-ID:" },
          { "pattern": "body:" },
          { "pattern": "raw_inbox" },
          { "pattern": "stdout:" },
          { "pattern": "stderr:" },
          { "pattern": "/Users/[^\\s]+" },
          { "pattern": "/home/[^\\s]+" }
        ]
      }
    },
    "stringArray": {
      "type": "array",
      "items": { "type": "string" }
    },
    "safeStringArray": {
      "type": "array",
      "items": { "$ref": "#/definitions/safeString" }
    },
    "reasonCategory": {
      "type": "string",
      "enum": [
        "tracker_authority",
        "agent_mail_readiness",
        "source_overlap",
        "dirty_checkout",
        "rch_proof_admission",
        "installed_binary_freshness",
        "reservation_conflict",
        "bv_staleness",
        "recommendation_mismatch",
        "memory_source_drift",
        "resource_admission",
        "action_suppression",
        "unknown"
      ]
    },
    "plannerActionKind": {
      "type": "string",
      "enum": [
        "inspect",
        "comment_template",
        "decompose_candidate",
        "alternate_candidate",
        "retry_with_snapshot",
        "wait_or_coordinate",
        "stop"
      ]
    },
    "copySafety": {
      "type": "string",
      "enum": [
        "safe_structured_argv",
        "display_only",
        "shell_required_review",
        "forbidden_until_human_approval"
      ]
    },
    "commandSubstrate": {
      "type": "string",
      "enum": [
        "agent_mail",
        "beads",
        "bv",
        "ee",
        "git",
        "human",
        "jq",
        "rch",
        "static_local",
        "none"
      ]
    },
    "argvArray": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/safeString" }
    },
    "readOnlyCommandAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commandId",
        "displayCommand",
        "argv",
        "shellRequired",
        "copySafety",
        "mutatesState",
        "requiredSubstrate",
        "when",
        "rationale"
      ],
      "properties": {
        "commandId": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]+$" },
        "displayCommand": { "$ref": "#/definitions/safeString" },
        "argv": { "$ref": "#/definitions/argvArray" },
        "shellRequired": { "type": "boolean" },
        "copySafety": { "$ref": "#/definitions/copySafety" },
        "mutatesState": { "const": false },
        "requiredSubstrate": { "$ref": "#/definitions/commandSubstrate" },
        "when": { "$ref": "#/definitions/safeString" },
        "rationale": {
          "allOf": [{ "$ref": "#/definitions/safeString" }],
          "maxLength": 240
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "copySafety": { "const": "safe_structured_argv" } },
            "required": ["copySafety"]
          },
          "then": { "properties": { "shellRequired": { "const": false } } }
        }
      ]
    },
    "sourceGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "gateId",
        "packetId",
        "requestedCandidateId",
        "selectedCandidateId",
        "verdict",
        "safeToClaim",
        "recommendedAction",
        "recommendedSafeToClaim",
        "claimCommandAction",
        "unsafeReasons",
        "staleReasons",
        "degradedCodes",
        "sourceRefs",
        "nextCommandActions"
      ],
      "properties": {
        "schema": { "type": "string", "const": "ee.swarm.work_packet.claim_gate.v1" },
        "gateId": { "type": "string", "pattern": "^swarm_work_packet_claim_gate_[a-f0-9]{24}$" },
        "packetId": { "type": "string", "pattern": "^swarm_work_packet_[a-f0-9]{24}$" },
        "requestedCandidateId": { "type": ["string", "null"] },
        "selectedCandidateId": { "type": ["string", "null"] },
        "verdict": { "$ref": "#/definitions/safeString" },
        "safeToClaim": { "const": false },
        "recommendedAction": { "$ref": "#/definitions/safeString" },
        "recommendedSafeToClaim": { "type": ["boolean", "null"] },
        "claimCommandAction": { "const": null },
        "unsafeReasons": { "$ref": "#/definitions/safeStringArray" },
        "staleReasons": { "$ref": "#/definitions/safeStringArray" },
        "degradedCodes": { "$ref": "#/definitions/safeStringArray" },
        "sourceRefs": { "$ref": "#/definitions/safeStringArray" },
        "nextCommandActions": {
          "type": "array",
          "items": { "$ref": "#/definitions/readOnlyCommandAction" }
        }
      }
    },
    "reasonGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "groupId",
        "category",
        "severity",
        "reasonCodes",
        "rawReasonIndexes",
        "sourceFields",
        "evidenceSourceIds",
        "candidateCoverage",
        "boundedPreview",
        "preservesUnknown"
      ],
      "properties": {
        "groupId": { "type": "string", "pattern": "^rg-[a-z0-9-]+$" },
        "category": { "$ref": "#/definitions/reasonCategory" },
        "severity": {
          "type": "string",
          "enum": ["info", "low", "warning", "medium", "high", "critical"]
        },
        "reasonCodes": { "$ref": "#/definitions/safeStringArray" },
        "rawReasonIndexes": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 }
        },
        "sourceFields": { "$ref": "#/definitions/safeStringArray" },
        "evidenceSourceIds": { "$ref": "#/definitions/safeStringArray" },
        "candidateCoverage": {
          "type": "array",
          "items": { "type": "string", "enum": ["all_candidates", "requested_candidate", "alternate_candidate", "unknown"] }
        },
        "boundedPreview": {
          "allOf": [{ "$ref": "#/definitions/safeString" }],
          "maxLength": 240
        },
        "preservesUnknown": { "type": "boolean" }
      }
    },
    "candidatePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
