        "gateVerdict": { "$ref": "#/definitions/safeString" },
        "safeToClaim": { "type": "boolean" },
        "reasonGroupRefs": { "$ref": "#/definitions/safeStringArray" },
        "candidateSpecificDeltas": { "$ref": "#/definitions/safeStringArray" },
        "needsFreshClaimGate": { "type": "boolean" },
        "mayEmitClaimCommand": { "const": false },
        "evidenceSourceIds": { "$ref": "#/definitions/safeStringArray" }
      }
    },
    "plannerAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actionId",
        "kind",
        "mutatesState",
        "advisoryOnly",
        "requiredSubstrate",
        "copySafety",
        "when",
        "rationale",
        "reasonGroupRefs",
        "evidenceSourceIds",
        "commandAction",
        "bodyTemplate"
      ],
      "properties": {
        "actionId": { "type": "string", "pattern": "^act-[a-z0-9-]+$" },
        "kind": { "$ref": "#/definitions/plannerActionKind" },
        "mutatesState": { "const": false },
        "advisoryOnly": { "const": true },
        "requiredSubstrate": { "$ref": "#/definitions/commandSubstrate" },
        "copySafety": { "$ref": "#/definitions/copySafety" },
        "when": { "$ref": "#/definitions/safeString" },
        "rationale": {
          "allOf": [{ "$ref": "#/definitions/safeString" }],
          "maxLength": 240
        },
        "reasonGroupRefs": { "$ref": "#/definitions/safeStringArray" },
        "evidenceSourceIds": { "$ref": "#/definitions/safeStringArray" },
        "commandAction": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/definitions/readOnlyCommandAction" }
          ]
        },
        "bodyTemplate": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/definitions/bodyTemplate" }
          ]
        }
      }
    },
    "bodyTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["templateKind", "title", "bodyPreview", "truncated"],
      "properties": {
        "templateKind": { "type": "string", "enum": ["beads_comment", "agent_mail_message", "human_note"] },
        "title": {
          "allOf": [{ "$ref": "#/definitions/safeString" }],
          "maxLength": 120
        },
        "bodyPreview": {
          "allOf": [{ "$ref": "#/definitions/safeString" }],
          "maxLength": 400
        },
        "truncated": { "type": "boolean" }
      }
    },
    "evidenceSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "sourceKind",
        "sourceRef",
        "freshnessState",
        "authoritative"
      ],
      "properties": {
        "sourceId": { "type": "string", "pattern": "^src-[a-z0-9-]+$" },
        "sourceKind": {
          "type": "string",
          "enum": [
            "actionable_queue",
            "agent_mail",
            "beads",
            "bv",
            "git",
            "installed_binary",
            "memory_drift",
            "rch",
            "resource_admission",
            "source_authority",
            "workspace_hygiene"
          ]
        },
        "sourceRef": { "$ref": "#/definitions/safeString" },
        "freshnessState": { "type": "string", "enum": ["fresh", "stale", "unknown"] },
        "authoritative": { "type": "boolean" }
      }
    },
    "nonMutationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "advisoryOnly",
        "claimsBeads",
        "reservesFiles",
        "sendsAgentMail",
        "runsCargo",
        "stagesGit",
        "deletesFiles"
      ],
      "properties": {
        "advisoryOnly": { "const": true },
        "claimsBeads": { "const": false },
        "reservesFiles": { "const": false },
        "sendsAgentMail": { "const": false },
        "runsCargo": { "const": false },
        "stagesGit": { "const": false },
        "deletesFiles": { "const": false }
      }
    },
    "degradation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message"],
      "properties": {
        "code": { "$ref": "#/definitions/safeString" },
        "severity": {
          "type": "string",
          "enum": ["info", "low", "warning", "medium", "high", "critical"]
        },
        "message": {
          "allOf": [{ "$ref": "#/definitions/safeString" }],
          "maxLength": 240
        },
        "source": { "type": ["string", "null"] }
      }
    }
  },
