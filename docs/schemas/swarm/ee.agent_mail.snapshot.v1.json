{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://eidetic-engine/schemas/swarm/ee.agent_mail.snapshot.v1.json",
  "title": "ee.agent_mail.snapshot.v1",
  "description": "Redaction-safe full Agent Mail snapshot produced outside ee for swarm brief, workspace hygiene, and claim-gate evidence refresh. Inbox counts come from am status; inbox rows are used only for thread projection. Readiness and durability are checked independently and the stricter posture wins. Conformance to this JSON Schema is necessary structural validation, but it is not sufficient to authorize coordination or claims; authoritative consumers must also run the strict declared-v1 semantic validator.",
  "$comment": "Draft-07 cannot express every required cross-field invariant. Before treating a snapshot as authoritative, consumers MUST also verify the six ordered source-command identities, shared CLI executable prefix, inbox/status agent binding to agent_name, command_status/source_commands equality by index, summary counts against their arrays, am_agents_list_ok against the first status, failed-status metadata, one-for-one failed-status/degraded correspondence, and absence of normalized rows from failed sources. The shipped ee consumers perform this strict semantic validation in addition to schema, workspace-binding, and freshness checks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generated_at",
    "project_key",
    "agent_name",
    "redaction_status",
    "producer_status",
    "source_commands",
    "command_statuses",
    "fallback_active",
    "am_agents_list_ok",
    "summary",
    "degraded",
    "file_reservations",
    "agents",
    "inbox",
    "threads"
  ],
  "properties": {
    "schema": { "type": "string", "const": "ee.agent_mail.snapshot.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "project_key": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "Redaction-safe SHA-256 binding to the producer's physical canonical UTF-8 workspace identity. On macOS, the producer recovers the filesystem's canonical path spelling so case aliases hash identically to Rust realpath. Windows identities use forward slashes, omit the extended-length prefix, and lowercase the drive letter. Consumers recompute it for the workspace being gated; non-UTF-8 canonical paths fail closed."
    },
    "agent_name": { "type": "string", "minLength": 1 },
    "redaction_status": {
      "type": "string",
      "const": "paths_counts_subjects_only_no_content"
    },
    "producer_status": { "type": "string", "enum": ["ok", "degraded"] },
    "source_commands": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "additionalItems": false,
      "items": [
        { "type": "string", "minLength": 1 },
        { "type": "string", "minLength": 1 },
        { "type": "string", "minLength": 1 },
        { "type": "string", "minLength": 1 },
        { "const": "agent-mail-health http://127.0.0.1:8765/health" },
        { "const": "agent-mail-health http://127.0.0.1:8765/health/durability" }
      ],
      "description": "Exactly six ordered, redacted read-only sources. The schema fixes the two health resources; the strict semantic validator additionally verifies the four CLI command identities, their shared executable prefix, and agent_name binding."
    },
    "command_statuses": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "additionalItems": false,
      "items": [
        { "$ref": "#/$defs/commandStatusCli" },
        { "$ref": "#/$defs/commandStatusCli" },
        { "$ref": "#/$defs/commandStatusCli" },
        { "$ref": "#/$defs/commandStatusCli" },
        { "$ref": "#/$defs/commandStatusHttp" },
        { "$ref": "#/$defs/commandStatusHttp" }
      ]
    },
    "fallback_active": { "type": "boolean" },
    "am_agents_list_ok": { "type": "boolean" },
    "health_level": { "type": "string", "enum": ["green", "yellow", "red"] },
    "semantic_readiness": { "$ref": "#/$defs/semanticReadiness" },
    "durability_state": {
      "type": "string",
      "enum": ["ok", "corrupt", "repair_required", "unknown_recovery"]
    },
    "recovery": { "$ref": "#/$defs/recovery" },
    "summary": { "$ref": "#/$defs/summary" },
    "degraded": {
      "type": "array",
      "items": { "$ref": "#/$defs/degradation" }
    },
    "file_reservations": {
      "type": "array",
      "items": { "$ref": "#/$defs/fileReservation" }
    },
    "agents": {
      "type": "array",
      "items": { "$ref": "#/$defs/agent" }
    },
    "inbox": {
      "type": "array",
      "items": { "$ref": "#/$defs/inbox" }
    },
    "threads": {
      "type": "array",
      "items": { "$ref": "#/$defs/thread" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "fallback_active": { "const": false } },
        "required": ["fallback_active"]
      },
      "then": {
        "properties": {
          "producer_status": { "const": "ok" },
          "command_statuses": {
            "not": {
              "contains": {
                "type": "object",
                "properties": { "ok": { "const": false } },
                "required": ["ok"]
              }
            }
          },
          "health_level": { "const": "green" },
          "semantic_readiness": {
            "type": "object",
            "properties": { "status": { "const": "pass" } }
          },
          "durability_state": { "const": "ok" }
        },
        "not": { "required": ["recovery"] }
      }
    },
    {
      "if": {
        "properties": { "fallback_active": { "const": true } },
        "required": ["fallback_active"]
      },
      "then": {
        "properties": { "producer_status": { "const": "degraded" } },
        "anyOf": [
          {
            "properties": {
              "command_statuses": {
                "contains": {
                  "type": "object",
                  "properties": { "ok": { "const": false } },
                  "required": ["ok"]
                }
              }
            }
          },
          {
            "properties": { "health_level": { "enum": ["yellow", "red"] } },
            "required": ["health_level"]
          },
          {
            "properties": {
              "semantic_readiness": {
                "type": "object",
                "properties": { "status": { "enum": ["fail", "unknown"] } },
                "required": ["status"]
              }
            },
            "required": ["semantic_readiness"]
          },
          {
            "properties": {
              "durability_state": {
                "enum": ["corrupt", "repair_required", "unknown_recovery"]
              }
            },
            "required": ["durability_state"]
          },
          { "required": ["recovery"] }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "command_statuses": {
            "items": [
              {},
              {},
              {},
              {},
              {
                "type": "object",
                "properties": { "ok": { "const": true } },
                "required": ["ok"]
              }
            ]
          }
        }
      },
      "then": { "required": ["health_level"] }
    },
    {
      "if": {
        "properties": {
          "command_statuses": {
            "items": [
              {},
              {},
              {},
              {},
              {
                "type": "object",
                "properties": { "ok": { "const": false } },
                "required": ["ok"]
              }
            ]
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            { "required": ["health_level"] },
            { "required": ["semantic_readiness"] }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "command_statuses": {
            "items": [
              {},
              {},
              {},
              {},
              {},
              {
                "type": "object",
                "properties": { "ok": { "const": true } },
                "required": ["ok"]
              }
            ]
          }
        }
      },
      "then": { "required": ["durability_state"] }
    },
    {
      "oneOf": [
        {
          "properties": { "durability_state": { "const": "ok" } },
          "required": ["durability_state"],
          "not": { "required": ["recovery"] }
        },
        {
          "properties": {
            "durability_state": { "const": "corrupt" },
            "recovery": {
              "type": "object",
              "properties": { "mode": { "const": "corrupt" } }
            }
          },
          "required": ["durability_state", "recovery"]
        },
        {
          "properties": {
            "durability_state": { "const": "repair_required" },
            "recovery": {
              "type": "object",
              "properties": { "mode": { "const": "repair_required" } }
            }
          },
          "required": ["durability_state", "recovery"]
        },
        {
          "properties": {
            "durability_state": { "const": "unknown_recovery" },
            "recovery": {
              "type": "object",
              "properties": { "mode": { "const": "unknown_recovery" } }
            }
          },
          "required": ["durability_state", "recovery"]
        },
        {
          "not": {
            "anyOf": [
              { "required": ["durability_state"] },
              { "required": ["recovery"] }
            ]
          }
        }
      ]
    }
  ],
  "$defs": {
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_count",
        "file_reservation_count",
        "inbox_mailbox_count",
        "thread_count",
        "source_command_count",
        "degraded_count"
      ],
      "properties": {
        "agent_count": { "type": "integer", "minimum": 0 },
        "file_reservation_count": { "type": "integer", "minimum": 0 },
        "inbox_mailbox_count": { "type": "integer", "minimum": 0 },
        "thread_count": { "type": "integer", "minimum": 0 },
        "source_command_count": { "type": "integer", "const": 6 },
        "degraded_count": { "type": "integer", "minimum": 0 }
      }
    },
    "commandStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "ok", "exit_code", "timed_out", "error_class"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "ok": { "type": "boolean" },
        "exit_code": { "type": ["integer", "null"] },
        "timed_out": { "type": "boolean" },
        "error_class": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "ok": { "const": false } },
            "required": ["ok"]
          },
          "then": {
            "anyOf": [
              {
                "properties": { "timed_out": { "const": true } },
                "required": ["timed_out"]
              },
              {
                "properties": {
                  "error_class": { "type": "string", "minLength": 1 }
                },
                "required": ["error_class"]
              }
            ]
          }
        }
      ]
    },
    "commandStatusCli": {
      "allOf": [
        { "$ref": "#/$defs/commandStatus" },
        {
          "if": {
            "properties": { "ok": { "const": true } },
            "required": ["ok"]
          },
          "then": {
            "properties": {
              "exit_code": { "const": 0 },
              "timed_out": { "const": false },
              "error_class": { "const": null }
            }
          }
        }
      ]
    },
    "commandStatusHttp": {
      "allOf": [
        { "$ref": "#/$defs/commandStatus" },
        {
          "if": {
            "properties": { "ok": { "const": true } },
            "required": ["ok"]
          },
          "then": {
            "properties": {
              "exit_code": { "const": 200 },
              "timed_out": { "const": false },
              "error_class": { "const": null }
            }
          }
        }
      ]
    },
    "degradation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity",
        "source",
        "command",
        "error_class",
        "exit_code",
        "timed_out"
      ],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "severity": {
          "type": "string",
          "enum": ["info", "low", "warning", "medium", "high", "critical"]
        },
        "source": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 },
        "error_class": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "exit_code": { "type": ["integer", "null"] },
        "timed_out": { "type": "boolean" }
      }
    },
    "semanticReadiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "enum": ["pass", "fail", "unknown"] },
        "reason": {
          "type": "string",
          "enum": [
            "malformed_sqlite",
            "archive_corruption",
            "index_rebuild_required",
            "permission_denied",
            "unknown"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "fail" } },
            "required": ["status"]
          },
          "then": { "required": ["reason"] },
          "else": { "not": { "required": ["reason"] } }
        }
      ]
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "reason"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["corrupt", "repair_required", "unknown_recovery"]
        },
        "reason": {
          "type": "string",
          "enum": ["archive_corruption", "storage_recovery_required", "permission_denied", "unknown"]
        }
      }
    },
    "fileReservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path_pattern", "holder", "exclusive"],
      "properties": {
        "path_pattern": { "type": "string", "minLength": 1 },
        "holder": { "type": "string", "minLength": 1 },
        "exclusive": { "type": "boolean" },
        "expires_ts": { "type": "string", "format": "date-time" }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "last_active_ts": { "type": "string", "format": "date-time" }
      }
    },
    "inbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mailbox", "unread_count", "ack_required_count"],
      "properties": {
        "mailbox": { "type": "string", "minLength": 1 },
        "unread_count": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 },
        "ack_required_count": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 }
      }
    },
    "thread": {
      "type": "object",
      "additionalProperties": false,
      "required": ["thread_id", "message_count"],
      "properties": {
        "thread_id": { "type": "string", "minLength": 1 },
        "message_count": { "type": "integer", "minimum": 0 },
        "subject": { "type": "string" },
        "last_activity_at": { "type": "string", "format": "date-time" }
      }
    }
  },
  "examples": [
