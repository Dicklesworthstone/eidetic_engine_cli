{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://eidetic-engine/schemas/swarm/ee.swarm.repair_plan.v1.json",
  "title": "ee.swarm.repair_plan.v1",
  "description": "Read-only degraded-stack repair plan derived from a swarm work-packet claim gate. The plan defines the allowed repair action vocabulary, safety classes, source evidence, and stop conditions without claiming work, reserving files, sending Agent Mail, running Cargo, staging Git, deleting files, or executing repairs.",
  "type": "object",
  "additionalProperties": false,
  "x-ee-status": {
    "shipped": true,
    "available_in_build": true,
    "tracking_bead": "bd-22po3.1",
    "notes": "Shipped: `ee swarm repair-plan --json` emits this advisory contract from current work-packet and claim-gate evidence."
  },
  "x-ee-doc": "docs/swarm/repair_plan.md",
  "required": [
    "schema",
    "planId",
    "packetId",
    "gateId",
    "generatedAt",
    "workspace",
    "redactionStatus",
    "ordering",
    "sourceGate",
    "sourceEvidence",
    "actionVocabulary",
    "actions",
    "stopConditions",
    "nonMutationPolicy",
    "degraded",
    "provenanceHash"
  ],
  "properties": {
    "schema": { "type": "string", "const": "ee.swarm.repair_plan.v1" },
    "planId": { "type": "string", "pattern": "^swarm_repair_plan_[a-f0-9]{24}$" },
    "packetId": { "type": "string", "pattern": "^swarm_work_packet_[a-f0-9]{24}$" },
    "gateId": { "type": "string", "pattern": "^swarm_work_packet_claim_gate_[a-f0-9]{24}$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "workspace": { "$ref": "#/definitions/safeString" },
    "redactionStatus": {
      "type": "string",
      "const": "counts_ids_statuses_path_patterns_command_templates_no_mail_body_no_file_content"
    },
    "ordering": { "$ref": "#/definitions/ordering" },
    "sourceGate": { "$ref": "#/definitions/sourceGate" },
    "sourceEvidence": {
      "type": "array",
      "items": { "$ref": "#/definitions/sourceEvidence" }
    },
    "actionVocabulary": {
      "type": "array",
      "minItems": 8,
      "items": { "$ref": "#/definitions/actionVocabularyEntry" }
    },
    "actions": {
      "type": "array",
      "items": { "$ref": "#/definitions/action" }
    },
    "stopConditions": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/definitions/stopCondition" }
    },
    "nonMutationPolicy": { "$ref": "#/definitions/nonMutationPolicy" },
    "degraded": {
      "type": "array",
      "items": { "$ref": "#/definitions/degradation" }
    },
    "provenanceHash": { "type": "string", "pattern": "^blake3:[0-9a-f]{32,64}$" }
  },
  "definitions": {
    "safeString": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          { "pattern": "BEGIN PRIVATE KEY" },
          { "pattern": "BEGIN OPENSSH PRIVATE KEY" },
          { "pattern": "ghp_[A-Za-z0-9_]+" },
          { "pattern": "Bearer [A-Za-z0-9._-]+" },
          { "pattern": "DATABASE_URL=" },
          { "pattern": "From: " },
          { "pattern": "Subject: " },
          { "pattern": "Message-ID:" },
          { "pattern": "body:" },
          { "pattern": "raw_inbox" },
          { "pattern": "stdout:" },
          { "pattern": "stderr:" },
          { "pattern": "/Users/[^\\s]+" },
          { "pattern": "/home/[^\\s]+" }
        ]
      }
    },
    "stringArray": {
      "type": "array",
      "items": { "type": "string" }
    },
    "repairActionKind": {
      "type": "string",
      "enum": [
        "wait_for_rch_build",
        "message_holder",
        "repair_agent_mail_archive",
        "rerun_snapshot",
        "refresh_bv_bounded",
        "inspect_beads_doctor",
        "rerun_claim_gate",
        "ask_human_for_destructive_repair"
      ]
    },
    "safetyClass": {
      "type": "string",
      "enum": [
        "read_only_probe",
        "read_only_or_wait",
        "coordination_mutation",
        "tracker_mutation",
        "external_repair",
        "human_approval_required",
        "forbidden_out_of_scope"
      ]
    },
    "copySafety": {
      "type": "string",
      "enum": [
        "safe_structured_argv",
        "display_only",
        "shell_required_review",
        "forbidden_until_human_approval"
      ]
    },
    "ordering": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceEvidence", "actionVocabulary", "actions", "stopConditions"],
      "properties": {
        "sourceEvidence": { "type": "string", "const": "sourceKind ascending byte order" },
        "actionVocabulary": { "type": "string", "const": "action kind enum order" },
        "actions": { "type": "string", "const": "priority ascending, then action kind enum order" },
        "stopConditions": { "type": "string", "const": "stop condition id ascending byte order" }
      }
    },
    "sourceGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gateId",
        "packetId",
        "requestedCandidateId",
        "selectedCandidateId",
        "verdict",
        "safeToClaim",
        "recommendedAction",
        "recommendedSafeToClaim",
        "unsafeReasonCount",
        "staleReasonCount",
        "degradedCodes",
        "claimCommandActionPresent"
      ],
      "properties": {
        "gateId": { "type": "string" },
        "packetId": { "type": "string" },
        "requestedCandidateId": { "type": ["string", "null"] },
        "selectedCandidateId": { "type": ["string", "null"] },
        "verdict": { "type": "string", "minLength": 1 },
        "safeToClaim": { "type": "boolean" },
        "recommendedAction": { "type": "string", "minLength": 1 },
        "recommendedSafeToClaim": { "type": ["boolean", "null"] },
        "unsafeReasonCount": { "type": "integer", "minimum": 0 },
        "staleReasonCount": { "type": "integer", "minimum": 0 },
        "degradedCodes": { "$ref": "#/definitions/stringArray" },
        "claimCommandActionPresent": { "type": "boolean" }
      }
    },
    "sourceEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "sourceKind",
        "state",
        "authoritative",
        "freshnessState",
        "timedOut",
        "exitClass",
        "detail",
        "degradedCodes"
      ],
      "properties": {
        "sourceId": { "type": "string", "pattern": "^source:[a-z0-9_:-]+$" },
        "sourceKind": { "type": "string", "minLength": 1 },
        "state": { "type": "string", "minLength": 1 },
        "authoritative": { "type": "boolean" },
        "freshnessState": { "type": "string", "minLength": 1 },
        "timedOut": { "type": "boolean" },
        "exitClass": { "type": "string", "minLength": 1 },
        "detail": { "$ref": "#/definitions/safeString" },
        "degradedCodes": { "$ref": "#/definitions/stringArray" }
      }
    },
    "actionVocabularyEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "safetyClass",
        "executionBoundary",
        "description",
        "requiresFreshAuthority"
      ],
      "properties": {
        "kind": { "$ref": "#/definitions/repairActionKind" },
        "safetyClass": { "$ref": "#/definitions/safetyClass" },
        "executionBoundary": { "type": "string", "minLength": 1 },
        "description": { "$ref": "#/definitions/safeString" },
        "requiresFreshAuthority": { "type": "boolean" }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "priority",
        "kind",
        "title",
        "safety",
        "commandAction",
        "manualStep",
        "sourceRefs",
        "rationale",
        "stopConditionRefs"
      ],
      "properties": {
        "priority": { "type": "integer", "minimum": 0, "maximum": 255 },
        "kind": { "$ref": "#/definitions/repairActionKind" },
        "title": { "$ref": "#/definitions/safeString" },
        "safety": { "$ref": "#/definitions/actionSafety" },
        "commandAction": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/definitions/commandAction" }
          ]
        },
        "manualStep": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/definitions/safeString" }
          ]
        },
        "sourceRefs": { "$ref": "#/definitions/stringArray" },
        "rationale": { "$ref": "#/definitions/safeString" },
        "stopConditionRefs": { "$ref": "#/definitions/stringArray" }
      }
    },
    "actionSafety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "safetyClass",
        "copySafety",
        "mutatesState",
        "mutatesTrackerState",
        "mutatesExternalState",
        "requiresHumanApproval",
        "preflightRequired",
        "executionBoundary"
      ],
      "properties": {
        "safetyClass": { "$ref": "#/definitions/safetyClass" },
        "copySafety": { "$ref": "#/definitions/copySafety" },
        "mutatesState": { "type": "boolean" },
        "mutatesTrackerState": { "type": "boolean" },
        "mutatesExternalState": { "type": "boolean" },
        "requiresHumanApproval": { "type": "boolean" },
        "preflightRequired": { "type": "boolean" },
        "executionBoundary": { "type": "string", "minLength": 1 }
      }
    },
    "commandAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commandId",
        "displayCommand",
        "argv",
        "shellRequired",
        "copySafety",
        "mutatesState",
        "requiredSubstrate",
        "when",
        "rationale"
      ],
      "properties": {
        "commandId": { "type": "string", "minLength": 1 },
        "displayCommand": { "$ref": "#/definitions/safeString" },
        "argv": { "$ref": "#/definitions/stringArray" },
        "shellRequired": { "type": "boolean" },
        "copySafety": { "$ref": "#/definitions/copySafety" },
        "mutatesState": { "type": "boolean" },
        "requiredSubstrate": { "type": "string", "minLength": 1 },
        "when": { "type": "string", "minLength": 1 },
        "rationale": { "$ref": "#/definitions/safeString" }
      }
    },
    "stopCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "terminal", "description"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "terminal": { "type": "boolean" },
        "description": { "$ref": "#/definitions/safeString" }
      }
    },
    "nonMutationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sideEffectFree",
        "claimsBeads",
        "reservesFiles",
        "sendsAgentMail",
        "mutatesTracker",
        "runsCargo",
        "stagesGit",
        "deletesFiles",
        "executesRepairs"
      ],
      "properties": {
        "sideEffectFree": { "type": "boolean", "const": true },
        "claimsBeads": { "type": "boolean", "const": false },
        "reservesFiles": { "type": "boolean", "const": false },
        "sendsAgentMail": { "type": "boolean", "const": false },
        "mutatesTracker": { "type": "boolean", "const": false },
        "runsCargo": { "type": "boolean", "const": false },
        "stagesGit": { "type": "boolean", "const": false },
        "deletesFiles": { "type": "boolean", "const": false },
        "executesRepairs": { "type": "boolean", "const": false }
      }
    },
    "degradation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "source", "severity", "message", "repair"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "severity": { "type": "string", "enum": ["info", "low", "warning", "medium", "high", "critical"] },
        "message": { "$ref": "#/definitions/safeString" },
        "repair": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/definitions/safeString" }
          ]
        }
      }
    }
  },
