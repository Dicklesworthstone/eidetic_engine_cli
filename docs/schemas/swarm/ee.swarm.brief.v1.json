        "type": "object",
        "additionalProperties": false,
        "required": ["queryHash", "missCount", "reasons"],
        "properties": {
          "queryHash": {"type": "string"},
          "missCount": {"type": "integer", "minimum": 0},
          "reasons": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  },
